% ------------------------------------------------------------
\subsection{Ku mbetëm}
% ------------------------------------------------------------

\begin{frame}{Java 7 na la me një pyetje}
  \begin{itemize}
    \item<1-> \texttt{Auto}: \texttt{mpg \textasciitilde{} horsepower}, formë U te mbetjet.
    \item<2-> \texttt{Boston}: \texttt{medv \textasciitilde{} lstat}, lakim i fortë te \texttt{crPlots}.
    \item<3-> Me një term kuadratik $R^2$ rritet:
      \begin{center}\small
      \begin{tabular}{lcc}
        \toprule & linear & kuadratik\\ \midrule
        \texttt{Auto} & 0.606 & 0.688\\
        \texttt{Boston} & 0.544 & 0.641\\ \bottomrule
      \end{tabular}
      \end{center}
    \item<4-> Pyetja e sotme: \textbf{si e zgjedhim formën në mënyrë sistematike?}
  \end{itemize}
\end{frame}

\begin{frame}{Pse ka rëndësi forma?}
  \begin{itemize}
    \item<1-> Java 7: forma e gabuar është i vetmi supozim që \textbf{zhvendos} $\hat\beta$.
    \item<2-> SE robuste nuk e rregullojnë; heqja e pikave as.
    \item<3-> Zgjidhja: modele më fleksibile, por ende të interpretueshme.
    \item<4-> Rreziku: shumë fleksibilitet $\Rightarrow$ mbi-përshtatje (\emph{overfitting}). Gjyqtari: CV (Java 6).
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Të dhënat \texttt{Wage}}
% ------------------------------------------------------------

\begin{frame}{Të dhënat e javës: \texttt{Wage}}
  \begin{itemize}
    \item<1-> 3000 punonjës meshkuj nga rajoni Mid-Atlantic i SHBA, 2003--2009.
    \item<2-> \textbf{Reale}: të dhëna të anketës CPS (sipas dokumentacionit të ISLR); skedari nga repo DS612 (\texttt{Data/Textbook\_Data/Wage.csv}).
    \item<3-> $y$ = \texttt{wage}, paga vjetore në mijë \$; $x$ kryesor = \texttt{age}.
    \item<4-> Kolona e racës është \textbf{hequr} nga skedari i kursit dhe nuk përdoret.
    \item<5-> Lidhja me praktikën: profili paga--mosha është tregues standard në anketat e forcave të punës (si AFP e INSTAT).
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Leximi i të dhënave}
<<h1-read>>=
wage_df <- read.csv(file.path(W08DATA, "Wage.csv"), stringsAsFactors = TRUE)
dim(wage_df)
names(wage_df)
summary(wage_df[, c("age", "wage")])
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> 3000 vëzhgime, 10 kolona; asnjë kolonë race.
    \item<2-> Mosha 18--80, mediana 42.
    \item<3-> Paga mediane 105 mijë \$, mesatarja 112: shpërndarje e anuar djathtas.
    \item<4-> Maksimumi 318: një grup i vogël me paga shumë të larta (do ta shohim në grafik).
  \end{itemize}
\end{frame}

\begin{frame}[fragile,shrink=5]{Paga sipas moshës}
<<h1-scatter, fig.height=3, fig.width=6.5, out.width="0.58\\textwidth">>=
plot(wage_df$age, wage_df$wage, pch = 16, col = rgb(0.17, 0.35, 0.63, 0.25),
     cex = 0.6, xlab = "age", ylab = "wage (1000 USD)")
abline(lm(wage ~ age, data = wage_df), col = "#D97706", lwd = 2)
lines(lowess(wage_df$age, wage_df$wage), col = "#15803D", lwd = 2)
legend("topright", c("linear", "lowess"), col = c("#D97706", "#15803D"),
       lwd = 2, bty = "n")
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Vija lineare (portokalli) rritet njëtrajtësisht deri në 80 vjeç: jo realiste.
    \item<2-> Lowess (jeshile): rritje e shpejtë deri rreth 40, rrafsh, pastaj rënie pas 60.
    \item<3-> Dy grupe: shumica nën 200, një grup i vogël mbi 250.
    \item<4-> Varianca e madhe: mosha shpjegon pak, por \textbf{forma} është e qartë.
  \end{itemize}
\end{frame}

\begin{frame}[label=pyetjeAge]{Parashiko para se ta ekzekutosh}
  \begin{Parashiko}
    Ndajmë moshën në 6 grupe: 18--25, 26--35, 36--45, 46--55, 56--65, 66--80.
    \begin{enumerate}
      \item Në cilin grup pret pagën mesatare më të lartë?
      \item A pret që paga mesatare e grupit 66--80 të jetë më e ulët se e grupit 26--35?
    \end{enumerate}
  \end{Parashiko}
  \shkoTe{zgjAge}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[fragile]{Mesataret sipas grupmoshës}
<<h1-groups>>=
age_grp <- cut(wage_df$age, breaks = c(17, 25, 35, 45, 55, 65, 80))
round(tapply(wage_df$wage, age_grp, mean), 1)
table(age_grp)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> 18--25: 76; kërcim i madh te 26--35: 104.
    \item<2-> 36--65: rreth 118--119, pothuajse e sheshtë.
    \item<3-> 66--80: 103, pak më poshtë se 26--35.
    \item<4-> Kjo është tashmë një \termi{funksion shkallë}{step function}: një konstante për çdo interval. Ora 2 e formalizon.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Linear kundrejt polinomit të shkallës 4}
<<h1-poly>>=
fit_lin  <- lm(wage ~ age, data = wage_df)
fit_poly <- lm(wage ~ poly(age, 4), data = wage_df)
round(c(R2_linear = summary(fit_lin)$r.squared,
        R2_poly4  = summary(fit_poly)$r.squared), 4)
anova(fit_lin, fit_poly)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> $R^2$: $0.038\to0.086$, më shumë se dyfishi.
    \item<2-> Testi $F$ i pjesshëm (Java 6): $F=52.4$ me 3 dhe 2995 shkallë lirie, $p<2.2\times10^{-16}$.
    \item<3-> Termat jolinearë janë qartazi të nevojshëm.
    \item<4-> $R^2$ mbetet i vogël: mosha është vetëm një nga faktorët e pagës (arsimi, sektori\dots).
  \end{itemize}
  \begin{Gabim}``$R^2=0.09$, pra mosha nuk ka rëndësi.'' $R^2$ i ulët nuk do të thotë që forma është e parëndësishme; testi $F$ e tregon qartë.\end{Gabim}
\end{frame}

% ------------------------------------------------------------
\subsection{Objektivat dhe plani}
% ------------------------------------------------------------

\begin{frame}{Objektivat e javës}
  Në fund të ditës do të dini:
  \begin{itemize}
    \item \LO{K2} të formuloni regresin polinomial, funksionet shkallë, splines dhe regresin lokal si modele me funksione bazë;
    \item \LO{S2} të ndërtoni këto modele në R (\texttt{poly}, \texttt{cut}, \texttt{bs}, \texttt{ns}, \texttt{smooth.spline}, \texttt{loess});
    \item \LO{S3} të zgjidhni shkallën, nyjet ose df me ANOVA dhe CV;
    \item \LO{K2} të kuptoni regresin e fortë (M-vlerësuesit, Huber, IRLS);
    \item \LO{C1} të vendosni midis formave dhe të raportoni modelin.
  \end{itemize}
\end{frame}

