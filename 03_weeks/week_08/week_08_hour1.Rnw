% ------------------------------------------------------------
\subsection{Ideja kryesore: funksionet bazë}
% ------------------------------------------------------------

\begin{frame}{Funksionet bazë}
  \begin{Definicion}[Model me funksione bazë (\emph{basis functions})]
    \[ y_i=\beta_0+\beta_1b_1(x_i)+\beta_2b_2(x_i)+\dots+\beta_Kb_K(x_i)+\varepsilon_i \]
    ku $b_1,\dots,b_K$ janë funksione të njohura, të zgjedhura para vlerësimit.
  \end{Definicion}
  \pause
  \begin{itemize}
    \item<2-> Polinom: $b_k(x)=x^k$.
    \item<3-> Funksion shkallë: $b_k(x)=I(c_k\le x<c_{k+1})$.
    \item<4-> Spline: polinome të copëtuara me nyje (Ora 2).
  \end{itemize}
\end{frame}

\begin{frame}{Pse është ende ``regres linear''?}
  \begin{itemize}
    \item<1-> Modeli është jolinear në $x$, por \textbf{linear në $\beta$}.
    \item<2-> Matrica e modelit: $X=[\,1,\ b_1(x),\ \dots,\ b_K(x)\,]$.
    \item<3-> Prandaj vlen gjithçka nga Javët 5--7: OLS, $(X^\top X)^{-1}$, SE, testet $t$ dhe $F$, $h_{ii}$, diagnostikimi.
    \item<4-> Në R: thjesht \texttt{lm(y \textasciitilde{} b1 + b2 + ...)}; funksionet \texttt{poly()}, \texttt{bs()}, \texttt{ns()} ndërtojnë kolonat.
  \end{itemize}
\end{frame}

\begin{frame}{Fotografia: tri familje bazash}
  \centering
  \begin{tikzpicture}
    \begin{groupplot}[group style={group size=3 by 1,horizontal sep=0.9cm},
        width=0.37\textwidth,height=0.32\textwidth,xmin=0,xmax=1,ymin=-0.1,ymax=1.1,
        tick label style={font=\tiny},title style={font=\scriptsize},xtick={0,0.5,1},ytick={0,1}]
      \nextgroupplot[title={polinom}]
        \addplot[domain=0:1,thick,uptblue] {x};
        \addplot[domain=0:1,thick,accent] {x^2};
        \addplot[domain=0:1,thick,okgreen] {x^3};
      \nextgroupplot[title={shkallë}]
        \addplot[thick,uptblue,const plot] coordinates {(0,0) (0.33,1) (0.66,0) (1,0)};
        \addplot[thick,accent,const plot] coordinates {(0,0) (0.33,0) (0.66,1) (1,1)};
      \nextgroupplot[title={spline (truncated power)}]
        \addplot[domain=0:1,samples=60,thick,uptblue] {x};
        \addplot[domain=0:1,samples=60,thick,accent] {(x>0.5)*(x-0.5)^3*8};
    \end{groupplot}
  \end{tikzpicture}
  \vspace{4pt}
  \small Çdo kurbë është një kolonë e $X$; \texttt{lm()} gjen kombinimin linear më të mirë.
\end{frame}

\begin{frame}{Pa ndihmën e PC: dy matrica modeli}
  $x=(0,\,1,\,2)$.
  \vspace{4pt}
  \begin{columns}[T]
    \begin{column}{0.48\textwidth}
      \textbf{Polinom i shkallës 2}:
      \[ X=\begin{pmatrix}1&0&0\\1&1&1\\1&2&4\end{pmatrix} \]
      Kolonat: $1,\ x,\ x^2$.
    \end{column}
    \begin{column}{0.48\textwidth}
      \textbf{Shkallë me prerje te 1.5}:
      \[ X=\begin{pmatrix}1&0\\1&0\\1&1\end{pmatrix} \]
      Kolonat: $1,\ I(x\ge1.5)$.
    \end{column}
  \end{columns}
  \pause
  \begin{itemize}
    \item Me 3 pika dhe 3 kolona, polinomi kalon \textbf{saktësisht} nga të tria pikat: SSE $=0$, por pa asnjë shkallë lirie për $\hat\sigma$.
  \end{itemize}
\end{frame}

\begin{frame}[label=ushBasis]{Radha jote! (pa ndihmën e PC)}
  \begin{Ushtrim}[(5 minuta)]
    $x=(1,\,2,\,3,\,4)$.
    \begin{enumerate}
      \item Shkruaj $X$ për polinomin kubik (kolonat $1,x,x^2,x^3$).
      \item Shkruaj $X$ për funksionin shkallë me prerje te 2.5.
      \item Sa shkallë lirie mbeten për gabimin në secilin rast?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjBasis}{Shiko zgjidhjen}
\end{frame}

\begin{frame}{Fleksibiliteti: shumë pak apo shumë?}
  \centering
  \begin{tikzpicture}
    \begin{axis}[width=0.75\textwidth,height=0.42\textwidth,xmin=0,xmax=6.3,ymin=-1.8,ymax=1.8,
        tick label style={font=\tiny},legend style={font=\tiny},legend pos=south west,xtick=\empty,ytick=\empty]
      \addplot[only marks,mark=*,mark size=1.3pt,gray] coordinates {(0.3,0.5)(0.8,0.9)(1.2,1.2)(1.6,0.8)(2.0,1.1)(2.5,0.4)(3.0,0.1)(3.4,-0.5)(3.9,-0.6)(4.3,-1.1)(4.8,-0.8)(5.3,-0.7)(5.8,-0.2)};
      \addplot[domain=0:6.3,thick,accent] {0.9-0.3*x}; \addlegendentry{shumë e ngurtë}
      \addplot[domain=0:6.3,thick,okgreen,samples=80] {sin(deg(x))}; \addlegendentry{e mirë}
      \addplot[thick,uptblue,smooth] coordinates {(0.3,0.5)(0.8,0.9)(1.2,1.2)(1.6,0.8)(2.0,1.1)(2.5,0.4)(3.0,0.1)(3.4,-0.5)(3.9,-0.6)(4.3,-1.1)(4.8,-0.8)(5.3,-0.7)(5.8,-0.2)}; \addlegendentry{shumë fleksibël}
    \end{axis}
  \end{tikzpicture}
  \begin{itemize}\small
    \item Kompromisi zhvendosje--variancë (\emph{bias--variance}): CV zgjedh fleksibilitetin.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Motivimi për regresin e fortë}
% ------------------------------------------------------------

\begin{frame}{Një pikë e vetme mund ta prishë OLS}
  \begin{Shembull}[Pa ndihmën e PC \hfill (sintetike)]
    $x=(1,2,3,4,5)$, $y=(1,2,3,4,15)$: pika 5 duhej të ishte 5, por u regjistrua 15.
    \begin{itemize}
      \item $\bar x=3$, $\bar y=5$, $S_{xx}=10$.
      \item $S_{xy}=(-2)(-4)+(-1)(-3)+0+(1)(-1)+(2)(10)=30$.
      \item $b_1=3$, ndërsa pa gabimin $b_1=1$: \textbf{pjerrësia trefishohet}.
    \end{itemize}
  \end{Shembull}
  \pause
  \begin{itemize}
    \item Java 7: mos e fshi automatikisht. Por çfarë bëjmë kur nuk e dimë cila pikë është e gabuar?
  \end{itemize}
\end{frame}

\begin{frame}{Ideja e regresit të fortë}
  \begin{itemize}
    \item<1-> OLS minimizon $\sum e_i^2$: një mbetje 10 herë më e madhe peshon 100 herë më shumë.
    \item<2-> \termi{Regresi i fortë}{robust regression}: zëvendëson $e^2$ me një funksion $\rho(e)$ që rritet më ngadalë.
    \item<3-> Rezultati: pikat me mbetje të mëdha marrin \textbf{peshë të ulët} automatikisht, por nuk fshihen.
    \item<4-> Në R: \texttt{MASS::rlm()}. Ora 4 jep teorinë, Ora 5 praktikën.
  \end{itemize}
\end{frame}

\begin{frame}[label=ushTPS81]{Mendo -- diskuto në çift -- ndaj}
  \begin{Ushtrim}[(5 minuta)]
    Tre situata (hipotetike):
    \begin{enumerate}
      \item Kurba e kalibrimit të një sensori temperature në një laborator inxhinierie.
      \item Konsumi i energjisë sipas temperaturës ditore në Tiranë.
      \item Çmimi i banesave sipas largësisë nga qendra, me disa gabime regjistrimi.
    \end{enumerate}
    Për secilën: çfarë forme pret? A ka nevojë për regres të fortë?
  \end{Ushtrim}
  \shkoTe{zgjTPS81}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Kujtesë e njohurive paraprake}
% ------------------------------------------------------------

\begin{frame}{Çfarë na duhet nga javët e kaluara}
  \small
  \begin{tabular}{@{}lll@{}}
    \toprule
    Koncepti & Java & Përdorimi sot \\ \midrule
    OLS në formë matricore & 5--6 & çdo bazë është një kolonë e $X$ \\
    Testi $F$ i pjesshëm, \texttt{anova()} & 6 & a duhet shkalla tjetër? \\
    $K$-fold CV, LOOCV & 6 & zgjedhja e shkallës, nyjeve, df \\
    $h_{ii}$ dhe shkurtorja e LOOCV & 7 & smoothing spline (Ora 4) \\
    \texttt{crPlots}, formë U & 7 & ku duhet fleksibilitet \\
    Vlerat ekstreme, Cook & 7 & regresi i fortë \\ \bottomrule
  \end{tabular}
\end{frame}

\begin{frame}[label=pyetjeMC81]{Pyetje me zgjedhje}
  \begin{Parashiko}
    Cili nga këto modele \textbf{nuk} mund të vlerësohet me \texttt{lm()}?
    \begin{enumerate}[A)]
      \item $y=\beta_0+\beta_1x+\beta_2x^2+\varepsilon$
      \item $y=\beta_0+\beta_1\log x+\beta_2 I(x>5)+\varepsilon$
      \item $y=\beta_0+\beta_1e^{\beta_2x}+\varepsilon$
      \item $y=\beta_0+\beta_1(x-3)_+^3+\varepsilon$
    \end{enumerate}
  \end{Parashiko}
  \shkoTe{zgjMC81}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Mbyllja e orës}
% ------------------------------------------------------------

\begin{frame}[label=cp81]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 1}
  \begin{enumerate}
    \item Çfarë do të thotë ``linear në $\beta$''? Jepni një shembull jolinear në $x$.
    \item Pse $R^2$ i ulët te \texttt{Wage} nuk do të thotë që mosha nuk ka rëndësi?
    \item Në shembullin me 5 pika, pse një gabim i vetëm e trefishon pjerrësinë?
  \end{enumerate}
  \shkoTe{zgjCp81}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje: Ora 1}
  \begin{itemize}
    \item Forma e gabuar zhvendos $\hat\beta$; Java 7 e diagnostikoi, Java 8 e rregullon.
    \item \texttt{Wage}: paga rritet deri rreth 40, rrafshohet, bie pas 65; \texttt{poly(age, 4)}: $F=52.4$.
    \item Funksionet bazë: jolineare në $x$, lineare në $\beta$ $\Rightarrow$ \texttt{lm()} dhe gjithë teoria e Javëve 5--7.
    \item Fleksibiliteti zgjidhet me CV.
    \item Një pikë e gabuar mund ta trefishojë pjerrësinë $\Rightarrow$ regresi i fortë.
  \end{itemize}
  \begin{Keshille}Ora 2: polinomet (bazat ortogonale, IB), funksionet shkallë dhe splines regresive.\end{Keshille}
\end{frame}
