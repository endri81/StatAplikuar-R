\begin{frame}[label=zgjAge]{Zgjidhja: Parashiko (grupmoshat)}
  \begin{itemize}
    \item Më e larta: 36--45 (119.1), por 46--55 (117.6) dhe 56--65 (119.0) janë pothuajse njësoj.
    \item Po: 66--80 ka 102.6, pak më poshtë se 26--35 (104.2).
    \item Grupi 66--80 ka vetëm 64 vëzhgime: mesatare me pasiguri më të madhe.
  \end{itemize}
  \vfill\kthehu{pyetjeAge}
\end{frame}

\begin{frame}[label=zgjBasis]{Zgjidhja: Radha jote! (matricat e modelit)}
  \begin{columns}[T]
    \begin{column}{0.5\textwidth}
      Kubik:
      \[ X=\begin{pmatrix}1&1&1&1\\1&2&4&8\\1&3&9&27\\1&4&16&64\end{pmatrix} \]
    \end{column}
    \begin{column}{0.45\textwidth}
      Shkallë (prerje 2.5):
      \[ X=\begin{pmatrix}1&0\\1&0\\1&1\\1&1\end{pmatrix} \]
    \end{column}
  \end{columns}
  \begin{itemize}
    \item Kubik: $n-k=4-4=0$: interpolim i saktë, pa vlerësim të $\sigma$.
    \item Shkallë: $4-2=2$ shkallë lirie.
  \end{itemize}
  \vfill\kthehu{ushBasis}
\end{frame}

\begin{frame}[label=zgjTPS81]{Zgjidhja: Think--pair--share}
  \begin{enumerate}
    \item Kalibrimi: kurbë e lëmuar, shpesh polinom i shkallës së ulët ose spline; matjet janë të kontrolluara, pak nevojë për regres të fortë.
    \item Energjia--temperatura: formë U (ngrohje në dimër, ftohje në verë); spline ose polinom; ditët e festave mund të jenë pika të veçanta.
    \item Banesat: rënie e shpejtë pranë qendrës, pastaj e ngadaltë (log ose spline); gabimet e regjistrimit $\Rightarrow$ regres i fortë.
  \end{enumerate}
  \vfill\kthehu{ushTPS81}
\end{frame}

\begin{frame}[label=zgjMC81]{Zgjidhja: Pyetje me zgjedhje}
  \begin{itemize}
    \item Përgjigjja: \textbf{C}. $\beta_2$ është brenda eksponentit: modeli nuk është linear në $\beta$. Kërkon \texttt{nls()} (katrorët më të vegjël jolinearë).
    \item A, B, D: çdo term është një funksion i njohur i $x$ i shumëzuar me një $\beta$; \texttt{lm()} funksionon.
    \item D kërkon që nyja (3) të jetë e fiksuar para vlerësimit.
  \end{itemize}
  \vfill\kthehu{pyetjeMC81}
\end{frame}

\begin{frame}[label=zgjCp81]{Përgjigjet: Checkpoint Ora 1}
  \begin{enumerate}
    \item $\beta$ shfaqen vetëm si koeficientë që shumëzojnë funksione të njohura; p.sh.\ $y=\beta_0+\beta_1x+\beta_2x^2$.
    \item $R^2$ mat pjesën e shpjeguar të variancës; testi $F$ për termat jolinearë jep $p<2.2\times10^{-16}$: forma është reale, por paga varet edhe nga shumë faktorë të tjerë.
    \item OLS minimizon katrorët: mbetja e pikës 5 ($x$ larg $\bar x$) peshon shumë; $S_{xy}$ merr 20 nga 30 vetëm nga ajo pikë.
  \end{enumerate}
  \vfill\kthehu{cp81}
\end{frame}
