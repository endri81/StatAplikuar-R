% ------------------------------------------------------------
\subsection{Regresi polinomial}
% ------------------------------------------------------------

\begin{frame}{Regresi polinomial \LO{K2} \LO{S1}}
  \begin{Definicion}[Regresi polinomial i shkallës $d$]
    \[ y_i=\beta_0+\beta_1x_i+\beta_2x_i^2+\dots+\beta_dx_i^d+\varepsilon_i \]
  \end{Definicion}
  \pause
  \begin{itemize}
    \item<2-> $d+1$ parametra; vlerësohet me OLS si çdo regres i shumëfishtë.
    \item<3-> Në praktikë $d\le4$: më lart kurba bëhet shumë fleksibël, sidomos në skaje.
    \item<4-> Interpretohet kurba $\hat f(x)$, jo koeficientët veç e veç.
  \end{itemize}
\end{frame}

\begin{frame}{Problemi i bazës së papërpunuar}
  \begin{itemize}
    \item<1-> Te \texttt{Wage}: $\operatorname{cor}(\texttt{age},\texttt{age}^2)=0.987$.
    \item<2-> VIF për \texttt{age}, \dots, $\texttt{age}^4$: rreth 8\,700, 82\,000, 92\,500, 12\,300.
    \item<3-> Java 7: VIF i madh $\Rightarrow$ SE të koeficientëve shpërthejnë, por $\hat y$ mbetet i njëjtë.
    \item<4-> Numerikisht: $(X^\top X)^{-1}$ afër singulares; me $x$ të mëdhenj (p.sh.\ vite) mund të dështojë.
  \end{itemize}
\end{frame}

\begin{frame}{Polinomet ortogonale}
  \begin{itemize}
    \item<1-> Ide: zëvendëso $x,x^2,\dots,x^d$ me $p_1(x),\dots,p_d(x)$ që kanë \textbf{të njëjtën hapësirë} kolonash, por janë ortogonale:
      \[ \textstyle\sum_i p_j(x_i)=0,\qquad \sum_i p_j(x_i)p_k(x_i)=0\ (j\ne k),\qquad \sum_i p_j(x_i)^2=1. \]
    \item<2-> Ndërtohen me Gram--Schmidt mbi $1,x,x^2,\dots$.
    \item<3-> Në R: \texttt{poly(x, d)} (parazgjedhje); \texttt{poly(x, d, raw = TRUE)} jep bazën e papërpunuar.
  \end{itemize}
\end{frame}

\begin{frame}{Çfarë fitojmë me bazën ortogonale?}
  \begin{itemize}
    \item<1-> $X^\top X$ diagonale $\Rightarrow$ $\hat\beta_j=\sum_i p_j(x_i)y_i$, veç e veç.
    \item<2-> Shtimi i shkallës $d+1$ \textbf{nuk ndryshon} koeficientët e mëparshëm.
    \item<3-> Testi $t$ i termit të fundit = testi $F$ i pjesshëm: $t^2=F$.
    \item<4-> $\hat y$, $R^2$, SSE: \textbf{identikë} me bazën e papërpunuar (e njëjta hapësirë kolonash).
  \end{itemize}
  \pause[5]
  \begin{Gabim}Interpretimi i koeficientëve të \texttt{poly()} si efekte të \texttt{age} ose $\texttt{age}^2$. Ata janë koeficientë të polinomeve ortogonale, pa kuptim të drejtpërdrejtë.\end{Gabim}
\end{frame}

\begin{frame}{Shembull pa ndihmën e PC \hfill\small(sintetike)}
  $x=(-2,-1,0,1,2)$, \; $y=(6,2,1,2,4)$.
  \begin{itemize}
    \item<2-> $x$ simetrik: $\sum x=0$, $\sum x^3=0$.
    \item<3-> Qendërzojmë $x^2$: $z=x^2-2=(2,-1,-2,-1,2)$, me $\sum z=0$.
    \item<4-> Kontroll: $\sum xz=-4+1+0-1+4=0$. Kolonat $1,x,z$ janë \textbf{ortogonale}.
    \item<5-> Modeli $y=\gamma_0+\gamma_1x+\gamma_2z$ ka të njëjtat $\hat y$ si $y=\beta_0+\beta_1x+\beta_2x^2$.
  \end{itemize}
\end{frame}

\begin{frame}{Hapi 1: koeficientët veç e veç}
  \begin{itemize}
    \item<1-> $\hat\gamma_0=\bar y=15/5=3$.
    \item<2-> $\hat\gamma_1=\dfrac{\sum xy}{\sum x^2}=\dfrac{-12-2+0+2+8}{10}=\dfrac{-4}{10}=-0.4$.
    \item<3-> $\hat\gamma_2=\dfrac{\sum zy}{\sum z^2}=\dfrac{12-2-2-2+8}{4+1+4+1+4}=\dfrac{14}{14}=1$.
    \item<4-> Kthimi në bazën e papërpunuar: $3-0.4x+1\cdot(x^2-2)=\boxed{1-0.4x+x^2}$.
  \end{itemize}
\end{frame}

\begin{frame}{Hapi 2: SSE dhe testi $F$}
  \centering\small
  \begin{tabular}{cccccc}
    \toprule $x$ & $-2$ & $-1$ & 0 & 1 & 2\\ \midrule
    $y$ & 6 & 2 & 1 & 2 & 4\\
    $\hat y=1-0.4x+x^2$ & 5.8 & 2.4 & 1.0 & 1.6 & 4.2\\
    $e$ & 0.2 & $-0.4$ & 0 & 0.4 & $-0.2$\\ \bottomrule
  \end{tabular}
  \begin{itemize}
    \item<2-> $\text{SSE}_2=0.04+0.16+0+0.16+0.04=0.4$.
    \item<3-> Linear: $\text{SST}=16$, $\text{SSR}_1=\hat\gamma_1^2\sum x^2=1.6$ $\Rightarrow$ $\text{SSE}_1=14.4$.
    \item<4-> $F=\dfrac{(14.4-0.4)/1}{0.4/2}=70>F_{0.95;1,2}=18.5$: termi kuadratik nevojitet.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Kontroll në R: \texttt{poly()} është kjo bazë, e normuar}
<<h2-toy>>=
x <- c(-2, -1, 0, 1, 2); y <- c(6, 2, 1, 2, 4)
P <- poly(x, 2)
round(P[, 1:2], 4)                        # orthonormal columns
all.equal(unname(P[, 1:2]), cbind(x / sqrt(10), (x^2 - 2) / sqrt(14)))
coef(lm(y ~ poly(x, 2, raw = TRUE)))      # 1, -0.4, 1
@
\end{frame}

\begin{frame}{Pasiguria e $\hat f(x_0)$}
  \begin{itemize}
    \item<1-> $\hat f(x_0)=\ell_0^\top\hat\beta$, me $\ell_0=(1,x_0,x_0^2,\dots,x_0^d)^\top$.
    \item<2-> $\operatorname{Var}\big(\hat f(x_0)\big)=\ell_0^\top\operatorname{Var}(\hat\beta)\,\ell_0=\sigma^2\,\ell_0^\top(X^\top X)^{-1}\ell_0$.
    \item<3-> IB 95\%: $\hat f(x_0)\pm t_{0.975;\,n-d-1}\cdot\text{SE}\big(\hat f(x_0)\big)$.
    \item<4-> Në R: \texttt{predict(fit, newdata, se.fit = TRUE)}.
    \item<5-> Me bazën ortogonale: $\operatorname{Var}=\sigma^2\big(\tfrac1n+\sum_j p_j(x_0)^2\big)$, shumë e thjeshtë.
  \end{itemize}
\end{frame}

\begin{frame}{Pa ndihmën e PC: SE në tri pika}
  $\hat\sigma^2=0.4/2=0.2$; \; $\operatorname{Var}\big(\hat f(x_0)\big)=\hat\sigma^2\Big(\dfrac15+\dfrac{x_0^2}{10}+\dfrac{(x_0^2-2)^2}{14}\Big)$
  \vspace{4pt}
  \centering\small
  \begin{tabular}{ccccc}
    \toprule $x_0$ & $\hat f(x_0)$ & kllapa & Var & SE\\ \midrule
    0 & 1.0 & $0.2+0+0.286=0.486$ & 0.097 & 0.31\\
    2 & 4.2 & $0.2+0.4+0.286=0.886$ & 0.177 & 0.42\\
    3 & 8.8 & $0.2+0.9+3.5=4.6$ & 0.92 & \textcolor{accent}{\textbf{0.96}}\\ \bottomrule
  \end{tabular}
  \begin{itemize}
    \item<2-> $x_0=3$ është jashtë të dhënave: SE trefishohet.
  \end{itemize}
\end{frame}

\begin{frame}{Gabim i zakonshëm: ekstrapolimi}
  \begin{Gabim}Përdorimi i një polinomi për parashikim jashtë intervalit të $x$. Termi $x^d$ dominon dhe kurba ``ikën''; IB bëhet shumë i gjerë.\end{Gabim}
  \pause
  \begin{itemize}
    \item<2-> Shembull: polinom i shkallës 4 te \texttt{Wage} për moshën 90 (Ora 3).
    \item<3-> Edhe brenda intervalit, në skaje ka pak të dhëna: variancë e madhe.
    \item<4-> Kjo motivon splines natyrore (Ora 4): lineare në skaje.
  \end{itemize}
\end{frame}

\begin{frame}[label=pyetjePoly]{Pyetje me zgjedhje}
  \begin{Parashiko}
    Krahasojmë \texttt{lm(y \textasciitilde{} poly(x, 3))} me \texttt{lm(y \textasciitilde{} poly(x, 3, raw = TRUE))}. Cila është e \textbf{gabuar}?
    \begin{enumerate}[A)]
      \item Vlerat e përshtatura $\hat y$ janë identike.
      \item $R^2$ dhe testi $F$ global janë identikë.
      \item Koeficienti i termit linear është i njëjtë në të dy modelet.
      \item Në bazën ortogonale, shtimi i shkallës 4 nuk ndryshon tre koeficientët e parë.
    \end{enumerate}
  \end{Parashiko}
  \shkoTe{zgjPoly}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Funksionet shkallë}
% ------------------------------------------------------------

\begin{frame}{Funksionet shkallë}
  \begin{itemize}
    \item<1-> Pikat e prerjes $c_1<c_2<\dots<c_K$ ndajnë $x$ në $K+1$ intervale.
    \item<2-> Variablat tregues: $C_0(x)=I(x<c_1)$, \; $C_k(x)=I(c_k\le x<c_{k+1})$, \; $C_K(x)=I(x\ge c_K)$.
    \item<3-> Modeli: $y_i=\beta_0+\beta_1C_1(x_i)+\dots+\beta_KC_K(x_i)+\varepsilon_i$ ($C_0$ hiqet për shkak të konstantes).
    \item<4-> $\hat\beta_0$ = mesatarja e intervalit të parë; $\hat\beta_k$ = diferenca e intervalit $k$ nga i pari.
    \item<5-> Në R: \texttt{lm(y \textasciitilde{} cut(x, breaks))}.
  \end{itemize}
\end{frame}

\begin{frame}{Lidhja me ANOVA (Java 4)}
  \begin{itemize}
    \item<1-> \texttt{cut(x)} kthen $x$ në \textbf{faktor}: modeli është ANOVA njëfaktoriale.
    \item<2-> $\hat y_i$ = mesatarja e grupit; testi $F$ global = testi $F$ i ANOVA-s.
    \item<3-> Ora 1: mesataret sipas grupmoshës (76, 104, 119, \dots) janë pikërisht këto $\hat y$.
  \end{itemize}
  \pause[4]
  \begin{Keshille}Funksioni shkallë është i dobishëm kur pikat e prerjes kanë kuptim natyral: grupmoshat e INSTAT, brezat tatimorë, nivelet e arsimit.\end{Keshille}
\end{frame}

\begin{frame}{Pa ndihmën e PC: pikat e prerjes kanë rëndësi}
  Të njëjtat të dhëna: $x=(-2,-1,0,1,2)$, $y=(6,2,1,2,4)$, $\text{SST}=16$.
  \vspace{4pt}
  \begin{itemize}
    \item<2-> \textbf{Një prerje te 0.5}: grupet $\{-2,-1,0\}$, $\{1,2\}$; mesataret $3$ dhe $3$.\\
      $\hat y$ = 3 kudo $\Rightarrow$ SSE $=16$: \textbf{asgjë e shpjeguar}.
    \item<3-> \textbf{Prerje te $-0.5$ dhe $0.5$}: mesataret $4$, $1$, $3$.\\
      SSE $=(6-4)^2+(2-4)^2+0+(2-3)^2+(4-3)^2=10$.
    \item<4-> Kuadratiku me 3 parametra: SSE $=0.4$.
  \end{itemize}
  \pause[5]
  \begin{Gabim}Funksioni shkallë me prerje të gabuara mund ta fshehë plotësisht formën U.\end{Gabim}
\end{frame}

\begin{frame}[label=ushStep]{Radha jote! (pa ndihmën e PC)}
  \begin{Ushtrim}[(5 minuta)]
    Të njëjtat të dhëna. Prerje te $-1.5$ dhe $1.5$.
    \begin{enumerate}
      \item Cilat janë tri grupet dhe mesataret e tyre?
      \item Llogarit SSE.
      \item Krahaso me kuadratikun (0.4) dhe me prerjet $-0.5$, $0.5$ (10). Pse ndryshon kaq shumë?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjStep}{Shiko zgjidhjen}
\end{frame}

\begin{frame}{Funksionet shkallë: pro dhe kundër}
  \begin{columns}[T]
    \begin{column}{0.48\textwidth}
      \textbf{Pro}
      \begin{itemize}
        \item interpretim i thjeshtë (mesatare grupi);
        \item lokal: një interval nuk ndikon te tjetri;
        \item pa supozim për formën brenda intervalit.
      \end{itemize}
    \end{column}
    \begin{column}{0.48\textwidth}
      \textbf{Kundër}
      \begin{itemize}
        \item kërcime artificiale te prerjet;
        \item injoron trendin brenda intervalit;
        \item varet shumë nga pikat e prerjes.
      \end{itemize}
    \end{column}
  \end{columns}
\end{frame}

% ------------------------------------------------------------
\subsection{Splines regresive}
% ------------------------------------------------------------

\begin{frame}{Polinome të copëtuara}
  \begin{itemize}
    \item<1-> Ide: polinom i veçantë në çdo interval, me \termi{nyje}{knots} $\xi_1<\dots<\xi_K$.
    \item<2-> Kubik i copëtuar pa kushte: $4(K+1)$ parametra.
    \item<3-> Problem: kurba \textbf{kërcen} te nyjet, si funksioni shkallë.
    \item<4-> Zgjidhje: kërko vazhdueshmëri te nyjet.
  \end{itemize}
\end{frame}

\begin{frame}{Fotografia: nga copat te spline}
  \centering
  \begin{tikzpicture}
    \begin{groupplot}[group style={group size=3 by 1,horizontal sep=0.7cm},
        width=0.37\textwidth,height=0.32\textwidth,xmin=0,xmax=2,ymin=-0.3,ymax=1.6,
        tick label style={font=\tiny},title style={font=\scriptsize},xtick={1},xticklabels={$\xi$},ytick=\empty]
      \nextgroupplot[title={pa kushte}]
        \addplot[domain=0:1,thick,uptblue] {0.2+0.9*x^2};
        \addplot[domain=1:2,thick,accent] {1.4-0.6*(x-1)};
      \nextgroupplot[title={e vazhdueshme}]
        \addplot[domain=0:1,thick,uptblue] {0.2+0.9*x^2};
        \addplot[domain=1:2,thick,accent] {1.1-0.6*(x-1)};
      \nextgroupplot[title={spline kubike}]
        \addplot[domain=0:1,thick,uptblue,samples=40] {0.2+0.9*x^2};
        \addplot[domain=1:2,thick,accent,samples=40] {1.1+1.8*(x-1)+0.9*(x-1)^2-2.2*(x-1)^3};
    \end{groupplot}
  \end{tikzpicture}
  \begin{itemize}\small
    \item Vazhdueshmëri e $f$, $f'$ dhe $f''$ te nyja: syri nuk e dallon dot nyjen.
  \end{itemize}
\end{frame}

\begin{frame}{Spline kubike: përkufizimi}
  \begin{Definicion}[Spline kubike me nyje $\xi_1,\dots,\xi_K$]
    Funksion që është polinom kubik në çdo interval dhe ka $f$, $f'$, $f''$ të vazhdueshme në çdo nyje.
  \end{Definicion}
  \pause
  \begin{itemize}
    \item<2-> Numri i parametrave: $4(K+1)$ minus $3$ kushte për nyje:
      \[ 4(K+1)-3K=\boxed{K+4}. \]
    \item<3-> Spline lineare (vetëm $f$ e vazhdueshme): $2(K+1)-K=K+2$.
  \end{itemize}
\end{frame}

\begin{frame}{Baza truncated power}
  \begin{Definicion}[Funksioni truncated power]
    \[ h(x,\xi)=(x-\xi)_+^3=\begin{cases}(x-\xi)^3, & x>\xi\\ 0, & x\le\xi\end{cases} \]
  \end{Definicion}
  \pause
  \begin{itemize}
    \item<2-> Baza e spline-it kubik: $1,\ x,\ x^2,\ x^3,\ h(x,\xi_1),\dots,h(x,\xi_K)$: gjithsej $K+4$. \checkmark
    \item<3-> \textbf{Pse funksionon?} Te $x=\xi$: $h=0$, $h'=3(x-\xi)^2=0$, $h''=6(x-\xi)=0$ nga të dyja anët; vetëm $h'''$ kërcen.
    \item<4-> Çdo term $h$ ``ndez'' një ndryshim të derivatit të tretë pas nyjes.
  \end{itemize}
\end{frame}

\begin{frame}{Fotografia: $(x-\xi)_+^3$ dhe derivatet}
  \centering
  \begin{tikzpicture}
    \begin{axis}[width=0.72\textwidth,height=0.42\textwidth,xmin=-1,xmax=1.6,ymin=-0.3,ymax=3.2,
        tick label style={font=\tiny},legend style={font=\tiny},legend pos=north west,xtick={0},xticklabels={$\xi$}]
      \addplot[domain=-1:1.6,samples=80,thick,uptblue] {(x>0)*x^3}; \addlegendentry{$h$}
      \addplot[domain=-1:1.6,samples=80,thick,okgreen,dashed] {(x>0)*3*x^2/2}; \addlegendentry{$h'/2$}
      \addplot[domain=-1:1.6,samples=80,thick,accent,dotted] {(x>0)*6*x/4}; \addlegendentry{$h''/4$}
    \end{axis}
  \end{tikzpicture}
  \begin{itemize}\small
    \item Të tria nisen nga 0 te $\xi$ pa kërcim: vazhdueshmëri deri te $f''$.
  \end{itemize}
\end{frame}

\begin{frame}{Pa ndihmën e PC: matrica e një spline-i linear}
  $x=(-2,-1,0,1,2)$, një nyje te $\xi=0$, spline lineare: baza $1,\ x,\ (x-0)_+$.
  \[ X=\begin{pmatrix}1&-2&0\\1&-1&0\\1&0&0\\1&1&1\\1&2&2\end{pmatrix} \]
  \pause
  \begin{itemize}
    \item<2-> Majtas nyjes: pjerrësia $\beta_1$. Djathtas: $\beta_1+\beta_2$.
    \item<3-> $\beta_2$ = \textbf{ndryshimi i pjerrësisë} te nyja; testi $t$ për $\beta_2$: a ka thyerje?
  \end{itemize}
\end{frame}

\begin{frame}{Splines në R: \texttt{bs()}}
  \begin{itemize}
    \item<1-> \texttt{bs(x, knots = c(25, 40, 60))}: spline kubike me 3 nyje; jep $K+3=6$ kolona (konstantja vjen nga \texttt{lm}).
    \item<2-> Gjithsej $K+4=7$ koeficientë. \checkmark
    \item<3-> \texttt{bs(x, df = 6)}: $6-3=3$ nyje në kuantilet e $x$ (për \texttt{age}: 33.75, 42, 51).
    \item<4-> \texttt{bs()} përdor bazën B-spline: e njëjta hapësirë si truncated power, por numerikisht e qëndrueshme.
    \item<5-> \texttt{degree = 1}: spline lineare.
  \end{itemize}
\end{frame}

\begin{frame}{Ku dhe sa nyje?}
  \begin{itemize}
    \item<1-> \textbf{Ku}: zakonisht në kuantile (njëtrajtësisht sipas të dhënave); ose aty ku pritet ndryshim (p.sh.\ mosha e pensionit).
    \item<2-> \textbf{Sa}: zgjidhet me CV (Ora 3); çdo nyje shton 1 df.
    \item<3-> Pak nyje: zhvendosje; shumë nyje: variancë.
  \end{itemize}
  \pause[4]
  \begin{Gabim}Zgjedhja e nyjeve duke parë të dhënat e testit. Nyjet dhe df janë hiper-parametra: zgjidhen brenda CV, si shkalla e polinomit.\end{Gabim}
\end{frame}

\begin{frame}[label=pyetjeDf]{Parashiko}
  \begin{Parashiko}
    Sa koeficientë (përfshirë konstanten) ka secili model?
    \begin{enumerate}
      \item \texttt{lm(wage \textasciitilde{} poly(age, 4))}
      \item \texttt{lm(wage \textasciitilde{} cut(age, 4))}
      \item \texttt{lm(wage \textasciitilde{} bs(age, knots = c(25, 40, 60)))}
      \item \texttt{lm(wage \textasciitilde{} bs(age, df = 6))}
      \item \texttt{lm(wage \textasciitilde{} bs(age, knots = c(25, 40, 60), degree = 1))}
    \end{enumerate}
  \end{Parashiko}
  \shkoTe{zgjDf}{Shiko zgjidhjen}
\end{frame}

\begin{frame}{Krahasimi i tri familjeve}
  \centering\small
  \begin{tabular}{@{}llll@{}}
    \toprule
     & Polinom & Shkallë & Spline kubike\\ \midrule
    Parametra & $d+1$ & $K+1$ & $K+4$\\
    Lokal? & jo (global) & po & po\\
    E lëmuar? & po & jo (kërcime) & po ($f''$ vazhd.)\\
    Skajet & të paqëndrueshme & të qëndrueshme & të paqëndrueshme\\
    Hiper-parametri & $d$ & prerjet & nyjet / df\\
    R & \texttt{poly()} & \texttt{cut()} & \texttt{bs()}\\ \bottomrule
  \end{tabular}
  \pause
  \begin{itemize}\small
    \item Spline-i kombinon të mirat: lokal si funksioni shkallë, i lëmuar si polinomi.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Mbyllja e orës}
% ------------------------------------------------------------

\begin{frame}[label=cp82]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 2}
  \begin{enumerate}
    \item Pse \texttt{poly(x, d)} dhe \texttt{poly(x, d, raw = TRUE)} japin të njëjtat $\hat y$, por koeficientë të ndryshëm?
    \item Sa parametra ka një spline kubike me 5 nyje? Nga vjen formula?
    \item Pse $(x-\xi)_+^3$ nuk krijon kërcim te $f''$?
  \end{enumerate}
  \shkoTe{zgjCp82}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje: Ora 2}
  \begin{itemize}
    \item Polinom: bazë ortogonale (\texttt{poly}) $\Rightarrow$ koeficientë të pavarur, $t^2=F$; kujdes me skajet dhe ekstrapolimin.
    \item $\operatorname{Var}\hat f(x_0)=\sigma^2\ell_0^\top(X^\top X)^{-1}\ell_0$; SE rritet shpejt jashtë të dhënave.
    \item Funksion shkallë = ANOVA me \texttt{cut()}; prerjet kanë rëndësi të madhe.
    \item Spline kubike: $f,f',f''$ të vazhdueshme; $K+4$ parametra; baza $(x-\xi)_+^3$; \texttt{bs()}.
  \end{itemize}
  \begin{Keshille}Ora 3: të gjitha në R me \texttt{Wage}: \texttt{poly}, ANOVA, CV, \texttt{cut}, \texttt{bs} nga zero, dhe një simulim me funksion të njohur.\end{Keshille}
\end{frame}
