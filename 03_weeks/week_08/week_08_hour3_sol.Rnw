\begin{frame}[label=zgjCut]{Zgjidhja: Radha jote! (\texttt{cut} me 6 grupe)}
  \small
  \begin{itemize}
    \item Konstantja 76.28 = mesatarja 18--25. Koeficientët: $+27.9$, $+42.8$, $+41.3$, $+42.7$, $+26.3$.
    \item $76.3+27.9=104.2$, $76.3+42.8=119.1$, \dots: pikërisht mesataret e Orës 1. \checkmark
    \item $R^2=0.082$ kundrejt 0.062 për \texttt{cut(age, 4)}.
    \item Pse: grupi i parë (18--25) ndahet nga 26--35, aty ku paga rritet më shpejt; prerjet përputhen me formën.
    \item Kosto: 6 parametra kundrejt 4; dhe $R^2$ ende nën \texttt{poly(age, 4)} (0.086 me 5 parametra).
  \end{itemize}
  \vfill\kthehu{ushCut}
\end{frame}

\begin{frame}[label=zgjGab83]{Zgjidhja: Gjej gabimin}
  \begin{itemize}
    \item Formula përdor \texttt{wage\_df\$age}, jo emrin \texttt{age}.
    \item \texttt{predict()} kërkon në \texttt{newdata} një variabël me emrin \texttt{wage\_df\$age}; nuk e gjen dhe përdor të dhënat origjinale: kthen 3000 vlera të përshtatura me paralajmërim.
    \item Zgjidhja: \texttt{lm(wage \textasciitilde{} poly(age, 4), data = wage\_df)}.
  \end{itemize}
  \vfill\kthehu{gjejGab83}
\end{frame}

