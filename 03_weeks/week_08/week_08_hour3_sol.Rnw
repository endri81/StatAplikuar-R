\begin{frame}[label=zgjCp83]{Përgjigjet: Checkpoint Ora 3}
  \begin{enumerate}
    \item Çdo rresht teston nëse shkalla $d$ përmirëson ndjeshëm shkallën $d-1$ (test $F$ i pjesshëm); zgjidh shkallën e fundit me $p$ të vogël.
    \item E njëjta hapësirë, por numerikisht e qëndrueshme (\texttt{kappa} 49 kundrejt $10^8$) dhe lokale.
    \item $R^2$ matet në të dhënat e trajnimit; \texttt{poly9} ndjek zhurmën, prandaj larget më shumë nga $f$ e vërtetë (variancë e madhe).
  \end{enumerate}
  \vfill\kthehu{cp83}
\end{frame}
