\begin{frame}[label=cp67]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 7}
  \begin{enumerate}
    \item Çfarë raporton për çdo koeficient të një modeli të shumëfishtë?
    \item Kur përdor testin $F$ të pjesshëm në vend të testeve $t$?
    \item Cili është gjykatësi përfundimtar kur krahason modele për parashikim?
  \end{enumerate}
  \shkoTe{zgjCp67}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje e Javës 6}
  \begin{itemize}
    \item Koeficientët e pjesshëm: ``duke mbajtur të tjerat konstante''; FWL; variabla e harruar.
    \item Testet: $F$ global, $t$, $F$ i pjesshëm; $R^2_{adj}$.
    \item Dummy, faktorë me $k$ nivele, ndërveprime, parimi hierarkik, qendërzimi.
    \item Përzgjedhja: train/test, LOOCV, $K$-fold, AIC/BIC, \texttt{step()}.
    \item Rastet: \texttt{Advertising}, \texttt{Credit} (repo), \texttt{Auto}.
  \end{itemize}
\end{frame}
