% ------------------------------------------------------------
\subsection{Kuizi në stilin e provimit}
% ------------------------------------------------------------

\begin{frame}{Kuizi: si funksionon}
  \begin{itemize}
    \item<1-> Si në provim: \textbf{25\% teori, 75\% ushtrime}; 3 pyetje teorike (25 pikë) + 7 ushtrime (75 pikë).
    \item<2-> Koha: 45 minuta. Ushtrimet 1--5 dhe 7 bëhen pa ndihmën e PC.
    \item<3-> Ushtrimet 1--2: $x_1=(-2,-1,0,1,2)$, $x_2=(1,-1,0,-1,1)$, $y=(3,1,4,6,11)$.
  \end{itemize}
  \onslide<4->{\begin{Keshille}Te çdo koeficient i pjesshëm shkruaj ``duke mbajtur \dots{} konstante''.\end{Keshille}}
\end{frame}

\begin{frame}[label=q6T1]{Teori 1 (8 pikë)}
  \begin{Ushtrim}[(Teori 1)]
    \begin{enumerate}
      \item Si interpretohet $\beta_j$ në regresin e shumëfishtë?
      \item Pse koeficienti i një shpjeguesi mund të ndryshojë (madje edhe shenjë) kur shtohen shpjegues të tjerë? Jepni një shembull nga java.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s6T1}{Zgjidhja}
\end{frame}

\begin{frame}[label=q6T2]{Teori 2 (8 pikë)}
  \begin{Ushtrim}[(Teori 2)]
    \begin{enumerate}
      \item Pse $R^2$ nuk mund të ulet kur shtohet një shpjegues? Çfarë korrigjon $R^2_{adj}$?
      \item Dalloni testin $F$ global, testin $t$ të një koeficienti dhe testin $F$ të pjesshëm.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s6T2}{Zgjidhja}
\end{frame}

\begin{frame}[label=q6T3]{Teori 3 (9 pikë)}
  \begin{Ushtrim}[(Teori 3)]
    \begin{enumerate}
      \item Sa dummy duhen për një faktor me $k$ nivele? Çfarë mat koeficienti i secilit?
      \item Çfarë është ndërveprimi dhe parimi hierarkik?
      \item Dalloni AIC, BIC dhe $K$-fold CV si kritere përzgjedhjeje.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s6T3}{Zgjidhja}
\end{frame}

\begin{frame}[label=q6E1]{Ushtrimi 1 (10 pikë): vlerësimi}
  \begin{Ushtrim}[(Ushtrimi 1, pa ndihmën e PC)]
    $x_1=(-2,-1,0,1,2)$, $x_2=(1,-1,0,-1,1)$, $y=(3,1,4,6,11)$.
    \begin{enumerate}
      \item Tregoni që $x_1$ dhe $x_2$ janë ortogonalë dhe shkruani $\bm X^\top\bm X$, $\bm X^\top\bm y$.
      \item Gjeni $\hat{\bm\beta}$.
      \item Llogaritni mbetjet, SSE, SST, $R^2$ dhe $R^2_{adj}$.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s6E1}{Zgjidhja}
\end{frame}

\begin{frame}[label=q6E2]{Ushtrimi 2 (10 pikë): testet}
  \begin{Ushtrim}[(Ushtrimi 2, pa ndihmën e PC)]
    Me të dhënat e Ushtrimit 1 ($t_{0.975;\,2}=4.303$, $F_{0.95;\,2,2}=19$):
    \begin{enumerate}
      \item Llogaritni $\hat\sigma^2$, $SE(\hat\beta_1)$, $SE(\hat\beta_2)$ dhe statistikat $t$.
      \item Cilët koeficientë janë të rëndësishëm në $\alpha=0.05$?
      \item Llogaritni $F$ global dhe vendosni.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s6E2}{Zgjidhja}
\end{frame}

\begin{frame}[label=q6E3]{Ushtrimi 3 (10 pikë): testi $F$ i pjesshëm}
  \begin{Ushtrim}[(Ushtrimi 3, pa ndihmën e PC)]
    $n=60$. Modeli i plotë ka 5 shpjegues dhe SSE $=400$. Pa 3 prej tyre, SSE $=520$.
    \begin{enumerate}
      \item Shkruani $H_0$ dhe shkallët e lirisë.
      \item Llogaritni $F$; vendosni me $F_{0.95;\,3,54}=2.78$.
      \item A mund ta merrnit këtë përfundim nga tre testet $t$ veç e veç? Pse?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s6E3}{Zgjidhja}
\end{frame}

\begin{frame}[label=q6E4]{Ushtrimi 4 (10 pikë): dummy dhe ndërveprim}
  \begin{Ushtrim}[(Ushtrimi 4, pa ndihmën e PC; shembull hipotetik)]
    \small
    $y$ = të ardhurat mujore (mijë lekë), $x$ = vite përvojë, $d=1$ urban, $0$ rural:
    \[ \hat y=30+2.5x+8d-1.0\,x\,d. \]
    \begin{enumerate}
      \item Shkruani vijën për rural dhe për urban.
      \item Sa është dallimi urban$-$rural për $x=0$ dhe për $x=10$?
      \item Për cilën $x$ vijat priten? Interpretoni.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s6E4}{Zgjidhja}
\end{frame}

\begin{frame}[label=q6E5]{Ushtrimi 5 (10 pikë): ndërveprim sasior}
  \begin{Ushtrim}[(Ushtrimi 5, pa ndihmën e PC)]
    \texttt{Advertising}: $\widehat{\texttt{sales}}=6.75+0.0191\,\texttt{TV}+0.0289\,\texttt{radio}+0.00109\,\texttt{TV}\cdot\texttt{radio}$.
    \begin{enumerate}
      \item Efekti i 1 mijë \$ më shumë në TV kur radio $=25$.
      \item Shitjet e parashikuara për TV $=100$, radio $=25$.
      \item Pse koeficienti $0.0191$ vetëm nuk është ``efekti i TV''?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s6E5}{Zgjidhja}
\end{frame}

\begin{frame}[fragile,shrink=14,label=q6E6]{Ushtrimi 6 (10 pikë): lexo output-in}
<<quiz-auto, echo=FALSE>>=
auto <- na.omit(read.csv(file.path(W06DATA, "Auto.csv"), na.strings = "?"))
auto$origin <- factor(auto$origin, labels = c("USA", "Europe", "Japan"))
summary(lm(mpg ~ weight + year + origin, data = auto))
@
  Interpretoni \texttt{weight}, \texttt{year} dhe \texttt{originJapan}. Çfarë tregon $R^2_{adj}$? Si do ta testonit origjinën si faktor? \hfill\shkoTe{s6E6}{Zgjidhja}
\end{frame}

\begin{frame}[shrink=5,label=q6E7]{Ushtrimi 7 (15 pikë): përzgjedhja}
  \begin{Ushtrim}[(Ushtrimi 7, pa ndihmën e PC)]
    \small
    $n=100$; $\log 2.5=0.916$, $\log 2.3=0.833$, $\log 2.25=0.811$, $\log100=4.605$.
    \begin{center}
      \begin{tabular}{@{}lccc@{}}
        \toprule
        Modeli & $k$ (parametra) & SSE & 10-fold CV MSE (SE) \\ \midrule
        M1 & 3 & 250 & 2.62 (0.10) \\
        M2 & 5 & 230 & 2.55 (0.10) \\
        M3 & 8 & 225 & 2.71 (0.11) \\ \bottomrule
      \end{tabular}
    \end{center}
    \begin{enumerate}
      \item Llogaritni AIC $=n\log(\text{SSE}/n)+2k$ dhe BIC $=n\log(\text{SSE}/n)+k\log n$.
      \item Cilin model zgjedh secili kriter? Po CV, me rregullin ``1 SE''?
      \item Cilin do të raportonit dhe pse?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s6E7}{Zgjidhja}
\end{frame}

\begin{frame}{Tabela e pikëve}
  \centering
  \begin{tabular}{@{}lcc@{}}
    \toprule
    Pjesa & Pyetjet & Pikët \\ \midrule
