% ------------------------------------------------------------
\subsection{Ushtrime për shtëpi}
% ------------------------------------------------------------

\begin{frame}[label=h6H1]{Ushtrime për shtëpi 1--2}
  \begin{Ushtrim}[(Shtëpi 1: \texttt{Advertising})]
    Krahaso me 10-fold CV: \texttt{TV + radio}, \texttt{TV * radio}, \texttt{TV * radio + I(TV\^{}2)}. Cilin zgjedh?
  \end{Ushtrim}
  \shkoTe{s6H1}{Zgjidhja}
  \begin{Ushtrim}[(Shtëpi 2: \texttt{Credit})]
    Shto ndërveprimin \texttt{Rating * Student} te \texttt{fit6}. Testoje dhe interpretoje.
  \end{Ushtrim}
  \shkoTe{s6H2}{Zgjidhja}
\end{frame}

\begin{frame}[label=h6H3]{Ushtrime për shtëpi 3--4}
  \begin{Ushtrim}[(Shtëpi 3: \texttt{Auto}, lakimi)]
    Krahaso me CV \texttt{mpg \textasciitilde{} horsepower + weight} me \texttt{mpg \textasciitilde{} horsepower + I(horsepower\^{}2) + weight}.
  \end{Ushtrim}
  \shkoTe{s6H3}{Zgjidhja}
  \begin{Ushtrim}[(Shtëpi 4: variabla e harruar)]
    Përsërit simulimin e Orës 3 me $\beta_2\in\{-2,0,1\}$ dhe $\rho=0.5$. Krahaso mesataren e pjerrësisë së thjeshtë me $\beta_1+\beta_2\rho$.
  \end{Ushtrim}
  \shkoTe{s6H4}{Zgjidhja}
\end{frame}

\begin{frame}[label=h6H5]{Ushtrime për shtëpi 5--6}
  \begin{Ushtrim}[(Shtëpi 5: CV nga zero)]
    Shkruaj \texttt{cv\_lm(formula, data, K)} pa \texttt{boot}. Krahasoje me \texttt{cv.glm()} te \texttt{Auto}.
  \end{Ushtrim}
  \shkoTe{s6H5}{Zgjidhja}
  \begin{Ushtrim}[(Shtëpi 6: \texttt{Boston})]
    Me \texttt{MASS::Boston} pa kolonën e racës: \texttt{step()} me BIC nga \texttt{medv \textasciitilde{} .}; CV i modelit të zgjedhur; interpreto tre koeficientë.
  \end{Ushtrim}
  \shkoTe{s6H6}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Gabimet e javës}
% ------------------------------------------------------------

\begin{frame}{Gabimet e zakonshme: interpretimi}
  \begin{itemize}
    \item<1-> Koeficienti i pjesshëm lexuar si efekt total (pa ``duke mbajtur të tjerat konstante'').
    \item<2-> ``Nuk është i rëndësishëm, pra nuk ka efekt'' kur shpjeguesit janë të korreluar.
    \item<3-> Krahasimi i koeficientëve me njësi të ndryshme.
    \item<4-> Efekti kryesor i interpretuar kur ka ndërveprim.
  \end{itemize}
\end{frame}

\begin{frame}{Gabimet e zakonshme: modelimi}
  \begin{itemize}
    \item<1-> Faktori i koduar si numër.
    \item<2-> Testi i faktorit me $t$ të dummy-ve në vend të \texttt{anova()}.
    \item<3-> Ndërveprim pa efektet kryesore (shkelje e parimit hierarkik).
    \item<4-> Zgjedhja e modelit me $R^2$.
  \end{itemize}
\end{frame}

\begin{frame}{Gabimet e zakonshme: validimi}
  \begin{itemize}
    \item<1-> Vlerësimi i gabimit me të njëjtat të dhëna që ndërtuan modelin.
    \item<2-> Përzgjedhja e variablave jashtë CV (rrjedhje informacioni).
    \item<3-> Vlerat $p$ pas \texttt{step()} të trajtuara si të ``pastra''.
    \item<4-> Një ndarje e vetme train/test si e vërtetë absolute.
  \end{itemize}
\end{frame}

\begin{frame}{Lista e kontrollit e një regresioni të shumëfishtë}
  \begin{enumerate}
    \item Pyetja: shpjegim apo parashikim? Kandidatët nga teoria.
    \item Faktorët si \texttt{factor()}, niveli bazë i qartë.
    \item Korrelacionet midis shpjeguesve (Java 3).
    \item \texttt{lm()}, \texttt{summary()}: $F$, $t$, $R^2_{adj}$, RSE.
    \item Ndërveprime vetëm me arsye; parimi hierarkik; qendërzim.
    \item Krahaso modelet me CV (+ AIC/BIC); zgjidh më të thjeshtin të mirë.
    \item Diagnostikimi (Java 7) dhe raporti me IB.
  \end{enumerate}
\end{frame}

% ------------------------------------------------------------
\subsection{Fletë-kujtesa}
% ------------------------------------------------------------

\begin{frame}{Fletë-kujtesa 1: formulat}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    Madhësia & Formula \\ \midrule
    OLS & $\hat{\bm\beta}=(\bm X^\top\bm X)^{-1}\bm X^\top\bm y$, \ $\operatorname{Var}=\sigma^2(\bm X^\top\bm X)^{-1}$ \\
    Gabimi & $\hat\sigma^2=\text{SSE}/(n-p-1)$ \\
    $R^2_{adj}$ & $1-(1-R^2)(n-1)/(n-p-1)$ \\
    $F$ global & $\dfrac{\text{SSR}/p}{\text{SSE}/(n-p-1)}$ \\
    $F$ i pjesshëm & $\dfrac{(\text{SSE}_R-\text{SSE}_F)/q}{\text{SSE}_F/(n-p-1)}$ \\
    Variabla e harruar & $E[\hat\beta_1^{\text{thj}}]=\beta_1+\beta_2\operatorname{Cov}(x_1,x_2)/\operatorname{Var}(x_1)$ \\
    AIC, BIC & $n\log(\text{SSE}/n)+2k$, \ $n\log(\text{SSE}/n)+k\log n$ \\
    LOOCV (OLS) & $\frac1n\sum\big(e_i/(1-h_{ii})\big)^2$ \\ \bottomrule
  \end{tabular}
\end{frame}

\begin{frame}{Fletë-kujtesa 2: funksionet R}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    Detyra & Funksioni \\ \midrule
    Modeli & \texttt{lm(y \textasciitilde{} x1 + x2 + f, data)}, \texttt{lm(y \textasciitilde{} .)} \\
    Ndërveprime & \texttt{x * d}, \texttt{x:d}, \texttt{I(x\^{}2)} \\
    Faktorët & \texttt{factor()}, \texttt{relevel(ref = )}, \texttt{model.matrix()} \\
    Testet & \texttt{summary()}, \texttt{anova(small, big)}, \texttt{confint()}, \texttt{vcov()} \\
    Përzgjedhja & \texttt{step(fit, k = 2 / log(n))}, \texttt{leaps::regsubsets()} \\
    Kriteret & \texttt{AIC()}, \texttt{BIC()}, \texttt{summary(fit)\$adj.r.squared} \\
    Validimi & \texttt{sample()}, \texttt{boot::cv.glm(data, glm(...), K = 10)} \\ \bottomrule
  \end{tabular}
\end{frame}

\begin{frame}{Fletë-kujtesa 3: grafikët}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    Grafiku & Funksioni \\ \midrule
    Vija sipas grupit & \texttt{ggplot(aes(x, y, colour = g)) + geom\_smooth(method = "lm")} \\
    Ndërveprim sasior & \texttt{expand.grid()} + \texttt{predict()} + \texttt{geom\_line()} \\
    Plani 3D & \texttt{pgfplots} \texttt{surf}, ose \texttt{persp()} \\
    Kurba e CV & \texttt{plot(size, cv\_mse, type = "b")} \\
    Kriteret sipas madhësisë & \texttt{plot(regsubsets\_obj, scale = "bic")} \\ \bottomrule
  \end{tabular}
\end{frame}

% ------------------------------------------------------------
\subsection{Pamje e Javës 7}
% ------------------------------------------------------------

\begin{frame}{Java 7: testet dhe diagnostikimi \LO{S3} \LO{C1}}
  \begin{itemize}
    \item<1-> A i plotëson modeli supozimet? Mbetjet, QQ, \texttt{plot(fit)}.
    \item<2-> Vëzhgimet e veçanta: leverage $h_{ii}$, mbetjet e studentizuara, distanca e Cook-ut.
    \item<3-> Multikolineariteti: VIF (\texttt{car::vif}, si në repo për \texttt{fit6}); \texttt{Rating + Limit}.
    \item<4-> Heteroskedasticiteti: testi Breusch--Pagan, SE robuste, transformimet.
  \end{itemize}
\end{frame}

\begin{frame}{Para Javës 7}
  \begin{itemize}
    \item Mbaroni ushtrimet për shtëpi 1--6.
    \item Rishikoni grafikët e mbetjeve të Javës 5 (\texttt{Boston}, \texttt{Auto}, \texttt{Advertising}).
    \item Lexoni ISLR kap.~3.3.3 (problemet e mundshme).
  \end{itemize}
\end{frame}

\begin{frame}{Burime}
  \footnotesize
  \begin{itemize}
    \item E.~Raço, E.~Llagami, K.~Haxhi, O.~Zaçaj, \emph{Teoria e Probabilitetit dhe Statistika Matematike me ilustrime në gjuhën R}, Kotti, 2021 (regresi i shumëfishtë).
    \item J.~Cohen, P.~Cohen, S.~G.~West, L.~S.~Aiken, \emph{Applied Multiple Regression/Correlation Analysis for the Behavioral Sciences}, LEA, 2003 (koeficientët e pjesshëm, variablat kategorike, ndërveprimet).
    \item G.~James, D.~Witten, T.~Hastie, R.~Tibshirani, \emph{An Introduction to Statistical Learning}, Springer, kap.~3, 5, 6; \url{https://www.statlearning.com}.
    \item N.~Lo, \emph{DS612 Data Mining with Business Applications (R)}, \url{https://github.com/NormanLo4319/DS612_Data_Mining_with_Business_Applications_R} (licencë MIT): \texttt{Linear\_Regression.R} (\texttt{fit1}--\texttt{fit7}), \texttt{Test\_Training\_Split.R}, \texttt{CrossValidation\_Review.R}.
    \item H.~Akaike (1974), \emph{IEEE Transactions on Automatic Control} 19(6); G.~Schwarz (1978), \emph{Annals of Statistics} 6(2).
    \item Paketat: \texttt{boot}, \texttt{leaps}, \texttt{car}, \texttt{ggplot2}.
  \end{itemize}
\end{frame}

