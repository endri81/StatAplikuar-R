% ============================================================
%  Java 6 · Ora 1 — Motivimi: shumë shpjegues njëherësh
%  Rezultatet: K2, S1, S2
%  Burimi: ISLR kap. 3.2; repo DS612 (Advertising, CrossValidation_Review: Auto)
% ============================================================

\section{Motivimi}

\begin{frame}{Ora 1: Motivimi --- shumë shpjegues njëherësh}
  \tableofcontents[currentsection,hideothersubsections,sectionstyle=show/hide]
\end{frame}

% ------------------------------------------------------------
\subsection{Problemi motivues}
% ------------------------------------------------------------

\begin{frame}{Pyetja e ditës \LO{K2}}
  \begin{itemize}
    \item<1-> Firma shpenzon në \textbf{tre} kanale: TV, radio, gazeta.
    \item<2-> Java 5: tre regresione të thjeshta, një për çdo kanal.
    \item<3-> Menaxheri pyet: \textbf{nëse e mbaj TV-në dhe radion të njëjta, a ia vlen të shpenzoj më shumë në gazeta?}
    \item<4-> Kjo pyetje kërkon një model me të tre kanalet njëherësh.
  \end{itemize}
  \onslide<5->{\footnotesize\textcolor{gray}{Të dhëna: reale, \texttt{Advertising.csv} (ISLR, kap.~3, nëpërmjet repo-s DS612); 200 tregje, buxhetet në mijë \$, shitjet në mijë njësi.}}
\end{frame}

\begin{frame}[fragile]{Tre regresione të thjeshta}
<<adv-simple>>=
adv <- read.csv(file.path(W06DATA, "Advertising.csv"))[, -1]
simple <- t(sapply(c("TV", "radio", "newspaper"), function(v) {
  s <- summary(lm(adv$sales ~ adv[[v]]))
  c(slope = s$coefficients[2, 1], se = s$coefficients[2, 2],
    p = s$coefficients[2, 4], R2 = s$r.squared)
}))
signif(simple, 3)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Të tre kanalet lidhen pozitivisht dhe në mënyrë të rëndësishme me shitjet.
    \item<2-> Gazetat: 1000 \$ më shumë $\leftrightarrow$ $\approx55$ njësi më shumë ($p=0.001$).
    \item<3-> Por çdo model \emph{injoron} dy kanalet e tjera.
  \end{itemize}
\end{frame}

\begin{frame}[label=pyetjeNews]{Parashiko!}
  \begin{Parashiko}
    Tani përshtatim \texttt{sales \textasciitilde{} TV + radio + newspaper}. Çfarë pret për koeficientin e \texttt{newspaper}?\\[3pt]
    \textbf{A)} Afërsisht si më parë ($\approx0.055$, i rëndësishëm).\\
    \textbf{B)} Më i madh, sepse modeli është më i mirë.\\
    \textbf{C)} Afër zeros dhe jo i rëndësishëm.\\
    \textbf{D)} Negativ dhe i rëndësishëm.
  \end{Parashiko}
  \shkoTe{zgjNews}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[fragile]{Modeli i shumëfishtë}
<<adv-full>>=
fit_all <- lm(sales ~ TV + radio + newspaper, data = adv)
round(summary(fit_all)$coefficients, 4)
c(R2 = summary(fit_all)$r.squared, RSE = sigma(fit_all))
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> TV dhe radio: të rëndësishme, me koeficientë afër atyre të thjeshtë.
    \item<2-> Gazetat: koeficienti $\approx\Sexpr{fmt(coef(fit_all)["newspaper"], 4)}$, $p=\Sexpr{fmt(summary(fit_all)$coefficients["newspaper", 4], 2)}$. Lidhja \textbf{u zhduk}!
    \item<3-> $R^2$ kalon nga 0.61 (vetëm TV) në $\Sexpr{fmt(summary(fit_all)$r.squared, 3)}$; RSE nga 3.26 në $\Sexpr{fmt(sigma(fit_all), 2)}$.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Pse? Korrelacionet midis kanaleve}
<<adv-cor>>=
round(cor(adv), 3)
@
  \begin{itemize}
    \item<2-> $r(\texttt{radio},\texttt{newspaper})=0.35$: tregjet që shpenzojnë shumë në radio shpenzojnë edhe në gazeta.
  \end{itemize}
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Regresi i thjeshtë i gazetave ``merr kredi'' për efektin e radios.
    \item<2-> Kur radio është në model, gazetat nuk shtojnë informacion të ri.
    \item<3-> ISLR e krahason me lidhjen midis shitjes së akullores dhe sulmeve të peshkaqenëve: të dyja rriten në verë.
  \end{itemize}
  \onslide<4->{\begin{Keshille}Java 3, Simpson-i dhe korrelacioni i pjesshëm: e njëjta ide, tani në gjuhën e regresionit.\end{Keshille}}
\end{frame}

\begin{frame}{``Duke mbajtur të tjerat konstante''}
  \begin{itemize}
    \item<1-> Në modelin $y=\beta_0+\beta_1x_1+\beta_2x_2+\beta_3x_3+\varepsilon$:
    \item<2-> $\beta_3$ = ndryshimi i pritur i $y$ kur $x_3$ rritet me 1 \textbf{dhe} $x_1,x_2$ mbeten të njëjta.
    \item<3-> Quhet \termi{koeficient i pjesshëm}{partial regression coefficient}.
    \item<4-> Regresi i thjeshtë jep efektin \textbf{total} (bashkë me çdo gjë që lëviz me $x_3$).
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Një parapamje: regresi i mbetjeve}
<<adv-fwl>>=
e_news  <- residuals(lm(newspaper ~ TV + radio, data = adv))   # news not explained by TV, radio
e_sales <- residuals(lm(sales ~ TV + radio, data = adv))       # sales not explained by TV, radio
coef(lm(e_sales ~ e_news))[2]
coef(fit_all)["newspaper"]
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Hiqe nga gazetat dhe nga shitjet pjesën që shpjegojnë TV dhe radio.
    \item<2-> Pjerrësia e mbetjeve = koeficienti i \texttt{newspaper} në modelin e plotë. Saktësisht.
    \item<3-> Kjo është teorema Frisch--Waugh--Lovell (Ora 2), dhe e njëjta ide si korrelacioni i pjesshëm i Javës 3.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Objektivat}
% ------------------------------------------------------------

\begin{frame}{Objektivat e ditës}
  Në fund të ditës do të jesh në gjendje:
  \begin{enumerate}
    \item \LO{S1} të shkruash dhe interpretosh modelin $y=\beta_0+\sum\beta_jx_j+\varepsilon$;
    \item \LO{K2} të testosh koeficientët ($t$), modelin ($F$) dhe grupe koeficientësh ($F$ i pjesshëm);
    \item \LO{S2} të përfshish parashikues cilësorë dhe ndërveprime;
    \item \LO{S3} të krahasosh modele me $R^2_{adj}$, AIC/BIC dhe cross-validation;
    \item \LO{C1} të ndërtosh dhe justifikosh një model në një rast real.
  \end{enumerate}
\end{frame}

\begin{frame}{Lidhja me javët e tjera}
  \begin{itemize}
    \item<1-> Java 3: korrelacioni i pjesshëm $\to$ sot: koeficienti i pjesshëm.
    \item<2-> Java 4: ANOVA dhe ndërveprimet $\to$ sot: dummy dhe ndërveprimet në \texttt{lm()}.
    \item<3-> Java 5: $\hat{\bm\beta}=(\bm X^\top\bm X)^{-1}\bm X^\top\bm y$ $\to$ sot: e njëjta formulë me më shumë kolona.
    \item<4-> Java 7: diagnostikimi, VIF; Java 9: klasifikimi me të njëjtën strukturë.
  \end{itemize}
\end{frame}

\begin{frame}{Plani i ditës}
