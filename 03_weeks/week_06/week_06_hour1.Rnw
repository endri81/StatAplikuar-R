  \end{tikzpicture}
\end{frame}

% ------------------------------------------------------------
\subsection{Pse një model i vetëm?}
% ------------------------------------------------------------

\begin{frame}{Tri arsye}
  \begin{enumerate}
    \item<1-> \textbf{Konfuzioni}: regresi i thjeshtë përzien efektin e $x_j$ me efektet e variablave që lëvizin bashkë me të.
    \item<2-> \textbf{Parashikimi}: informacioni nga të gjithë shpjeguesit bashkë jep parashikime më të sakta.
    \item<3-> \textbf{Ndërveprimet}: efekti i një kanali mund të varet nga tjetri (Ora 4).
  \end{enumerate}
\end{frame}

\begin{frame}[fragile]{Saktësia e parashikimit}
<<adv-compare>>=
rbind(TV_only = c(R2 = simple["TV", "R2"], RSE = sigma(lm(sales ~ TV, data = adv))),
      all_three = c(R2 = summary(fit_all)$r.squared, RSE = sigma(fit_all)))
predict(fit_all, data.frame(TV = 100, radio = 20, newspaper = 10),
        interval = "prediction")
@
  \begin{itemize}
    \item<2-> RSE bie me rreth gjysmën: IP për një treg të ri ngushtohet ndjeshëm.
  \end{itemize}
\end{frame}

\begin{frame}[label=ushBudget]{Radha jote!}
  \begin{Ushtrim}[(5 minuta)]
    Përdor modelin \texttt{sales \textasciitilde{} TV + radio} (pa gazeta). Një buxhet prej 100 mijë \$:
    \begin{enumerate}
      \item Sa shitje parashikon nëse gjithçka shkon në TV?
      \item Po nëse ndahet 70 TV / 30 radio?
      \item Pse modeli thotë që radio është ``më fitimprurëse'' për çdo dollar? Çfarë supozon modeli që mund të mos jetë e vërtetë?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjBudget}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{\texttt{Auto}: konfuzioni në veprim}
% ------------------------------------------------------------

\begin{frame}[fragile]{Fuqia e motorit, me dhe pa peshën}
<<auto-conf>>=
auto <- na.omit(read.csv(file.path(W06DATA, "Auto.csv"), na.strings = "?"))
rbind(hp_only      = c(coef(lm(mpg ~ horsepower, data = auto)), weight = NA),
      hp_and_weight = coef(lm(mpg ~ horsepower + weight, data = auto)))
cor(auto$horsepower, auto$weight)
@
  \footnotesize\textcolor{gray}{Të dhëna: reale, \texttt{Auto} (ISLR); si te \texttt{CrossValidation\_Review.R} i repo-s (\texttt{fit1}, \texttt{fit2}).}
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Vetëm: çdo hp $\leftrightarrow$ $-0.158$ mpg. Me peshën në model: vetëm $-0.047$.
    \item<2-> Rreth 70\% e ``efektit'' të fuqisë ishte në fakt efekti i peshës.
    \item<3-> Për dy makina me \textbf{të njëjtën peshë}, 10 hp më shumë lidhen me vetëm $\approx0.5$ mpg më pak.
  \end{itemize}
\end{frame}

\begin{frame}[label=ushYear]{Ndrysho parametrin dhe shiko}
  \begin{Ushtrim}[(4 minuta)]
    Shto \texttt{year} në modelin \texttt{mpg \textasciitilde{} horsepower + weight}.
    \begin{enumerate}
      \item Si ndryshon koeficienti i \texttt{horsepower}?
      \item Interpreto koeficientin e \texttt{year}. Pse ka kuptim teknologjik?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjYear}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Pyetjet e ditës}
% ------------------------------------------------------------

\begin{frame}{Gjashtë pyetje (ISLR, kap.~3)}
  \begin{enumerate}
    \item<1-> A ka lidhje midis shpjeguesve dhe $y$? \hfill (testi $F$, Ora 2)
    \item<2-> Cilët shpjegues kontribuojnë? \hfill (testet $t$, përzgjedhja, Ora 6)
    \item<3-> Sa i fortë është modeli? \hfill ($R^2$, RSE)
    \item<4-> Sa i saktë është parashikimi? \hfill (IB, IP, CV)
    \item<5-> A janë efektet aditive? \hfill (ndërveprimet, Ora 4)
    \item<6-> A ka lakim ose probleme të tjera? \hfill (Java 7--8)
  \end{enumerate}
\end{frame}

\begin{frame}{Gabime të zakonshme për fillim}
  \begin{Gabim}``Gazetat nuk funksionojnë.'' Modeli thotë: \emph{duke mbajtur TV dhe radio konstante}, gazetat nuk shtojnë lidhje të dukshme në këto të dhëna. Nuk është eksperiment.\end{Gabim}
  \pause
  \begin{Gabim}Krahasimi i madhësisë së koeficientëve me njësi të ndryshme: $0.19$ (radio) $>0.046$ (TV) nuk do të thotë që radio ``është më e rëndësishme''. Krahaso $t$, ose standardizo.\end{Gabim}
\end{frame}

% ------------------------------------------------------------
\subsection{Mbyllja e orës}
% ------------------------------------------------------------

\begin{frame}[label=cp61]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 1}
  \begin{enumerate}
    \item Pse koeficienti i \texttt{newspaper} ndryshon nga modeli i thjeshtë te ai i shumëfishtë?
    \item Çfarë do të thotë ``duke mbajtur të tjerat konstante''?
    \item Si e merr koeficientin e pjesshëm me dy regresione mbetjesh?
  \end{enumerate}
  \shkoTe{zgjCp61}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje: Ora 1}
  \begin{itemize}
    \item Tre regresione të thjeshta $\neq$ një model me tre shpjegues.
    \item \texttt{newspaper}: i rëndësishëm vetëm ($r$ me radio $=0.35$), jo i rëndësishëm me të tjerët.
    \item Koeficienti i pjesshëm = efekti kur të tjerët mbeten konstantë = pjerrësia e mbetjeve.
    \item \texttt{Auto}: $-0.158\to-0.047$ mpg/hp kur shtohet pesha.
  \end{itemize}
  \begin{Keshille}Ora 2: modeli në formë matricore, testet $t$ dhe $F$, $R^2_{adj}$, shembull me 5 pika pa ndihmën e PC.\end{Keshille}
\end{frame}
