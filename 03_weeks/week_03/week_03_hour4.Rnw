% ============================================================
%  Java 3 · Ora 4 — Teori II: rangjet dhe inferenca
%  Rezultatet: K1, S3, S1
%  Material plotësues
% ============================================================

\section{Rangjet dhe testet}

\begin{frame}{Ora 4: Spearman, Kendall dhe inferenca}
  \tableofcontents[currentsection,hideothersubsections,sectionstyle=show/hide]
\end{frame}

% ------------------------------------------------------------
\subsection{Spearman}
% ------------------------------------------------------------

\begin{frame}{Ideja: korrelacioni i rangjeve \LO{K1} \Plotesues}
  \begin{itemize}
    \item<1-> Zëvendëso çdo vlerë me \termi{rangun}{rank} e saj: 1 për më të voglën, $n$ për më të madhen.
    \item<2-> Llogarit Pearson-in mbi rangjet.
    \item<3-> Rezultati mat lidhjen \textbf{monotone}, jo vetëm lineare.
  \end{itemize}
  \onslide<4->{\begin{Keshille}Si mediana te Java 2: rangjet ``zbusin'' vlerat ekstreme. Vlera 1\,000 dhe 50 marrin të njëjtin rang nëse janë të dyja më të mëdhatë.\end{Keshille}}
\end{frame}

\begin{frame}{Formula e Spearman-it}
  \begin{Definicion}[(Spearman, pa rangje të barabarta)]
    \[ r_s=1-\frac{6\sum_{i=1}^{n}d_i^2}{n(n^2-1)},\qquad d_i=\operatorname{rang}(x_i)-\operatorname{rang}(y_i) \]
  \end{Definicion}
  \pause
  \begin{itemize}
    \item Kur rangjet përputhen plotësisht, $d_i=0$ dhe $r_s=1$.
    \pause
    \item Me rangje të barabarta (\emph{ties}), përdorim rangun mesatar dhe Pearson-in mbi rangjet; formula me $d_i^2$ bëhet e përafërt.
  \end{itemize}
\end{frame}

\begin{frame}{Shembull pa ndihmën e PC}
  $x=(10,20,30,40,50)$, \ $y=(1,3,2,5,4)$.
  \pause
  \begin{enumerate}
    \item Rangjet e $x$: $1,2,3,4,5$. Rangjet e $y$: $1,3,2,5,4$.
    \pause
    \item $d_i$: $0,-1,1,-1,1$; \ $\sum d_i^2=4$.
    \pause
    \item $r_s=1-\dfrac{6\cdot4}{5\cdot24}=1-\dfrac{24}{120}=0.8$.
  \end{enumerate}
\end{frame}

\begin{frame}[fragile]{Kontrolli me R}
<<spear-check>>=
x <- c(10, 20, 30, 40, 50); y <- c(1, 3, 2, 5, 4)
cor(x, y, method = "spearman")
cor(rank(x), rank(y))            # Pearson on ranks: identical
rank(c(5, 2, 2, 9))              # ties get the average rank
@
\end{frame}

\begin{frame}[fragile]{Lidhje monotone, jo lineare}
<<monotone>>=
xm <- 1:20
ym <- exp(xm / 3)                 # strictly increasing, very curved
round(c(pearson = cor(xm, ym), spearman = cor(xm, ym, method = "spearman")), 3)
@
  \begin{itemize}
    \item Spearman = 1: rendi ruhet plotësisht. Pearson $<1$: vija nuk është e drejtë.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Qëndrueshmëria ndaj vlerave të skajshme}
<<spear-outlier>>=
set.seed(2026)
x0 <- rnorm(20); y0 <- rnorm(20)              # no relationship
x1 <- c(x0, 8);  y1 <- c(y0, 8)               # the leverage point of Hour 2
round(rbind(
  without = c(pearson = cor(x0, y0), spearman = cor(x0, y0, method = "spearman")),
  with    = c(cor(x1, y1), cor(x1, y1, method = "spearman"))), 3)
@
  \begin{itemize}
    \item Pika e skajshme e ndryshon Pearson-in shumë më tepër se Spearman-in.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Kendall}
% ------------------------------------------------------------

\begin{frame}{Kendall: çiftet në përputhje}
  \begin{Definicion}[(Kendall $\tau$, pa rangje të barabarta)]
    Për çdo çift vrojtimesh $(i,j)$: \textbf{në përputhje} nëse $x$ dhe $y$ rriten bashkë, \textbf{në mospërputhje} nëse njëri rritet dhe tjetri bie.
    \[ \tau=\frac{C-D}{\binom n2} \]
  \end{Definicion}
  \pause
  \begin{itemize}
    \item $\tau$ = probabiliteti i përputhjes minus probabiliteti i mospërputhjes, për një çift të rastësishëm.
    \pause
    \item Interpretim më i drejtpërdrejtë se Spearman-i.
  \end{itemize}
\end{frame}

\begin{frame}{Shembull pa ndihmën e PC}
  \begin{columns}[c]
    \column{0.5\textwidth}
      Rangjet e $y$ sipas renditjes së $x$: $1,\ 3,\ 2,\ 5,\ 4$.
      \begin{enumerate}
        \item<2-> Çifte gjithsej: $\binom52=10$.
        \item<3-> Mospërputhje: $(3,2)$ dhe $(5,4)$ $\Rightarrow D=2$.
        \item<4-> Përputhje: $C=10-2=8$.
        \item<5-> $\tau=(8-2)/10=0.6$.
      \end{enumerate}
    \column{0.46\textwidth}
      \centering
      \begin{tikzpicture}[scale=0.75]
        \draw[->,gray] (0,0)--(5.6,0) node[right,font=\tiny]{rangu $x$};
        \draw[->,gray] (0,0)--(0,5.6) node[above,font=\tiny]{rangu $y$};
        \foreach \x/\y in {1/1,2/3,3/2,4/5,5/4} \fill[uptmid] (\x,\y) circle (3pt);
        \draw[warnred,thick] (2,3)--(3,2);
        \draw[warnred,thick] (4,5)--(5,4);
        \draw[okgreen,thin] (1,1)--(2,3) (3,2)--(4,5);
      \end{tikzpicture}
  \end{columns}
\end{frame}

\begin{frame}[fragile]{Kontrolli me R}
<<kendall-check>>=
cor(x, y, method = "kendall")
pairs_sign <- outer(x, x, "-") * outer(y, y, "-")   # product of differences
upper <- pairs_sign[upper.tri(pairs_sign)]
c(C = sum(upper > 0), D = sum(upper < 0))
@
\end{frame}

\begin{frame}{Pearson, Spearman apo Kendall?}
  \footnotesize
  \begin{tabular}{@{}llll@{}}
    \toprule
     & Pearson & Spearman & Kendall \\ \midrule
    Mat & lidhjen lineare & lidhjen monotone & lidhjen monotone \\
    Shkalla & intervalore/raporti & rendore e lart & rendore e lart \\
    Vlera të skajshme & e ndjeshme & e qëndrueshme & e qëndrueshme \\
    Interpretimi & $r^2$ = varianca e shpjeguar & Pearson mbi rangjet & $P(\text{përp.})-P(\text{mosp.})$ \\
    Madhësia & -- & zakonisht $|r_s|>|\tau|$ & më e vogël \\ \bottomrule
  \end{tabular}
  \normalsize
  \vspace{6pt}
  \begin{itemize}
    \item Për variabla rendore (p.sh.\ \texttt{education}) përdor Spearman ose Kendall.
  \end{itemize}
\end{frame}

\begin{frame}[label=pyetjeMethod]{Pyetje me zgjedhje}
  \begin{Ushtrim}
    Cilën metodë do të zgjidhje? (P = Pearson, S/K = Spearman ose Kendall)
    \begin{enumerate}
      \item Niveli i arsimit (5 kategori të renditura) dhe paga.
      \item Gjatësia dhe pesha e 500 studentëve, lidhje gati lineare, pa vlera ekstreme.
      \item \texttt{crim} dhe \texttt{medv} te \texttt{Boston} ($g_1=5.2$ për \texttt{crim}).
      \item Renditja e 10 universiteteve nga dy agjenci të ndryshme.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjMethod}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Testimi i hipotezave: rifreskim}
% ------------------------------------------------------------

\begin{frame}{Rifreskim: logjika e testit}
  \begin{enumerate}
    \item<1-> \textbf{Hipotezat}: $H_0:\rho=0$ (pa lidhje lineare); \ $H_1:\rho\neq0$.
    \item<2-> \textbf{Statistika e testit}: një numër nga mostra, me shpërndarje të njohur nën $H_0$.
    \item<3-> \textbf{Vlera $p$}: probabiliteti, nën $H_0$, të marrim një statistikë sa e ekstreme sa e vrojtuara, ose më shumë.
    \item<4-> \textbf{Vendimi}: nëse $p<\alpha$ (zakonisht 0.05), e hedhim poshtë $H_0$.
  \end{enumerate}
  \onslide<5->{\begin{Gabim}Vlera $p$ \textbf{nuk} është probabiliteti që $H_0$ të jetë e vërtetë.\end{Gabim}}
\end{frame}

\begin{frame}{Dy llojet e gabimeve}
  \centering
  \begin{tabular}{@{}lcc@{}}
    \toprule
     & $H_0$ e vërtetë & $H_0$ e gabuar \\ \midrule
    E hedhim poshtë $H_0$ & \textcolor{warnred}{Gabim i llojit I ($\alpha$)} & vendim i saktë (fuqia) \\
    Nuk e hedhim poshtë & vendim i saktë & \textcolor{warnred}{Gabim i llojit II ($\beta$)} \\ \bottomrule
  \end{tabular}
  \vspace{8pt}
  \begin{itemize}
    \item $\alpha$ e zgjedhim ne. $\beta$ varet nga $n$ dhe nga madhësia e vërtetë e $\rho$.
    \item ``Nuk e hedhim poshtë'' $\neq$ ``e provuam $H_0$'': ndoshta mostra është e vogël.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Testi $H_0:\rho=0$}
% ------------------------------------------------------------

\begin{frame}{Statistika $t$ për korrelacionin}
  \begin{Teoreme}
    Nëse $(X,Y)$ janë normale dydimensionale dhe $\rho=0$, atëherë
    \[ t=\frac{r\sqrt{n-2}}{\sqrt{1-r^2}}\ \sim\ t_{n-2}. \]
  \end{Teoreme}
  \pause
  \begin{itemize}
    \item $t$ rritet me $|r|$ dhe me $n$.
    \pause
    \item Pse $n-2$? Dy parametra (mesataret) vlerësohen para se të llogaritet $r$.
  \end{itemize}
\end{frame}

\begin{frame}{Zonat kritike për $t_{25}$, $\alpha = 0.05$}
  \centering
  \begin{tikzpicture}
    \begin{axis}[width=0.8\textwidth,height=4.4cm,xmin=-4,xmax=4,ymin=0,axis lines=left,samples=120,
      ytick=\empty,xtick={-2.06,0,2.06,2.89},xticklabels={$-2.06$,0,$2.06$,$t=2.89$},ticklabel style={font=\scriptsize}]
      \addplot[draw=none,fill=red!25,domain=2.06:4]{exp(-x^2/2)/sqrt(2*pi)}\closedcycle;
      \addplot[draw=none,fill=red!25,domain=-4:-2.06]{exp(-x^2/2)/sqrt(2*pi)}\closedcycle;
      \addplot[uptblue,thick,domain=-4:4]{exp(-x^2/2)/sqrt(2*pi)};
      \draw[accent,very thick] (axis cs:2.89,0)--(axis cs:2.89,0.15);
    \end{axis}
  \end{tikzpicture}
  \begin{itemize}
    \item Zona e kuqe: 2.5\% në secilin bisht. (Kurba e vizatuar është $N(0,1)$; $t_{25}$ ka bishta pak më të rëndë.)
  \end{itemize}
\end{frame}

\begin{frame}{Shembull pa ndihmën e PC}
  $r=0.5$, \ $n=27$. A është $\rho\neq0$ me $\alpha=0.05$?
  \pause
  \begin{enumerate}
    \item $t=\dfrac{0.5\sqrt{25}}{\sqrt{1-0.25}}=\dfrac{2.5}{0.866}\approx2.887$.
    \pause
    \item Shkallët e lirisë: $n-2=25$; vlera kritike $t_{0.975,\,25}\approx2.060$.
    \pause
    \item $2.887>2.060$ $\Rightarrow$ e hedhim poshtë $H_0$.
  \end{enumerate}
\end{frame}

\begin{frame}[fragile]{Kontrolli me R}
<<t-check>>=
r <- 0.5; n <- 27
t_stat <- r * sqrt(n - 2) / sqrt(1 - r^2)
c(t = t_stat, critical = qt(0.975, df = n - 2),
  p_value = 2 * pt(-abs(t_stat), df = n - 2))
@
  \begin{itemize}
    \item $p\approx\Sexpr{fmt(2 * pt(-abs(t_stat), df = n - 2), 4)}<0.05$: i njëjti përfundim.
  \end{itemize}
\end{frame}

\begin{frame}[label=pyetjeN]{Parashiko!}
  \begin{Parashiko}
    I njëjti $r=0.2$. Për cilin $n$ testi bëhet i rëndësishëm me $\alpha=0.05$?\\[3pt]
    \textbf{A)} $n=20$ \quad \textbf{B)} $n=50$ \quad \textbf{C)} $n=100$ \quad \textbf{D)} $n=1\,000$
  \end{Parashiko}
  \shkoTe{zgjN}{Shiko zgjidhjen}
\end{frame}

\begin{frame}{I rëndësishëm statistikisht $\neq$ i rëndësishëm praktikisht}
  \begin{itemize}
    \item<1-> Me $n=10\,000$, edhe $r=0.03$ jep $p<0.01$.
    \item<2-> Por $r^2=0.0009$: më pak se 0.1\% e variancës.
    \item<3-> Raporto gjithmonë: $r$, intervalin e besimit, $n$, dhe vetëm pastaj $p$.
  \end{itemize}
  \onslide<4->{\begin{Gabim}``$p<0.001$, pra lidhja është shumë e fortë.'' Vlera $p$ mat sigurinë që $\rho\neq0$, jo forcën e lidhjes.\end{Gabim}}
\end{frame}

% ------------------------------------------------------------
\subsection{Intervali i besimit: Fisher $z$}
% ------------------------------------------------------------

\begin{frame}{Transformimi $z$ i Fisher-it}
  \begin{Definicion}[(Fisher, 1915)]
    \[ z=\operatorname{artanh}(r)=\frac12\ln\frac{1+r}{1-r},\qquad z\ \overset{\text{përaf.}}{\sim}\ N\!\left(\operatorname{artanh}(\rho),\ \frac{1}{n-3}\right) \]
  \end{Definicion}
  \pause
  \begin{itemize}
    \item Shpërndarja e $r$ është e anuar (Ora 3); ajo e $z$ është gati normale, me variancë që nuk varet nga $\rho$.
    \pause
    \item Ndërtojmë intervalin në shkallën $z$ dhe e kthejmë me $\tanh$.
  \end{itemize}
\end{frame}

\begin{frame}{Pse ``hapet'' shkalla?}
  \centering
  \begin{tikzpicture}
    \begin{axis}[width=0.62\textwidth,height=4.4cm,xmin=-0.99,xmax=0.99,ymin=-2.8,ymax=2.8,
      axis lines=middle,samples=120,xlabel={$r$},ylabel={$z$},ticklabel style={font=\scriptsize},
      xtick={-0.9,-0.5,0.5,0.9}]
      \addplot[uptmid,very thick,domain=-0.985:0.985]{0.5*ln((1+x)/(1-x))};
      \addplot[gray,dashed,domain=-0.99:0.99]{x};
    \end{axis}
  \end{tikzpicture}
  \begin{itemize}
    \item Afër 0, $z\approx r$. Afër $\pm1$, $z$ ``tërhiqet'': kufiri 1 bëhet $\infty$.
  \end{itemize}
\end{frame}

\begin{frame}{Shembull pa ndihmën e PC}
  $r=0.5$, \ $n=28$, interval 95\%.
  \pause
  \begin{enumerate}
    \item $z=\operatorname{artanh}(0.5)=\frac12\ln3\approx0.549$; \ $SE=1/\sqrt{25}=0.2$.
    \pause
    \item Në shkallën $z$: $0.549\pm1.96\cdot0.2=[0.157,\ 0.941]$.
    \pause
    \item Kthimi: $[\tanh(0.157),\ \tanh(0.941)]\approx[0.156,\ 0.736]$.
  \end{enumerate}
  \pause
  \begin{itemize}
    \item Intervali \textbf{nuk} është simetrik rreth 0.5: më i gjatë drejt 0.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Kontrolli me R}
<<fisher-check>>=
r <- 0.5; n <- 28
z <- atanh(r); se <- 1 / sqrt(n - 3)
tanh(z + c(-1, 1) * qnorm(0.975) * se)
@
\end{frame}

\begin{frame}[fragile]{Me të dhëna reale: \texttt{cor.test()}}
<<cortest-news>>=
adv <- read.csv(file.path(W03DATA, "Advertising.csv"))[, -1]
ct <- cor.test(adv$newspaper, adv$sales)
c(r = unname(ct$estimate), t = unname(ct$statistic),
  df = unname(ct$parameter), p = ct$p.value, ct$conf.int)
@
  \begin{itemize}
    \item \texttt{cor.test()} përdor $t$ për vlerën $p$ dhe Fisher $z$ për intervalin.
  \end{itemize}
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> $r=\Sexpr{fmt(ct$estimate, 3)}$, $p=\Sexpr{fmt(ct$p.value, 4)}$: lidhja lineare me gazetat është statistikisht e rëndësishme.
    \item<2-> Intervali 95\%: $[\Sexpr{fmt(ct$conf.int[1], 2)},\ \Sexpr{fmt(ct$conf.int[2], 2)}]$: lidhje e dobët ose mesatare.
    \item<3-> Kujto Ora 1: kjo \emph{nuk} do të thotë që gazetat shkaktojnë shitje. Në Javën 6 do të shohim se efekti zhduket pasi kontrollojmë radion.
  \end{itemize}
\end{frame}

\begin{frame}[label=ushCI]{Radha jote!}
  \begin{Ushtrim}[(pa ndihmën e PC, 6 minuta)]
    Një studim gjen $r=0.3$ me $n=103$.
    \begin{enumerate}
      \item Llogarit $t$ dhe vendos me $\alpha=0.05$ (vlera kritike $\approx1.98$).
      \item Llogarit intervalin 95\% me Fisher $z$ ($\operatorname{artanh}(0.3)\approx0.310$; $\tanh(0.114)\approx0.113$; $\tanh(0.506)\approx0.467$).
      \item Si do ta raportoje rezultatin në një fjali?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjCI}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Simulimi dhe bootstrap}
% ------------------------------------------------------------

\begin{frame}[fragile]{A funksionon intervali? Simulim i mbulimit \Zgj}
<<coverage>>=
set.seed(2026)
make_pair <- function(n, rho) { x <- rnorm(n); z <- rnorm(n)
  data.frame(x = x, y = rho * x + sqrt(1 - rho^2) * z) }
covered <- replicate(2000, {
  p <- make_pair(30, 0.7)
  ci <- cor.test(p$x, p$y)$conf.int
  ci[1] <= 0.7 && 0.7 <= ci[2]                 # does the CI contain the truth?
})
mean(covered)                                   # should be close to 0.95
@
\end{frame}

\begin{frame}{Bootstrap: ideja \Zgj}
  \begin{itemize}
    \item<1-> Nuk e njohim popullatën; e kemi vetëm mostrën.
    \item<2-> Marrim \textbf{me kthim} $n$ rreshta nga mostra: një ``mostër bootstrap''.
    \item<3-> Llogarisim $r^*$; përsërisim 2\,000 herë.
    \item<4-> Kuantilet 2.5\% dhe 97.5\% të $r^*$ japin intervalin e përqindjeve.
  \end{itemize}
  \onslide<5->{\begin{Keshille}Bootstrap-i nuk kërkon normalitet. Do ta përdorim sërish në Javën 6 (ISLR, kapitulli 5).\end{Keshille}}
\end{frame}

\begin{frame}[fragile]{Bootstrap për korrelacionin \Zgj}
<<boot-cor>>=
library(boot)
set.seed(2026)
r_fun <- function(d, idx) cor(d$newspaper[idx], d$sales[idx])
bt <- boot(adv, r_fun, R = 2000)
round(c(r = bt$t0, boot_ci = quantile(bt$t, c(0.025, 0.975)),
        fisher_ci = ct$conf.int), 3)
@
  \begin{itemize}
    \item Të dy intervalet janë të ngjashëm: me $n=200$, përafrimi i Fisher-it punon mirë.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Mbyllja e orës}
% ------------------------------------------------------------

\begin{frame}[label=cp34]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 4}
  \begin{enumerate}
    \item Kur preferohet Spearman-i ndaj Pearson-it?
    \item Shkruani statistikën $t$ për $H_0:\rho=0$ dhe shkallët e lirisë.
    \item Pse intervali i besimit ndërtohet në shkallën $z$ të Fisher-it?
  \end{enumerate}
  \shkoTe{zgjCp34}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje: Ora 4}
  \begin{itemize}
    \item Spearman = Pearson mbi rangjet; Kendall = $(C-D)/\binom n2$. Të dyja masin lidhjen monotone.
    \item $t=r\sqrt{n-2}/\sqrt{1-r^2}\sim t_{n-2}$ nën $H_0:\rho=0$.
    \item Fisher $z$: interval i besimit asimetrik; \Rkey{cor.test()} jep të gjitha.
    \item Rëndësia statistike $\neq$ forca e lidhjes; raporto $r$, intervalin, $n$.
  \end{itemize}
  \begin{Keshille}Ora 5: \texttt{cor.test()}, matricat me \texttt{corrplot} dhe \texttt{GGally}, krahasimet e shumëfishta.\end{Keshille}
\end{frame}
