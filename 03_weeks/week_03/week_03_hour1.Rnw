    \node[hr,fill=uptmid]  at (3,0) {Ora 4\\Rangjet,\\testet};
    \node[hr,fill=okgreen] at (4,0) {Ora 5\\Matrica,\\testet në R};
    \node[hr,fill=accent]  at (5,0) {Ora 6\\Boston,\\Simpson};
    \node[hr,fill=uptblue] at (6,0) {Ora 7\\Konsolidim};
  \end{tikzpicture}
\end{frame}

% ------------------------------------------------------------
\subsection{Rifreskim: kovarianca e popullatës}
% ------------------------------------------------------------

\begin{frame}{Kovarianca}
  \begin{Definicion}[(Kovarianca)]
    \[ \operatorname{Cov}(X,Y)=E\big[(X-\mu_X)(Y-\mu_Y)\big]=E[XY]-\mu_X\mu_Y \]
  \end{Definicion}
  \pause
  \begin{itemize}
    \item Pozitive: kur $X$ është mbi mesataren, edhe $Y$ priret të jetë mbi mesataren.
    \pause
    \item Njësitë: njësia e $X$ $\times$ njësia e $Y$ (p.sh.\ mijë \$ $\times$ mijë njësi). Prandaj vështirë të interpretohet.
  \end{itemize}
\end{frame}

\begin{frame}{Vetitë e kovariancës}
  \begin{Teoreme}[(Vetitë)]
    \begin{enumerate}
      \item $\operatorname{Cov}(X,X)=\operatorname{Var}(X)$.
      \item $\operatorname{Cov}(aX+b,\ cY+d)=ac\operatorname{Cov}(X,Y)$.
      \item $\operatorname{Var}(X\pm Y)=\operatorname{Var}(X)+\operatorname{Var}(Y)\pm2\operatorname{Cov}(X,Y)$.
    \end{enumerate}
  \end{Teoreme}
  \pause
  \begin{itemize}
    \item Vetia 2: zhvendosjet nuk ndikojnë, shkallëzimet po. Ndryshimi i njësive ndryshon kovariancën.
    \pause
    \item Vetia 3: baza e diversifikimit të portofolit dhe e variancës së shumave.
  \end{itemize}
\end{frame}

\begin{frame}{Korrelacioni i popullatës}
  \begin{Definicion}[(Korrelacioni)]
    \[ \rho_{XY}=\frac{\operatorname{Cov}(X,Y)}{\sigma_X\,\sigma_Y} \]
  \end{Definicion}
  \pause
  \begin{itemize}
    \item Pa njësi: pjesëtimi me $\sigma_X\sigma_Y$ heq njësitë.
    \pause
    \item $-1\le\rho\le1$ (e vërtetojmë në Orën 2).
    \pause
    \item $\rho=\pm1$: lidhje lineare perfekte, $Y=a+bX$.
  \end{itemize}
\end{frame}

\begin{frame}{Shembull pa ndihmën e PC}
  $X,Y\in\{0,1\}$ me $P(0,0)=0.4$, \ $P(0,1)=0.1$, \ $P(1,0)=0.1$, \ $P(1,1)=0.4$.
  \pause
  \begin{enumerate}
    \item $E[X]=P(X=1)=0.5$; \ $E[Y]=0.5$.
    \pause
    \item $E[XY]=P(1,1)=0.4$.
    \pause
    \item $\operatorname{Cov}=0.4-0.5\cdot0.5=0.15$.
    \pause
    \item $\operatorname{Var}(X)=0.5\cdot0.5=0.25$, \ $\sigma_X=\sigma_Y=0.5$; \ $\rho=0.15/0.25=0.6$.
  \end{enumerate}
\end{frame}

\begin{frame}{Pavarësia dhe korrelacioni zero}
  \begin{Teoreme}
    Nëse $X$ dhe $Y$ janë të pavarura, atëherë $\rho_{XY}=0$. E anasjella \textbf{nuk} vlen.
  \end{Teoreme}
  \pause
  \begin{Shembull}
    $X\sim U(-1,1)$, \ $Y=X^2$. \ $Y$ varet plotësisht nga $X$, por
    \[ \operatorname{Cov}(X,Y)=E[X^3]-E[X]\,E[X^2]=0-0=0. \]
  \end{Shembull}
  \pause
  \begin{itemize}
    \item Pse $E[X^3]=0$? Shpërndarja është simetrike rreth 0.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Kontrolli me simulim}
<<x2-cor>>=
set.seed(2026)
x <- runif(10000, -1, 1)
y <- x^2                       # y is a function of x
round(cor(x, y), 3)            # close to 0
round(cor(abs(x), y), 3)       # monotone on |x|: close to 1
@
  \begin{Gabim}``$r\approx0$, pra variablat janë të pavarura.'' Jo: $r$ mat vetëm lidhjen lineare.\end{Gabim}
\end{frame}

\begin{frame}{Normalja dydimensionale}
  \begin{columns}[c]
    \column{0.45\textwidth}
      \centering
      \begin{tikzpicture}[scale=0.85]
        \draw[->,gray] (-2,0)--(2,0) node[right,font=\tiny]{$x$};
        \draw[->,gray] (0,-2)--(0,2) node[above,font=\tiny]{$y$};
        \draw[uptmid,thick] (0,0) circle (1.2);
        \draw[accent,thick,rotate=45] (0,0) ellipse (1.7 and 0.55);
        \node[font=\tiny,text=uptmid] at (-1.4,1.3) {$\rho=0$};
        \node[font=\tiny,text=accent] at (1.6,1.6) {$\rho=0.8$};
      \end{tikzpicture}
    \column{0.53\textwidth}
      \begin{itemize}
        \item Parametrat: $\mu_X,\mu_Y,\sigma_X,\sigma_Y,\rho$.
        \item Konturet janë elipsa; $\rho$ i ngushton dhe i rrotullon.
        \item Vetëm këtu: $\rho=0\iff$ pavarësi.
      \end{itemize}
  \end{columns}
\end{frame}

\begin{frame}[label=ushVarSum]{Radha jote!}
  \begin{Ushtrim}[(pa ndihmën e PC, 4 minuta)]
    Kthimet e dy aksioneve kanë $\sigma_X=3\%$, \ $\sigma_Y=4\%$ dhe $\rho=0.5$.
    \begin{enumerate}
      \item Sa është $\operatorname{Cov}(X,Y)$?
      \item Sa janë $\operatorname{Var}(X+Y)$ dhe $\operatorname{Var}(X-Y)$?
      \item Si ndryshon $\operatorname{Var}(X+Y)$ nëse $\rho=-0.5$? Pse kjo quhet ``diversifikim''?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjVarSum}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Mbyllja e orës}
% ------------------------------------------------------------

\begin{frame}[label=cp31]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 1}
  \begin{enumerate}
    \item Çfarë mëson kuarteti i Anscombe-s?
    \item Pse $\rho=0$ nuk do të thotë pavarësi? Jepni një shembull.
    \item Pse korrelacioni interpretohet më lehtë se kovarianca?
  \end{enumerate}
  \shkoTe{zgjCp31}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje: Ora 1}
  \begin{itemize}
    \item Një lidhje ka drejtim, formë dhe forcë; $r$ mat vetëm lidhjen lineare.
    \item Anscombe: të njëjtat statistika, histori krejt të ndryshme. Shiko grafikun.
    \item $\operatorname{Cov}$ dhe $\rho$ e popullatës; vetitë; pavarësia $\Rightarrow\rho=0$, jo anasjelltas.
    \item Konventat e Cohen-it janë orientuese, jo ligj.
  \end{itemize}
  \begin{Keshille}Ora 2: kovarianca dhe korrelacioni i mostrës, me vetitë dhe kurthet.\end{Keshille}
\end{frame}
