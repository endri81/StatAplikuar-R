% ------------------------------------------------------------
\subsection{Ushtrime për shtëpi}
% ------------------------------------------------------------

\begin{frame}[label=h11H1]{Ushtrime për shtëpi 1--2}
  \begin{Ushtrim}[(Shtëpi 1: brezat sipas NUTS2)]
    Llogaritni sipërfaqen e çdo brezi lartësie (Ora 3) për secilin nga 3 rajonet NUTS2 (Ora 4). Paraqiteni si tabelë dhe si grafik me shtylla.
  \end{Ushtrim}
  \begin{Ushtrim}[(Shtëpi 2: janari)]
    Përsëritni modelin e Orës 6 për çdo muaj (12 modele). Vizatoni gradientin termik dhe koeficientin e \texttt{dcoast} sipas muajit. Interpretoni.
  \end{Ushtrim}
  \shkoTe{s11H1}{Udhëzime}
\end{frame}

\begin{frame}[label=h11H3]{Ushtrime për shtëpi 3--4}
  \begin{Ushtrim}[(Shtëpi 3: CV hapësinor)]
    Ndani qelizat e modelit të temperaturës në blloqe $20\times20$ km. Krahasoni RMSE nga CV me 10 grupe të rastësishme dhe nga CV me blloqe.
  \end{Ushtrim}
  \begin{Ushtrim}[(Shtëpi 4: thjeshtimi)]
    Llogaritni lartësinë mesatare të qarqeve me poligonet origjinale dhe me \texttt{st\_simplify(dTolerance = 5000)}. Sa ndryshon? Cili qark preket më shumë?
  \end{Ushtrim}
  \shkoTe{s11H3}{Udhëzime}
\end{frame}

\begin{frame}[label=h11H5]{Ushtrime për shtëpi 5--6}
  \begin{Ushtrim}[(Shtëpi 5: teori)]
    Tregoni që për një plan $z=ax+by+c$ formula e Horn-it dhe diferencat qendrore japin të njëjtën pjerrësi. Kur ndryshojnë?
  \end{Ushtrim}
  \begin{Ushtrim}[(Shtëpi 6: Zgjerim)]
    Përsëritni simulimin MAUP të Orës 5 me 200 përsëritje (\texttt{set.seed}). Vizatoni shpërndarjen e \texttt{cor\_xy} për $k=1,4,16$ dhe krahasojeni me formulën.
  \end{Ushtrim}
  \shkoTe{s11H5}{Udhëzime}
\end{frame}

% ------------------------------------------------------------
\subsection{Gabimet e javës}
% ------------------------------------------------------------

\begin{frame}{Gabimet e zakonshme: raster}
  \begin{Gabim}Numri i qelizave $\times$ \texttt{prod(res())} në raster gjeografik: gradë katrore, jo km$^2$. Përdorni \texttt{cellSize()}.\end{Gabim}
  \pause
  \begin{Gabim}Shuma e dendësive (intensive) në agregim ose statistika zonale. Kthejini së pari në numër.\end{Gabim}
  \pause
  \begin{Gabim}Ripërzgjedhje \texttt{bilinear} për klasa; \texttt{shade()} me gradë në vend të radianëve.\end{Gabim}
\end{frame}

\begin{frame}{Gabimet e zakonshme: vektor dhe statistikë}
  \begin{Gabim}\texttt{merge()} sipas emrave me ë/ç: rreshta të humbur pa paralajmërim. Kontrolloni \texttt{nrow()} dhe \texttt{setdiff()}.\end{Gabim}
  \pause
  \begin{Gabim}Analiza mbi poligone të thjeshtuara: mbivendosje dhe boshllëqe.\end{Gabim}
  \pause
  \begin{Gabim}Vlera $p$ nga \texttt{lm()} mbi mijëra qeliza të autokorreluara; korrelacioni i rajoneve i interpretuar për individët.\end{Gabim}
\end{frame}

\begin{frame}{Lista e kontrollit për raster}
  \begin{enumerate}
    \item<1-> \texttt{crs(r)}, \texttt{res(r)}, \texttt{ext(r)}: gradë apo metra?
    \item<2-> \texttt{datatype}, NA, diapazoni (\texttt{global(r, range)}): ka vlera të pamundura?
    \item<3-> Sasia është intensive apo ekstensive?
    \item<4-> Para algjebrës me dy raster-a: \texttt{compareGeom()}.
    \item<5-> Para statistikave zonale: sa qeliza ka zona? Duhen pesha mbulimi?
    \item<6-> Hartë: burimi, viti, ``e modeluar'' nëse është, CRS.
  \end{enumerate}
\end{frame}

% ------------------------------------------------------------
\subsection{Fletë-kujtesa}
% ------------------------------------------------------------

\begin{frame}{Fletë-kujtesa 1: formulat}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    Koncepti & Formula \\ \midrule
    Indeksimi & $j=\lfloor(x-x_{\min})/r_x\rfloor+1$, $i=\lfloor(y_{\max}-y)/r_y\rfloor+1$, $c=(i-1)n_c+j$ \\
    Qendra & $x=x_{\min}+(j-\frac12)r_x$, $y=y_{\max}-(i-\frac12)r_y$ \\
    Zonale e saktë & $\sum c_iv_i$ (ekstensive), $\sum c_iv_i/\sum c_i$ (intensive) \\
    Bilinear & $\sum w_kf_k$, $w=(1-u)(1-v),u(1-v),(1-u)v,uv$ \\
    Pjerrësia & $\theta=\arctan\sqrt{z_x^2+z_y^2}$, $z_x=(z_L-z_P)/2\Delta$ \\
    Hija & $H=\sin\alpha\cos\theta+\cos\alpha\sin\theta\cos(\phi-\psi)$ \\
    MAUP & $\rho_k\approx\operatorname{Var}S_k/(\operatorname{Var}S_k+\sigma^2/k^2)$ \\ \bottomrule
  \end{tabular}
\end{frame}

\begin{frame}{Fletë-kujtesa 2: \texttt{terra}}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    Detyra & Funksioni \\ \midrule
    Lexo / shkruaj & \texttt{rast()}, \texttt{vect()}, \texttt{writeRaster(datatype=)} \\
    Gjeometria & \texttt{ext}, \texttt{res}, \texttt{crs}, \texttt{cellSize}, \texttt{compareGeom} \\
    Prit / maskë & \texttt{crop}, \texttt{mask}, \texttt{classify}, \texttt{ifel} \\
    Algjebra & \texttt{+ - * /}, \texttt{app}, \texttt{focal}, \texttt{zonal}, \texttt{global} \\
    Vektor $\leftrightarrow$ raster & \texttt{rasterize(touches=)}, \texttt{as.polygons}, \texttt{extract} \\
    Rrjeta & \texttt{aggregate}, \texttt{resample}, \texttt{project(method=)} \\
    Terreni & \texttt{terrain("slope"/"aspect", unit=)}, \texttt{shade()} \\
    Distanca & \texttt{distance(raster, vektor)}, \texttt{init(r, "y")} \\ \bottomrule
  \end{tabular}
\end{frame}

\begin{frame}{Fletë-kujtesa 3: cilën metodë kur}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    Situata & Zgjedhja \\ \midrule
    Fushë e vazhdueshme në rrjetë të re & \texttt{bilinear} (ose \texttt{cubic}) \\
    Klasa / kategori & \texttt{near}; agregim me \texttt{modal} \\
    Banorë në rrjetë më të trashë & numër për qelizë, pastaj \texttt{sum} \\
    Zona të vogla / bregdetare & \texttt{exactextractr} (pesha mbulimi) \\
    Pjerrësi, buffer, distanca & CRS i projektuar (6870) \\
    Ruajtje vektori & GeoPackage, jo shapefile \\ \bottomrule
  \end{tabular}
\end{frame}

% ------------------------------------------------------------
\subsection{Pamje e Javës 12}
% ------------------------------------------------------------

\begin{frame}{Java 12: interpolimi hapësinor dhe Kriging \LO{K3, C1}}
  \begin{itemize}
    \item<1-> Pyetja: matëm në pika (\texttt{meuse}, stacione); si e ndërtojmë raster-in e vazhdueshëm?
    \item<2-> Poligonet Thiessen/Voronoi, polinomi global, IDW.
    \item<3-> Variogrami: sa shpejt bie korrelacioni me distancën (ideja e $r_{nn}$ dhe e 0.957).
    \item<4-> Kriging: parashikuesi linear më i mirë i paanshëm, me gabim standard për çdo qelizë.
    \item<5-> Projekti final dhe prezantimet.
  \end{itemize}
\end{frame}

\begin{frame}{Para Javës 12}
  \begin{itemize}
    \item Kontrolloni: \texttt{library(gstat); library(sf); library(terra)}.
    \item Përsëritni: \texttt{meuse} (Java 10, Ora 6), regresi dhe mbetjet (Javët 5--7), \texttt{rasterize}, \texttt{extract}.
    \item Ushtrimi i shtëpisë 3 (CV hapësinor) do të përdoret për validimin e Kriging-ut.
  \end{itemize}
\end{frame}

\begin{frame}{Burime}
  \footnotesize
  \begin{itemize}
    \item K.-T.~Chang, \emph{Introduction to Geographic Information Systems}, McGraw-Hill, 2012 (modelet raster/vektor, DEM, analiza e terrenit).
    \item E.~Pebesma, R.~Bivand, \emph{Spatial Data Science: With Applications in R}, CRC, 2023.
    \item R.~Lovelace, J.~Nowosad, J.~Muenchow, \emph{Geocomputation with R}, 2nd ed., CRC.
    \item R.~J.~Hijmans, \texttt{terra} dhe \texttt{geodata} (dokumentacioni i paketave); D.~Baston, \texttt{exactextractr}.
    \item B.~K.~P.~Horn (1981), \emph{Hill shading and the reflectance map}, Proc.\ IEEE; C.~D.~Tomlin (1990), \emph{Geographic Information Systems and Cartographic Modeling}.
    \item Të dhënat: GADM 4.1; SRTM (CGIAR-CSI v4.1); WorldClim 2.1 (Fick \& Hijmans 2017); GPW v4 rev11 (CIESIN); INSTAT (NUTS, VKM 1037/2010; Censi 2023); Natural Earth.
    \item Repo DS612 nuk mbulon të dhënat hapësinore: e gjithë java është \textbf{material plotësues}.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Mbyllja e ditës}
% ------------------------------------------------------------

\begin{frame}[label=cp117]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 7}
  \begin{enumerate}
    \item Cilat janë tre kontrollet e para kur merrni një raster të ri?
    \item Pse rregulli i qendrës gabon më shumë për zona të vogla?
    \item Si lidhet autokorrelacioni i mbetjeve me Kriging-un?
  \end{enumerate}
  \shkoTe{zgjCp117}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje e Javës 11}
  \begin{itemize}
    \item Vektor (objekte) dhe raster (fusha); qelizat në gradë kanë sipërfaqe të ndryshme.
    \item Algjebra: lokale, fokale, zonale, globale; intensive $\to$ \texttt{mean}, ekstensive $\to$ \texttt{sum}.
    \item Shqipëria: 28.9\% mbi 1000 m; Korça qarku më malor; Fieri 0\%.
    \item Bashkimet sipas emrave me ë/ç humbin rreshta; statistikat zonale kërkojnë pesha mbulimi (Durrësi $+19\%$).
    \item DTM: pjerrësia, hija, profili; korriku $-0.60^\circ$C/100 m; mbetjet të autokorreluara (0.957).
  \end{itemize}
  \LO{K2, K3, S1, S3, S4, C1}
\end{frame}
