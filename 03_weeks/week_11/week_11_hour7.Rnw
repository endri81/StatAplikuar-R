% ------------------------------------------------------------
\subsection{Kuizi në stilin e provimit}
% ------------------------------------------------------------

\begin{frame}{Kuizi: si funksionon}
  \begin{itemize}
    \item<1-> Si në provim: \textbf{25\% teori, 75\% ushtrime}; 3 pyetje teorike (25 pikë) + 7 ushtrime (75 pikë).
    \item<2-> Koha: 45 minuta. Ushtrimet 1--5 bëhen pa ndihmën e PC.
    \item<3-> Vlera të dobishme: $\sin45^\circ=\cos45^\circ=0.7071$; $\arctan1=45^\circ$; $\arctan0.5=26.57^\circ$.
  \end{itemize}
  \onslide<4->{\begin{Keshille}Për çdo raster: shkruani rezolucionin dhe njësinë e qelizës (gradë apo metra).\end{Keshille}}
\end{frame}

\begin{frame}[label=q11T1]{Teori 1 (8 pikë)}
  \begin{Ushtrim}[(Teori 1)]
    \begin{enumerate}
      \item Dalloni modelin vektor nga raster-i. Jepni nga dy shembuj për secilin.
      \item Çfarë janë sasitë intensive dhe ekstensive? Si ndikojnë në agregim dhe në statistikat zonale?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s11T1}{Zgjidhja}
\end{frame}

\begin{frame}[label=q11T2]{Teori 2 (8 pikë)}
  \begin{Ushtrim}[(Teori 2)]
    \begin{enumerate}
      \item Emërtoni katër familjet e algjebrës së hartave me nga një shembull.
      \item Krahasoni rregullin e qendrës, \texttt{touches = TRUE} dhe peshat e mbulimit në statistikat zonale.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s11T2}{Zgjidhja}
\end{frame}

\begin{frame}[label=q11T3]{Teori 3 (9 pikë)}
  \begin{Ushtrim}[(Teori 3)]
    \begin{enumerate}
      \item Çfarë është MAUP? Shpjegoni efektin e shkallës me një formulë.
      \item Kur përdorni ripërzgjedhjen \texttt{near} dhe kur \texttt{bilinear}?
      \item Pse autokorrelacioni hapësinor i mbetjeve i bën vlerat $p$ të \texttt{lm()} të pabesueshme?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s11T3}{Zgjidhja}
\end{frame}

\begin{frame}[label=q11E1]{Ushtrimi 1 (10 pikë): indeksimi}
  \begin{Ushtrim}[(Ushtrimi 1, pa ndihmën e PC)]
    Raster: $x_{\min}=19$, $x_{\max}=21.5$, $y_{\min}=42$, $y_{\max}=43$, $n_c=10$, $n_r=4$.
    \begin{enumerate}
      \item Rezolucioni në $x$ dhe $y$?
      \item Rreshti, kolona dhe numri i qelizës për pikën $(20.3, 42.6)$.
      \item Koordinatat e qendrës së asaj qelize.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s11E1}{Zgjidhja}
\end{frame}

\begin{frame}[label=q11E2]{Ushtrimi 2 (10 pikë): algjebra}
  \begin{Ushtrim}[(Ushtrimi 2, pa ndihmën e PC)]
    \begin{center}
      \begin{tabular}{ccc} 2 & 4 & 6 \\ 8 & 10 & 12 \\ 14 & 16 & 18 \end{tabular}
    \end{center}
    \begin{enumerate}
      \item Rezultati i \texttt{(r - 10) / 2} (lokale).
      \item \texttt{focal(r, 3, mean, na.rm = TRUE)} në qendër dhe në cepin lart-majtas.
      \item \texttt{aggregate} nuk mund të zbatohet me \texttt{fact = 2} pa humbje. Pse?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s11E2}{Zgjidhja}
\end{frame}

\begin{frame}[label=q11E3]{Ushtrimi 3 (10 pikë): klasifikimi}
  \begin{Ushtrim}[(Ushtrimi 3, pa ndihmën e PC)]
    Lartësi në m, qeliza 1 km$^2$ (CRS i projektuar):
    \begin{center}\small
      \begin{tabular}{cccc} 150 & 900 & 1000 & 1200 \\ 300 & 1001 & 1450 & 1600 \\ 80 & 500 & 999 & 2100 \\ 40 & 250 & 700 & 1500 \end{tabular}
    \end{center}
    Brezat $(-\infty,500]\to1$, $(500,1000]\to2$, $(1000,1500]\to3$, $(1500,\infty)\to4$.
    \begin{enumerate}
      \item Numri i qelizave në çdo brez. \quad 2. Sipërfaqja mbi 1000 m (km$^2$ dhe \%).
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s11E3}{Zgjidhja}
\end{frame}

\begin{frame}[label=q11E4]{Ushtrimi 4 (10 pikë): popullsia zonale}
  \begin{Ushtrim}[(Ushtrimi 4, pa ndihmën e PC)]
    Tri qeliza 16 km$^2$ me dendësi 50, 200 dhe 1000 banorë/km$^2$. Mbulimi nga zona: 1, 0.5, 0.25. Qendrat e dy të parave janë brenda zonës.
    \begin{enumerate}
      \item Banorët me peshat e mbulimit.
      \item Banorët me rregullin e qendrës. Sa \% gabon?
      \item Pse \texttt{sum} mbi dendësitë është i gabuar?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s11E4}{Zgjidhja}
\end{frame}

\begin{frame}[label=q11E5]{Ushtrimi 5 (10 pikë): terreni}
  \begin{Ushtrim}[(Ushtrimi 5, pa ndihmën e PC)]
    Qeliza 30 m. Fqinjët: $z_L=260$, $z_P=200$, $z_V=230$, $z_J=230$.
    \begin{enumerate}
      \item Pjerrësia (gradë) dhe ekspozicioni.
      \item Hija me $\alpha=45^\circ$, $\phi=315^\circ$.
      \item A del ky shpat i ndriçuar apo i errët në hartë? Pse?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s11E5}{Zgjidhja}
\end{frame}

\begin{frame}[label=q11E6]{Ushtrimi 6 (10 pikë): lexo output-in}
  \begin{Ushtrim}[(Ushtrimi 6)]
    \small
    Modeli i korrikut (Ora 6): $\hat T=42.323-0.006021\,\text{elev}-0.003807\,\text{north}-0.000598\,\text{dcoast}$; $R^2=0.985$; korrelacioni i mbetjeve me fqinjët 0.957.
    \begin{enumerate}
      \item Interpretoni çdo koeficient me njësi (elev në m, north dhe dcoast në km).
      \item Parashikoni $T$ për elev $=1000$ m, north $=4600$ km, dcoast $=50$ km.
      \item A mund të themi që dcoast ``ka efekt domethënës''? Arsyetoni.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s11E6}{Zgjidhja}
\end{frame}

\begin{frame}[label=q11E7]{Ushtrimi 7 (15 pikë): projekt i vogël}
  \begin{Ushtrim}[(Ushtrimi 7)]
    \small
    Keni: shapefile i 61 bashkive (EPSG:4326, emra me ë/ç), DEM $30''$, GPW 2020 ($2.5'$) dhe tabelën e censit 2023 sipas bashkive (CSV, emra me ë/ç).
    \begin{enumerate}
      \item Hapat për: sipërfaqen mbi 1500 m dhe banorët e modeluar (GPW) për bashki.
      \item Si e krahasoni GPW me censin për çdo bashki?
      \item Tri gabime që mund të ndodhin dhe si i parandaloni.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s11E7}{Zgjidhja}
\end{frame}

