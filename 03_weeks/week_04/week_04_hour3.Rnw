  \end{Ushtrim}
  \shkoTe{zgjGabNum}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=ushEta]{Radha jote!}
  \begin{Ushtrim}[(5 minuta)]
    Shkruaj \texttt{effect\_sizes(tab)} që merr daljen e \texttt{my\_anova()} dhe kthen $\eta^2$ dhe $\omega^2$.
    \begin{enumerate}
      \item Provoje te të dhënat e vogla: duhet të marrësh 0.66 dhe 0.52.
