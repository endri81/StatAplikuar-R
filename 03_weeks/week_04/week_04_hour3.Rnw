% ------------------------------------------------------------
\subsection{Shpërndarja $F$ me simulim}
% ------------------------------------------------------------

\begin{frame}{Ideja}
  \begin{itemize}
    \item<1-> Teorema e Cochran-it thotë: nën $H_0$, $F\sim F_{k-1,N-k}$.
    \item<2-> Le ta kontrollojmë: gjenerojmë shumë herë të dhëna me $\mu_1=\mu_2=\mu_3$.
    \item<3-> Për çdo përsëritje llogaritim $F$. Histogrami duhet të përputhet me \texttt{df()}.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Simulimi nën $H_0$}
<<sim-h0>>=
f_stat <- function(y, g) {                      # fast F, no table
  ybar_i <- tapply(y, g, mean); n_i <- tabulate(g)
  ssb <- sum(n_i * (ybar_i - mean(y))^2); ssw <- sum((y - ybar_i[g])^2)
  (ssb / (nlevels(g) - 1)) / (ssw / (length(y) - nlevels(g)))
}
set.seed(4)
g3 <- gl(3, 10)                                 # k = 3, n_i = 10, N = 30
F_null <- replicate(5000, f_stat(rnorm(30, mean = 50, sd = 5), g3))
c(mean = mean(F_null), theory_mean = 27 / (27 - 2))
@
  \footnotesize\textcolor{gray}{Të dhëna: sintetike ($\mu=50$, $\sigma=5$ për të tri grupet).}
\end{frame}

\begin{frame}[fragile]{Histogrami kundrejt teorisë}
<<sim-h0-plot, fig.height=2.5, fig.width=5.5, out.width="0.6\\textwidth">>=
hist(F_null, breaks = 60, freq = FALSE, col = "grey85", border = "white",
     main = "", xlab = "F", xlim = c(0, 8))
curve(df(x, 2, 27), add = TRUE, col = "#D97706", lwd = 2)
abline(v = qf(0.95, 2, 27), lty = 2, col = "#B91C1C")
@
\end{frame}

\begin{frame}[fragile]{Madhësia e testit}
<<sim-size>>=
crit <- qf(0.95, 2, 27)
c(critical = crit, share_above = mean(F_null > crit))
@
  \begin{itemize}
    \item<2-> Rreth 5\% e $F$-ve kalojnë vlerën kritike: testi ka madhësinë që premton.
    \item<3-> Mesatarja e $F_{d_1,d_2}$ është $d_2/(d_2-2)=27/25=1.08$, jo saktësisht 1.
  \end{itemize}
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Kurba portokalli (\texttt{df(x, 2, 27)}) puthitet me histogramin.
    \item<2-> Vija e kuqe: $F_{0.95;\,2,27}=\Sexpr{fmt(qf(0.95, 2, 27), 2)}$. Djathtas saj: zona e hedhjes poshtë.
    \item<3-> Kjo vlen kur supozimet plotësohen. Në Orën 5 shohim çfarë ndodh kur nuk plotësohen.
  \end{itemize}
\end{frame}

\begin{frame}[label=ushNk]{Ndrysho parametrin dhe shiko}
  \begin{Ushtrim}[(5 minuta)]
    \begin{enumerate}
      \item Ndrysho në \texttt{g3 <- gl(5, 4)} ($k=5$, $N=20$). Cilat df duhet të përdorë \texttt{curve()}?
      \item Ndrysho \texttt{sd = 5} në \texttt{sd = 50}. A ndryshon shpërndarja e $F$? Pse?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjNk}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Fuqia e testit}
% ------------------------------------------------------------

\begin{frame}{Fuqia}
  \begin{itemize}
    \item<1-> \termi{Fuqia}{power}: $P(\text{hedhim poshtë } H_0 \mid H_1 \text{ e vërtetë})=1-\beta$.
    \item<2-> Nën $H_1$, $F$ ndjek \termi{shpërndarjen $F$ jo-qendrore}{noncentral F} me parametër
      \[ \lambda=\frac{\sum_i n_i\alpha_i^2}{\sigma^2}. \]
    \item<3-> Fuqia rritet kur rritet $\lambda$: efekte më të mëdha, $n$ më i madh, $\sigma$ më i vogël.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Simulim: fuqia për një efekt të njohur}
<<power-sim>>=
mu <- c(10, 12, 14); sigma <- 4; n <- 10           # truth
g  <- gl(3, n)
set.seed(44)
F_alt <- replicate(4000, f_stat(rep(mu, each = n) + rnorm(3 * n, 0, sigma), g))
power_sim <- mean(F_alt > qf(0.95, 2, 3 * n - 3))
lambda <- n * sum((mu - mean(mu))^2) / sigma^2
power_th <- pf(qf(0.95, 2, 3 * n - 3), 2, 3 * n - 3, ncp = lambda, lower.tail = FALSE)
c(simulated = power_sim, theory = power_th, lambda = lambda)
@
  \footnotesize\textcolor{gray}{Të dhëna: sintetike (mesataret 10, 12, 14; $\sigma=4$; $n_i=10$).}
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Me $n_i=10$, testi e ``gjen'' efektin vetëm në rreth \Sexpr{fmt(100 * power_sim, 0)}\% të rasteve.
    \item<2-> Simulimi dhe formula me \texttt{ncp} pajtohen.
    \item<3-> Kujto Orën 1: paneli djathtas ($\sigma=4$) dukej si zhurmë. Tani e dimë sa shpesh.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Kurba e fuqisë sipas $n_i$}
<<power-curve, fig.height=2.4, fig.width=5.5, out.width="0.58\\textwidth">>=
n_grid <- c(5, 10, 15, 20, 30, 40)
pw <- sapply(n_grid, function(n) power.anova.test(groups = 3, n = n,
       between.var = var(mu), within.var = sigma^2)$power)
plot(n_grid, pw, type = "b", pch = 19, ylim = c(0, 1),
     xlab = "n per group", ylab = "power"); abline(h = 0.8, lty = 2)
@
\end{frame}

\begin{frame}[fragile]{Sa vëzhgime duhen?}
<<power-n>>=
power.anova.test(groups = 3, between.var = var(mu), within.var = sigma^2,
                 power = 0.80)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> \texttt{between.var}: varianca e \textbf{mesatareve} të vërteta (\texttt{var(mu)} $=4$); \texttt{within.var} $=\sigma^2=16$.
    \item<2-> Për fuqi 80\% duhen $n_i=21$ (rrumbullakojmë lart): 63 vëzhgime gjithsej.
    \item<3-> Kjo bëhet \textbf{para} mbledhjes së të dhënave: planifikimi i një vrojtimi ose eksperimenti.
  \end{itemize}
  \onslide<4->{\begin{Gabim}``Fuqia post-hoc'': llogaritja e fuqisë nga efekti i \emph{vëzhguar} pas testit. Nuk jep informacion të ri përtej vlerës $p$.\end{Gabim}}
\end{frame}

\begin{frame}[label=ushPowN]{Radha jote!}
  \begin{Ushtrim}[(4 minuta)]
    Një inxhinier pret mesatare $10$, $11$, $13$ (MPa) për tre furnitorë betoni, me $\sigma=3$.
    \begin{enumerate}
      \item Sa kampione për furnitor duhen për fuqi 90\%?
      \item Po për fuqi 80\%?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjPowN}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[fragile]{Vlerësimi kundrejt së vërtetës}
<<est-truth>>=
set.seed(2026)
n <- 50; g <- gl(3, n, labels = c("A", "B", "C"))
y_sim <- rep(mu, each = n) + rnorm(3 * n, 0, sigma)
tab <- my_anova(y_sim, g)
rbind(estimate = c(tapply(y_sim, g, mean) - mean(y_sim), sigma2 = tab$MS[2]),
      truth    = c(mu - mean(mu), sigma2 = sigma^2))
@
  \footnotesize\textcolor{gray}{Të dhëna: sintetike ($\alpha=(-2,0,2)$, $\sigma^2=16$, $n_i=50$).}
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> $\hat\alpha_i=\bar y_{i\cdot}-\bar y_{\cdot\cdot}$ ndryshojnë nga $(-2,0,2)$ me më pak se 1.5 gabime standarde (shiko pikën 3): luhatje e zakonshme.
    \item<2-> MSW është afër $\sigma^2=16$: vlerësues i pazhvendosur, siç vërtetuam.
    \item<3-> Me $n_i=50$, gabimi standard i çdo $\bar y_{i\cdot}$ është $4/\sqrt{50}\approx0.57$; ai i $\hat\alpha_i$ është $0.57\sqrt{2/3}\approx0.46$.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Mbyllja e orës}
% ------------------------------------------------------------

\begin{frame}[label=cp43]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 3}
  \begin{enumerate}
    \item Çfarë ndodh nëse faktori ruhet si numër te \texttt{aov()}?
    \item Si e kontrollon me simulim që testi $F$ ka madhësi 5\%?
    \item Cilat tre gjëra e rrisin fuqinë e testit?
  \end{enumerate}
  \shkoTe{zgjCp43}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje: Ora 3}
  \begin{itemize}
    \item \texttt{my\_anova()}: SSB, SSW, df, MS, $F$, $p$ në 10 rreshta; e njëjtë me \Rkey{aov()} dhe \Rkey{anova(lm())}.
    \item Nga $n_i$, $\bar y_i$, $s_i$ ndërtohet testi pa të dhënat individuale.
    \item Faktori duhet të jetë \Rkey{factor()}: përndryshe $df=1$.
    \item Simulimi konfirmon $F_{k-1,N-k}$; fuqia: \Rkey{pf(..., ncp = )}, \Rkey{power.anova.test()}.
  \end{itemize}
  \begin{Keshille}Ora 4: supozimet, alternativat (Welch, Kruskal--Wallis) dhe krahasimet e shumëfishta (Tukey).\end{Keshille}
\end{frame}
