% ------------------------------------------------------------
\subsection{Funksioni \texttt{my\_anova()}}
% ------------------------------------------------------------

\begin{frame}{Plani i laboratorit \LO{S4}}
  \begin{enumerate}
    \item<1-> Mesataret dhe madhësitë e grupeve.
    \item<2-> SSB, SSW, SST: kontrolli i zbërthimit.
    \item<3-> Funksioni \texttt{my\_anova()}: tabela e plotë.
    \item<4-> Krahasimi me \texttt{aov()} dhe \texttt{lm()}.
    \item<5-> Simulimi: shpërndarja $F$ nën $H_0$ dhe fuqia e testit.
  \end{enumerate}
\end{frame}

\begin{frame}[fragile]{Hapi 1: mesataret e grupeve}
<<lab-means>>=
y <- c(3, 5, 7,  7, 8, 9,  8, 11, 14)          # toy data from Hour 2
g <- factor(rep(c("A", "B", "C"), each = 3))
n_i    <- tapply(y, g, length)                  # group sizes
ybar_i <- tapply(y, g, mean)                    # group means
ybar   <- mean(y)                               # grand mean
rbind(n_i, ybar_i); ybar
@
\end{frame}

\begin{frame}[fragile]{Hapi 2: SSB}
<<lab-ssb>>=
ssb <- sum(n_i * (ybar_i - ybar)^2)    # weights n_i!
ssb
@
  \begin{itemize}
    \item \texttt{n\_i * (ybar\_i - ybar)\^{}2}: vektor me 3 elemente, një për çdo grup.
    \item E njëjta si $3\cdot9+0+3\cdot9=54$.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Hapi 3: SSW}
<<lab-ssw>>=
fit_i <- ybar_i[as.character(g)]      # each observation's group mean
e_ij  <- y - fit_i                     # within-group deviations
ssw <- sum(e_ij^2)
ssw
round(unname(e_ij), 2)
@
\end{frame}

\begin{frame}[fragile]{Hapi 4: SST dhe kontrolli}
<<lab-sst>>=
sst <- sum((y - ybar)^2)
c(SST = sst, SSB_plus_SSW = ssb + ssw)
all.equal(sst, ssb + ssw)
sum((fit_i - ybar) * e_ij)                 # orthogonality: cross term
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Zbërthimi vlen numerikisht: $82=54+28$.
    \item<2-> \texttt{fit\_i}: vlera e ``parashikuar'' e çdo vëzhgimi = mesatarja e grupit të tij.
    \item<3-> Prodhimi skalar i devijimeve ``midis'' me mbetjet = 0: termi i kryqëzuar i Orës 2.
  \end{itemize}
  \onslide<4->{\begin{Keshille}\texttt{all.equal()} në vend të \texttt{==} për numra realë: gabimet e rrumbullakimit janë të pashmangshme.\end{Keshille}}
\end{frame}

\begin{frame}[fragile]{Hapi 5: funksioni}
<<lab-fun>>=
my_anova <- function(y, g) {
  g <- factor(g); k <- nlevels(g); N <- length(y)
  n_i <- tapply(y, g, length); ybar_i <- tapply(y, g, mean)
  ssb <- sum(n_i * (ybar_i - mean(y))^2)
  ssw <- sum((y - ybar_i[as.character(g)])^2)
  df  <- c(k - 1, N - k); ss <- c(ssb, ssw); ms <- ss / df
  F   <- ms[1] / ms[2]
  data.frame(df = df, SS = ss, MS = ms,
             F = c(F, NA), p = c(pf(F, df[1], df[2], lower.tail = FALSE), NA),
             row.names = c("Between", "Within"))
}
@
\end{frame}

\begin{frame}[fragile]{Prova e parë}
<<lab-fun-run>>=
my_anova(y, g)
@
  \begin{itemize}
    \item<2-> Krahaso me tabelën që ndërtuam pa ndihmën e PC: $F=5.79$, $p\approx0.04$.
  \end{itemize}
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> \texttt{factor(g)} brenda funksionit: funksionon edhe kur \texttt{g} jepet si tekst.
    \item<2-> \texttt{pf(..., lower.tail = FALSE)}: bishti i djathtë, $P(F_{k-1,N-k}>F_{\text{obs}})$.
    \item<3-> 10 rreshta kod $=$ e gjithë teoria e Orës 2.
  \end{itemize}
\end{frame}

\begin{frame}[label=pyetjePredF]{Parashiko!}
  \begin{Parashiko}
    Para se ta ekzekutosh \texttt{my\_anova(auto\$mpg, auto\$origin)}:
    \begin{enumerate}
      \item Sa do të jenë shkallët e lirisë? ($N=397$, $k=3$.)
      \item A pret $F$ afër 1, afër 10, apo shumë më të madh? Pse?
    \end{enumerate}
  \end{Parashiko}
  \shkoTe{zgjPredF}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[fragile]{\texttt{my\_anova()} kundrejt \texttt{aov()}}
<<lab-auto>>=
auto <- read.csv(file.path(W04DATA, "Auto.csv"), na.strings = "?")
auto$origin <- factor(auto$origin, labels = c("USA", "Europe", "Japan"))
my_anova(auto$mpg, auto$origin)
summary(aov(mpg ~ origin, data = auto))
@
\end{frame}

\begin{frame}[fragile]{Rruga e tretë: \texttt{lm()}}
<<lab-lm>>=
fit_lm <- lm(mpg ~ origin, data = auto)
anova(fit_lm)
coef(fit_lm)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Tre rrugë, e njëjta tabelë: \texttt{aov()} është një mbështjellës (\emph{wrapper}) i \texttt{lm()}.
    \item<2-> Koeficientët e \texttt{lm()}: \texttt{(Intercept)} = mesatarja e SHBA; të tjerët = \textbf{dallimet} nga SHBA.
    \item<3-> $20.07+7.82=27.89$ (Evropa), $20.07+10.38=30.45$ (Japonia). Kodimi me dummy: Java 6.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{ANOVA nga tabelat e përmbledhura}
<<lab-summary>>=
anova_from_summary <- function(n, m, s) {
  N <- sum(n); k <- length(n); grand <- sum(n * m) / N
  ssb <- sum(n * (m - grand)^2); ssw <- sum((n - 1) * s^2)
  F <- (ssb / (k - 1)) / (ssw / (N - k))
  c(F = F, df1 = k - 1, df2 = N - k, p = pf(F, k - 1, N - k, lower.tail = FALSE))
}
n <- tapply(auto$mpg, auto$origin, length)
m <- tapply(auto$mpg, auto$origin, mean); s <- tapply(auto$mpg, auto$origin, sd)
anova_from_summary(n, m, s)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Vetëm $n_i$, $\bar y_i$, $s_i$ mjaftojnë për testin $F$.
    \item<2-> Shumë raporte zyrtare (INSTAT, Eurostat) publikojnë pikërisht këto tre kolona sipas grupeve.
    \item<3-> Kujdes: pa të dhënat individuale nuk mund të kontrollosh supozimet (Ora 4).
  \end{itemize}
\end{frame}

\begin{frame}[fragile,label=gjejGabNum]{Gjej gabimin!}
<<lab-bug>>=
auto_raw <- read.csv(file.path(W04DATA, "Auto.csv"), na.strings = "?")
summary(aov(mpg ~ origin, data = auto_raw))
