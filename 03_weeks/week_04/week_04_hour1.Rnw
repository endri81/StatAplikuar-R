% ------------------------------------------------------------
\subsection{Rifreskim: testi $t$ për dy grupe}
% ------------------------------------------------------------

\begin{frame}{Testi $t$ me varianca të barabarta}
  \begin{itemize}
    \item<1-> $H_0:\mu_1=\mu_2$ kundrejt $H_1:\mu_1\ne\mu_2$.
    \item<2-> Varianca e përbashkët (\emph{pooled}): $s_p^2=\dfrac{(n_1-1)s_1^2+(n_2-1)s_2^2}{n_1+n_2-2}$.
    \item<3-> Statistika: $t=\dfrac{\bar y_1-\bar y_2}{s_p\sqrt{1/n_1+1/n_2}}$, \quad $df=n_1+n_2-2$.
    \item<4-> Numëruesi: \textbf{sinjali}. Emëruesi: \textbf{zhurma}.
  \end{itemize}
\end{frame}

\begin{frame}{Shembull pa ndihmën e PC}
  Grupi A: $(2,4,6)$. \quad Grupi B: $(5,7,9)$.
  \pause
  \begin{enumerate}
    \item $\bar y_A=4$, $\bar y_B=7$.
    \pause
    \item $s_A^2=\frac{4+0+4}{2}=4$, \ $s_B^2=4$ $\Rightarrow s_p^2=4$, $s_p=2$.
    \pause
    \item $t=\dfrac{4-7}{2\sqrt{1/3+1/3}}=\dfrac{-3}{1.633}\approx-1.84$, \ $df=4$.
    \pause
    \item $t_{0.975;\,4}=2.776$: $|t|<2.776$, nuk e hedhim poshtë $H_0$.
  \end{enumerate}
  \pause
  \begin{Keshille}Mbaje mend $t^2\approx3.375$. Do ta takojmë sërish pas pak.\end{Keshille}
\end{frame}

\begin{frame}[fragile]{Kontrolli me R}
<<toy-t>>=
A <- c(2, 4, 6); B <- c(5, 7, 9)
tt <- t.test(A, B, var.equal = TRUE)
c(t = unname(tt$statistic), df = unname(tt$parameter), p = tt$p.value)
unname(tt$statistic)^2
@
\end{frame}

\begin{frame}{Shpërndarja $F$}
  \begin{Definicion}[(Shpërndarja $F$)]
    Nëse $U\sim\chi^2_{d_1}$ dhe $V\sim\chi^2_{d_2}$ janë të pavarura, atëherë
    \[ F=\frac{U/d_1}{V/d_2}\sim F_{d_1,\,d_2}. \]
  \end{Definicion}
  \pause
  \begin{itemize}
    \item Raport i dy variancave të vlerësuara: gjithmonë $F\ge0$.
    \pause
    \item Nëse $T\sim t_{d}$, atëherë $T^2\sim F_{1,\,d}$.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Si duket $F$?}
<<f-curves, fig.height=2.5, fig.width=5.5, out.width="0.56\\textwidth">>=
x <- seq(0, 5, length.out = 400)
dfs <- list(c(1, 4), c(2, 12), c(5, 30), c(2, 394))
plot(NA, xlim = c(0, 5), ylim = c(0, 1.2), xlab = "F", ylab = "density")
for (i in seq_along(dfs)) lines(x, df(x, dfs[[i]][1], dfs[[i]][2]), col = i, lwd = 2)
legend("topright", legend = sapply(dfs, paste, collapse = ", "),
       col = 1:4, lwd = 2, title = "df1, df2", bty = "n")
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> E anuar djathtas; forma varet nga dy numra: $d_1$ dhe $d_2$.
    \item<2-> Kur $d_2$ rritet, $F$ përqendrohet rreth 1.
    \item<3-> Te ANOVA, vlerat e mëdha të $F$ janë evidencë kundër $H_0$: testi është gjithmonë \textbf{në bishtin e djathtë}.
  \end{itemize}
\end{frame}

\begin{frame}[label=ushQf]{Radha jote!}
  \begin{Ushtrim}[(3 minuta)]
    \begin{enumerate}
      \item Gjej vlerën kritike $F_{0.95;\,2,\,12}$ me \texttt{qf()}.
      \item Gjej $P(F_{1,4}>3.375)$ me \texttt{pf()}. Krahasoje me vlerën $p$ të testit $t$ më sipër. Çfarë vëren?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjQf}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Pse jo shumë teste $t$?}
% ------------------------------------------------------------

\begin{frame}{Sa krahasime?}
  \begin{itemize}
    \item<1-> Me $k$ grupe ka $m=\binom k2=k(k-1)/2$ çifte.
    \item<2-> Pa ndihmën e PC: $k=3\to3$, \ $k=4\to6$, \ $k=6\to15$, \ $k=10\to45$.
    \item<3-> Nëse çdo test ka $\alpha=0.05$ dhe testet do ishin të pavarura:
      \[ P(\text{të paktën një gabim}) = 1-(1-\alpha)^m. \]
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Gabimi familjar sipas $k$}
<<fwer-table>>=
k <- c(3, 4, 6, 10)
m <- choose(k, 2)
rbind(k = k, pairs = m, FWER = round(1 - 0.95^m, 3))
@
  \begin{itemize}
    \item Me 10 grupe, gati me siguri ``zbulojmë'' diçka që nuk ekziston.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Simulim: 6 grupe pa asnjë dallim}
<<fwer-sim>>=
set.seed(404)
any_sig <- replicate(2000, {
  y <- rnorm(60)                    # H0 true: all 6 means equal
  g <- gl(6, 10)                    # 6 groups of 10
  p <- pairwise.t.test(y, g, p.adjust.method = "none")$p.value
  any(p < 0.05, na.rm = TRUE)
})
mean(any_sig)
@
  \footnotesize\textcolor{gray}{Të dhëna: sintetike.}
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Në \Sexpr{fmt(100 * mean(any_sig), 1)}\% të eksperimenteve kemi të paktën një ``dallim të rëndësishëm''.
    \item<2-> Më pak se 53.7\%: testet ndajnë të njëjtat grupe, prandaj nuk janë të pavarura.
    \item<3-> Gjithsesi shumë larg nga 5\% që premtonim.
  \end{itemize}
  \onslide<4->{\begin{Gabim}Të krahasosh çdo çift grupesh me teste $t$ të veçanta dhe të raportosh ``fituesit''.\end{Gabim}}
\end{frame}

\begin{frame}[label=ushK4]{Radha jote!}
  \begin{Ushtrim}[(3 minuta, pa ndihmën e PC)]
    Një studim krahason pagën mesatare në 4 sektorë.
    \begin{enumerate}
      \item Sa teste $t$ duhen për të gjitha çiftet?
      \item Sa është gabimi familjar, nëse testet do ishin të pavarura?
      \item Ç'pragu $\alpha$ për secilin test do ta mbante FWER $\le0.05$ me Bonferroni?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjK4}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Ideja e ANOVA-s}
% ------------------------------------------------------------

\begin{frame}{Një test, jo shumë}
  \begin{itemize}
    \item<1-> $H_0:\mu_1=\mu_2=\dots=\mu_k$.
    \item<2-> $H_1$: \textbf{të paktën një} $\mu_i$ ndryshon.
    \item<3-> Një test i vetëm me $\alpha=0.05$: gabimi familjar mbetet 5\%.
    \item<4-> Nëse $H_0$ hidhet poshtë, pyesim më pas \emph{cilat} grupe ndryshojnë (Ora 4).
  \end{itemize}
\end{frame}

\begin{frame}{Sinjali dhe zhurma}
  \begin{itemize}
    \item<1-> \textbf{Ndryshueshmëria midis grupeve}: sa larg janë mesataret nga mesatarja e përgjithshme?
    \item<2-> \textbf{Ndryshueshmëria brenda grupeve}: sa larg janë vëzhgimet nga mesatarja e grupit të tyre?
    \item<3-> Ideja: $F=\dfrac{\text{midis}}{\text{brenda}}$.
    \item<4-> Nëse $H_0$ është e vërtetë, të dyja vlerësojnë të njëjtën $\sigma^2$: $F\approx1$.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Të njëjtat mesatare, zhurmë e ndryshme}
<<signal-noise, fig.height=2.2, fig.width=7, out.width="0.72\\textwidth">>=
set.seed(41)
mk <- function(sd) data.frame(g = gl(3, 20, labels = c("A", "B", "C")),
                              y = rep(c(10, 12, 14), each = 20) + rnorm(60, 0, sd))
d <- rbind(cbind(mk(0.7), case = "sd = 0.7"), cbind(mk(4), case = "sd = 4"))
ggplot(d, aes(g, y)) + geom_jitter(width = 0.1, alpha = 0.5, size = 0.8) +
  stat_summary(fun = mean, geom = "point", colour = "#D97706", size = 3) +
  facet_wrap(~ case) + theme_minimal(base_size = 10)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Në të dy panelet, mesataret e vërteta janë 10, 12, 14.
    \item<2-> Majtas: grupet ndahen qartë. Djathtas: dallimi humbet në zhurmë.
    \item<3-> E njëjta ``midis'', ``brenda'' shumë e ndryshme $\Rightarrow$ $F$ shumë i ndryshëm.
  \end{itemize}
  \onslide<4->{\footnotesize\textcolor{gray}{Të dhëna: sintetike (mesataret 10, 12, 14; $\sigma=0.7$ dhe $\sigma=4$).}}
\end{frame}

\begin{frame}[label=ushName]{Mendo -- diskuto në çift -- ndaj}
  \begin{Ushtrim}[(Think--pair--share, 4 minuta)]
    Metoda quhet \textbf{analiza e variancës} (\emph{analysis of variance}), por teston \textbf{mesataret}.
    \begin{enumerate}
      \item Mendo vetëm: pse ky emër?
      \item Diskuto me shokun e bankës.
      \item Ndaj me klasën një fjali.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjName}{Shiko zgjidhjen}
\end{frame}

\begin{frame}{Lidhja me Javën 3: brenda dhe midis}
  \begin{itemize}
    \item<1-> Te Simpson-i: $\operatorname{Cov}(X,Y)=E[\operatorname{Cov}(X,Y\mid G)]+\operatorname{Cov}(E[X\mid G],E[Y\mid G])$.
    \item<2-> Për $X=Y$ merret \termi{ligji i variancës totale}{law of total variance}:
      \[ \operatorname{Var}(Y)=\underbrace{E[\operatorname{Var}(Y\mid G)]}_{\text{brenda}}+\underbrace{\operatorname{Var}(E[Y\mid G])}_{\text{midis}}. \]
    \item<3-> ANOVA është versioni i zgjedhjes së kësaj barazie: SST = SSW + SSB (Ora 2).
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Lidhja me Javën 3: pikë-biserial = testi $t$}
<<pb-t>>=
tg <- ToothGrowth                         # real: guinea pig odontoblast length
vc <- as.numeric(tg$supp == "VC")         # 0/1 coding of the supplement
c(p_cor = cor.test(vc, tg$len)$p.value,
  p_t   = t.test(len ~ supp, data = tg, var.equal = TRUE)$p.value)
@
  \footnotesize\textcolor{gray}{Të dhëna: reale, \texttt{datasets::ToothGrowth} (Crampton, 1947).}
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> E njëjta vlerë $p$: testi i $\rho=0$ me një variabël 0/1 \textbf{është} testi $t$ i dy mesatareve.
    \item<2-> ANOVA e zgjeron këtë ide nga 2 te $k$ grupe.
    \item<3-> Me 2 grupe: $F=t^2$, dhe ANOVA jep të njëjtën vlerë $p$ si testi $t$.
  \end{itemize}
\end{frame}

\begin{frame}{Shembulli A, B me sytë e ANOVA-s}
  $\bar y_A=4$, $\bar y_B=7$, mesatarja e përgjithshme $\bar y=5.5$.
  \pause
  \begin{itemize}
    \item Midis: $3(4-5.5)^2+3(7-5.5)^2=6.75+6.75=13.5$, me $df=k-1=1$.
    \pause
    \item Brenda: $(4+0+4)+(4+0+4)=16$, me $df=n-k=4$ $\Rightarrow$ $16/4=4$.
    \pause
    \item $F=\dfrac{13.5/1}{16/4}=3.375=t^2$. \checkmark
  \end{itemize}
  \pause
  \begin{Keshille}Ky është i gjithë thelbi i Orës 2, në një shembull me 6 numra.\end{Keshille}
\end{frame}

\begin{frame}{ANOVA në praktikë}
  \begin{itemize}
    \item<1-> \textbf{Statistika zyrtare:} a ndryshon shpenzimi mesatar i familjeve sipas qarkut ose tipit të vendbanimit?
    \item<2-> \textbf{Inxhinieri:} rezistenca e betonit nga tre furnitorë; 4 temperatura pjekjeje.
    \item<3-> \textbf{Mjedis:} përqendrimi i metaleve në tre zona të lumit (Java 12: \texttt{meuse}).
    \item<4-> \textbf{Biznes:} tre versione të një faqeje interneti (test A/B/C).
  \end{itemize}
\end{frame}

\begin{frame}{Gabime të zakonshme për fillim}
  \begin{Gabim}$F$ i rëndësishëm $\Rightarrow$ ``të gjitha mesataret ndryshojnë''. Jo: vetëm \emph{të paktën një}.\end{Gabim}
  \pause
  \begin{Gabim}Faktori i ruajtur si numër (\texttt{origin} = 1, 2, 3): R e trajton si variabël sasiore me $df=1$.\end{Gabim}
\end{frame}

% ------------------------------------------------------------
\subsection{Mbyllja e orës}
% ------------------------------------------------------------

\begin{frame}[label=cp41]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 1}
  \begin{enumerate}
    \item Pse nuk bëjmë thjesht $\binom k2$ teste $t$?
    \item Çfarë krahason raporti $F$?
    \item Me sa vlen $F$ kur kemi vetëm dy grupe?
  \end{enumerate}
  \shkoTe{zgjCp41}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje: Ora 1}
  \begin{itemize}
    \item Pyetja: a ndryshojnë mesataret e $k$ grupeve? (\texttt{mpg} sipas \texttt{origin}).
    \item Shumë teste $t$ $\Rightarrow$ gabimi familjar rritet shpejt.
    \item ANOVA: një test $F$ = midis / brenda grupeve.
    \item Me 2 grupe: $F=t^2$; lidhet me pikë-biserial-in dhe me variancën totale.
  \end{itemize}
  \begin{Keshille}Ora 2: modeli, zbërthimi SST = SSB + SSW dhe tabela ANOVA hap pas hapi.\end{Keshille}
\end{frame}
