\section{Motivimi}

\begin{frame}{Ora 1: Motivimi --- krahasimi i disa grupeve}
  \tableofcontents[currentsection,hideothersubsections,sectionstyle=show/hide]
\end{frame}

% ------------------------------------------------------------
\subsection{Problemi motivues}
% ------------------------------------------------------------

\begin{frame}{Pyetja e ditës \LO{K1}}
  \begin{itemize}
    \item<1-> Makinat vijnë nga tre rajone: SHBA, Evropa, Japonia.
    \item<2-> \textbf{A ndryshon konsumi i karburantit sipas origjinës?}
    \item<3-> Java 3: lidhja midis dy variablave \textbf{sasiore}. Sot: një variabël sasiore dhe një \textbf{faktor} (\emph{factor}) me disa kategori.
  \end{itemize}
  \onslide<4->{\Plotesues\footnotesize Ora bazohet te literatura e kursit (Raço et al.; Cohen et al.).}
\end{frame}

\begin{frame}{Të dhënat \texttt{Auto}}
  \begin{itemize}
    \item<1-> 397 modele makinash, 1970--1982.
    \item<2-> \texttt{mpg}: milje për galon. Më shumë = më pak konsum.
    \item<3-> \texttt{origin}: 1 = SHBA, 2 = Evropa, 3 = Japonia. Është \textbf{kod}, jo numër!
  \end{itemize}
  \onslide<4->{\footnotesize\textcolor{gray}{Të dhëna: reale, \texttt{Auto.csv} (James et al., \emph{ISLR}, nëpërmjet repo-s DS612).}}
\end{frame}

\begin{frame}[fragile]{Kodi R: mesataret sipas grupit}
<<auto-read>>=
auto <- read.csv(file.path(W04DATA, "Auto.csv"), na.strings = "?")
auto$origin <- factor(auto$origin, levels = 1:3,
                      labels = c("USA", "Europe", "Japan"))
table(auto$origin)
round(tapply(auto$mpg, auto$origin, mean), 2)
round(tapply(auto$mpg, auto$origin, sd), 2)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Mesataret: SHBA \Sexpr{fmt(mean(auto$mpg[auto$origin=="USA"]), 1)}, Evropa \Sexpr{fmt(mean(auto$mpg[auto$origin=="Europe"]), 1)}, Japonia \Sexpr{fmt(mean(auto$mpg[auto$origin=="Japan"]), 1)}.
    \item<2-> Shmangiet standarde janë të ngjashme: rreth 6--7.
    \item<3-> Grupet nuk janë të barabarta në madhësi: SHBA ka më shumë se gjysmën.
    \item<4-> Pyetja: a janë këto dallime \textbf{reale} apo nga rastësia e zgjedhjes?
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Pamja: kutitë dhe pikat}
<<auto-box, fig.height=2.4, fig.width=5.5, out.width="0.55\\textwidth">>=
library(ggplot2)
ggplot(auto, aes(origin, mpg)) +
  geom_boxplot(outlier.shape = NA, fill = "#E8EEF7") +
  geom_jitter(width = 0.15, alpha = 0.35, size = 0.8) +
  stat_summary(fun = mean, geom = "point", colour = "#D97706", size = 3) +
  theme_minimal(base_size = 10)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Pika portokalli = mesatarja; vija në kuti = mediana.
    \item<2-> Kutitë mbivendosen pjesërisht: shumë makina amerikane kanë \texttt{mpg} më të lartë se disa japoneze.
    \item<3-> Dallimi midis mesatareve duhet krahasuar me \textbf{shpërndarjen brenda grupeve}. Kjo është ideja e ditës.
  \end{itemize}
\end{frame}

\begin{frame}[label=pyetjeOrigin]{Parashiko!}
  \begin{Parashiko}
    Mesataret ndryshojnë me rreth 10 \texttt{mpg}, shmangiet standarde janë rreth 6.5, dhe grupet kanë 70--248 makina. Cili është përfundimi më i mundshëm i një testi?\\[3pt]
    \textbf{A)} Dallimet janë thjesht rastësi.\\
    \textbf{B)} Të paktën një mesatare ndryshon nga të tjerat.\\
    \textbf{C)} Të tria mesataret ndryshojnë nga njëra-tjetra.
  \end{Parashiko}
  \shkoTe{zgjOrigin}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Objektivat}
% ------------------------------------------------------------

\begin{frame}{Objektivat e ditës}
  Në fund të ditës do të jesh në gjendje:
  \begin{enumerate}
    \item \LO{S1} të shkruash modelin e ANOVA-s dhe të nxjerrësh SST = SSB + SSW;
    \item \LO{K1} të ndërtosh tabelën ANOVA dhe testin $F$;
    \item \LO{S3} të kontrollosh supozimet dhe të zgjedhësh alternativën (Welch, Kruskal--Wallis);
    \item \LO{S4} të bësh krahasimet e shumëfishta (Tukey) në R;
    \item \LO{C1} të analizosh dhe interpretosh një dizajn dyfaktorial me ndërveprim.
  \end{enumerate}
\end{frame}

\begin{frame}{Lidhja me javët e tjera}
  \begin{itemize}
    \item<1-> Java 3: korrelacioni pikë-biserial $\leftrightarrow$ testi $t$ për dy grupe.
    \item<2-> Java 3: Simpson, ``brenda + midis grupeve'' $\leftrightarrow$ sot: SST = SSW + SSB.
    \item<3-> Java 3: korrigjimi Holm $\leftrightarrow$ sot: Tukey.
    \item<4-> Java 6: ANOVA është regresion me variabla dummy.
  \end{itemize}
\end{frame}

