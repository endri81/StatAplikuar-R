% ------------------------------------------------------------
\subsection{Kuizi në stilin e provimit}
% ------------------------------------------------------------

\begin{frame}{Kuizi: si funksionon}
  \begin{itemize}
    \item<1-> Si në provim: \textbf{25\% teori, 75\% ushtrime}; 3 pyetje teorike (25 pikë) + 7 ushtrime (75 pikë).
    \item<2-> Koha: 45 minuta. Ushtrimet 1--5 dhe 7 bëhen pa ndihmën e PC.
    \item<3-> Vlerat kritike jepen në çdo ushtrim.
  \end{itemize}
  \onslide<4->{\begin{Keshille}Ndërto gjithmonë tabelën e plotë: df, SS, MS, $F$. Pikët jepen për çdo kolonë.\end{Keshille}}
\end{frame}

\begin{frame}[label=q4T1]{Teori 1 (8 pikë)}
  \begin{Ushtrim}[(Teori 1)]
    \begin{enumerate}
      \item Shkruani modelin e ANOVA-s njëfaktoriale dhe hipotezat.
      \item Përkufizoni SSB dhe SSW. Pse SSW ka $N-k$ shkallë lirie?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s4T1}{Zgjidhja}
\end{frame}

\begin{frame}[label=q4T2]{Teori 2 (8 pikë)}
  \begin{Ushtrim}[(Teori 2)]
    \begin{enumerate}
      \item Renditni supozimet e ANOVA-s sipas rëndësisë dhe tregoni si kontrollohet secili.
      \item Kur preferohet ANOVA e Welch-it? Kur Kruskal--Wallis?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s4T2}{Zgjidhja}
\end{frame}

\begin{frame}[label=q4T3]{Teori 3 (9 pikë)}
  \begin{Ushtrim}[(Teori 3)]
    \begin{enumerate}
      \item Çfarë është ndërveprimi në një ANOVA dyfaktoriale? Si duket në grafik?
      \item Pse Tukey HSD dhe jo $\binom k2$ teste $t$ të zakonshme?
      \item Pse në një dizajn të pabalancuar SS e tipit I varet nga rendi i faktorëve?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s4T3}{Zgjidhja}
\end{frame}

\begin{frame}[label=q4E1]{Ushtrimi 1 (10 pikë): tabela ANOVA}
  \begin{Ushtrim}[(Ushtrimi 1, pa ndihmën e PC)]
    A $=(2,4,6)$, \ B $=(5,6,7)$, \ C $=(6,8,10)$.
    \begin{enumerate}
      \item Llogaritni mesataret, SSB, SSW dhe kontrolloni me SST.
      \item Plotësoni tabelën ANOVA.
      \item Vendimi në $\alpha=0.05$? ($F_{0.95;\,2,6}=5.14$.)
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s4E1}{Zgjidhja}
\end{frame}

\begin{frame}[label=q4E2]{Ushtrimi 2 (10 pikë): nga tabelat e përmbledhura}
  \begin{Ushtrim}[(Ushtrimi 2, pa ndihmën e PC)]
    Tre linja prodhimi; rezistenca (MPa):
    \begin{center}
      \begin{tabular}{@{}lccc@{}}
        \toprule
        Linja & $n_i$ & $\bar y_i$ & $s_i$ \\ \midrule
        A & 10 & 50 & 4 \\ B & 12 & 54 & 5 \\ C & 8 & 47 & 6 \\ \bottomrule
      \end{tabular}
    \end{center}
    Llogaritni $\bar y_{\cdot\cdot}$, SSB, SSW, $F$ dhe $\eta^2$. ($F_{0.95;\,2,27}=3.35$.)
  \end{Ushtrim}
  \shkoTe{s4E2}{Zgjidhja}
\end{frame}

\begin{frame}[label=q4E3]{Ushtrimi 3 (10 pikë): Tukey--Kramer}
  \begin{Ushtrim}[(Ushtrimi 3, pa ndihmën e PC)]
    Me të dhënat e Ushtrimit 2 (MSW $=24.85$) dhe $q_{0.95;\,3,27}=3.51$:
    \begin{enumerate}
      \item Llogaritni $\sqrt{\frac{\text{MSW}}{2}\big(\frac1{n_i}+\frac1{n_j}\big)}$ për çdo çift.
      \item Llogaritni kufirin për çdo çift dhe krahasoni me diferencat.
      \item Cilat linja ndryshojnë?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s4E3}{Zgjidhja}
\end{frame}

\begin{frame}[label=q4E4]{Ushtrimi 4 (10 pikë): Kruskal--Wallis}
  \begin{Ushtrim}[(Ushtrimi 4, pa ndihmën e PC)]
    A $=(1,3,5)$, \ B $=(2,8,9)$, \ C $=(4,6,7)$ (pa barazime).
    \begin{enumerate}
      \item Llogaritni shumat e rangjeve $R_i$.
      \item Llogaritni $H$.
      \item Vendimi në $\alpha=0.05$? ($\chi^2_{0.95;\,2}=5.99$.)
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s4E4}{Zgjidhja}
\end{frame}

\begin{frame}[label=q4E5]{Ushtrimi 5 (10 pikë): tabela dyfaktoriale}
  \begin{Ushtrim}[(Ushtrimi 5, pa ndihmën e PC)]
