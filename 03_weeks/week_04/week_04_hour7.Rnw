        Brenda & ? & 54 & ? & \\ \midrule Totali & ? & 200 & & \\ \bottomrule
      \end{tabular}
    \end{center}
    Vendimet? ($F_{0.95;\,1,18}=4.41$, \ $F_{0.95;\,2,18}=3.55$.)
  \end{Ushtrim}
  \shkoTe{s4E5}{Zgjidhja}
\end{frame}

\begin{frame}[fragile,label=q4E6]{Ushtrimi 6 (10 pikë): lexo output-in}
<<quiz-warp, echo=FALSE>>=
summary(aov(breaks ~ wool * tension, data = warpbreaks))
@
  \small
  \texttt{warpbreaks}: këputjet e fijeve në tezgjah, 2 lloje leshi $\times$ 3 tensione, $n=9$ (reale, R bazë).
  Sa vëzhgime ka gjithsej? Cili efekt interpretohet i pari? Çfarë hapi bën më pas? \hfill\shkoTe{s4E6}{Zgjidhja}
\end{frame}

\begin{frame}[label=q4E7]{Ushtrimi 7 (15 pikë): ndërveprimi $2\times2$}
  \begin{Ushtrim}[(Ushtrimi 7, pa ndihmën e PC)]
    Mesataret e qelizave ($n=5$, MSW $=4$, $df=16$): \ A1B1 $=10$, A1B2 $=14$, A2B1 $=12$, A2B2 $=24$.
    \begin{enumerate}
      \item Llogaritni efektin e thjeshtë të B në A1 dhe në A2.
      \item Ndërveprimi $=$ diferenca e tyre. Llogaritni $SE=\sqrt{\text{MSW}\cdot4/n}$ dhe $t$ ($t_{0.975;\,16}=2.12$).
      \item Interpretoni me një fjali. A ka kuptim ``efekti kryesor i B''?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s4E7}{Zgjidhja}
\end{frame}

