% ------------------------------------------------------------
\subsection{Gabimet e javës}
% ------------------------------------------------------------

\begin{frame}{Gabimet e zakonshme: interpretimi}
  \begin{itemize}
    \item<1-> $F$ i rëndësishëm $\Rightarrow$ ``të gjitha mesataret ndryshojnë''. Jo: \emph{të paktën një}.
    \item<2-> $p$ i vogël $\Rightarrow$ ``efekt i madh''. Raporto $\eta^2$ ose $\omega^2$.
    \item<3-> Efektet kryesore të interpretuara kur ndërveprimi është i rëndësishëm.
    \item<4-> ``A $\ne$ C, A $=$ B'' nga mungesa e rëndësisë.
  \end{itemize}
\end{frame}

\begin{frame}{Gabimet e zakonshme: llogaritja}
  \begin{itemize}
    \item<1-> Faktori i ruajtur si numër: $df=1$ në vend të $k-1$.
    \item<2-> SSB pa peshat $n_i$.
    \item<3-> $df$ e gabimit $N-1$ në vend të $N-k$.
    \item<4-> Tipi III me \texttt{contr.treatment}.
  \end{itemize}
\end{frame}

\begin{frame}{Gabimet e zakonshme: supozimet}
  \begin{itemize}
    \item<1-> Normaliteti i testuar te $y$, jo te mbetjet.
    \item<2-> Shapiro me $N$ të madh si arsye për të braktisur ANOVA-n.
    \item<3-> ``Levene nuk doli i rëndësishëm, pra variancat janë të barabarta'' me $n_i$ të vogla.
    \item<4-> Kruskal--Wallis si ``ANOVA për mesataret'' kur variancat ndryshojnë.
  \end{itemize}
\end{frame}

\begin{frame}{Lista e kontrollit e një analize ANOVA}
  \begin{enumerate}
    \item Faktorët si \texttt{factor()}; numëro $n_i$ për çdo grup/qelizë.
    \item Grafikë: kutitë; grafiku i ndërveprimit për dy faktorë.
    \item Modeli; me dy faktorë, lexo ndërveprimin të parin.
    \item Diagnostikimi: mbetjet, QQ, raporti i $s_i$; Welch nëse duhet.
    \item Krahasimet: Tukey ose efekte të thjeshta me \texttt{emmeans}.
    \item Raporti: $F(df_1,df_2)$, $p$, madhësia e efektit, IB, kufizimet.
  \end{enumerate}
\end{frame}

% ------------------------------------------------------------
\subsection{Fletë-kujtesa}
% ------------------------------------------------------------

\begin{frame}{Fletë-kujtesa 1: formulat}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    Madhësia & Formula \\ \midrule
    SSB, SSW & $\sum n_i(\bar y_{i\cdot}-\bar y_{\cdot\cdot})^2$, \ $\sum(n_i-1)s_i^2$ \\
    $F$ & $\dfrac{\text{SSB}/(k-1)}{\text{SSW}/(N-k)}$ \\
    $E[\text{MSB}]$ & $\sigma^2+\sum n_i\alpha_i^2/(k-1)$ \\
    $\eta^2$, $\omega^2$ & SSB/SST, \ $\dfrac{\text{SSB}-(k-1)\text{MSW}}{\text{SST}+\text{MSW}}$ \\
    Tukey HSD & $q_{1-\alpha;\,k,N-k}\sqrt{\text{MSW}/n}$ \\
    Kruskal--Wallis & $H=\frac{12}{N(N+1)}\sum R_i^2/n_i-3(N+1)$ \\
    Dyfaktoriale & SST = SSA + SSB + SSAB + SSW; \ $df_{AB}=(a-1)(b-1)$ \\ \bottomrule
  \end{tabular}
\end{frame}

\begin{frame}{Fletë-kujtesa 2: funksionet R}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    Detyra & Funksioni \\ \midrule
    ANOVA & \texttt{aov(y \textasciitilde{} g)}, \texttt{summary()}, \texttt{anova(lm())} \\
    Supozimet & \texttt{plot(fit, which = 1:2)}, \texttt{car::leveneTest()} \\
    Alternativat & \texttt{oneway.test()}, \texttt{kruskal.test()} \\
    Çiftet & \texttt{TukeyHSD()}, \texttt{pairwise.t.test(p.adjust.method = )} \\
    Mesataret, efektet e thjeshta & \texttt{emmeans(fit, \textasciitilde{} A | B)}, \texttt{pairs()} \\
    Madhësia e efektit & \texttt{effectsize::omega\_squared()}, \texttt{eta\_squared()} \\
    Fuqia & \texttt{power.anova.test()}, \texttt{pf(..., ncp = )} \\
    Pabalancuar & \texttt{car::Anova(fit, type = 2)} \\ \bottomrule
  \end{tabular}
\end{frame}

\begin{frame}{Fletë-kujtesa 3: grafikët}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    Grafiku & Funksioni \\ \midrule
    Kutitë + pikat & \texttt{geom\_boxplot()} + \texttt{geom\_jitter()} \\
    Violin & \texttt{geom\_violin()} \\
    Mesataret & \texttt{stat\_summary(fun = mean, geom = "point")} \\
    Ndërveprimi & \texttt{stat\_summary(fun = mean, geom = "line")}, \texttt{interaction.plot()} \\
    Intervalet Tukey & \texttt{plot(TukeyHSD(fit))} \\
    Diagnostikimi & \texttt{plot(fit, which = 1:2)} \\ \bottomrule
  \end{tabular}
\end{frame}

% ------------------------------------------------------------
\subsection{Ura drejt regresionit}
% ------------------------------------------------------------

\begin{frame}[fragile]{ANOVA = regresion me variabla dummy}
<<bridge-mm>>=
auto <- read.csv(file.path(W04DATA, "Auto.csv"), na.strings = "?")
auto$origin <- factor(auto$origin, labels = c("USA", "Europe", "Japan"))
head(model.matrix(~ origin, data = auto)[c(1, 15, 20), ], 3)
auto$origin[c(1, 15, 20)]
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Faktori me 3 nivele bëhet 2 kolona 0/1 (+ konstantja): \texttt{originEurope}, \texttt{originJapan}.
    \item<2-> SHBA është \textbf{niveli bazë}: konstantja $=\bar y_{\text{USA}}$.
    \item<3-> Koeficientët = dallimet nga baza (Ora 3: +7.82, +10.38).
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{$R^2$ i regresionit $=\eta^2$}
<<bridge-r2>>=
fit_lm <- lm(mpg ~ origin, data = auto)
c(R2 = summary(fit_lm)$r.squared,
  eta2 = 8081.1 / (8081.1 + 16171.2))
summary(fit_lm)$fstatistic
@
\end{frame}

\begin{frame}{Java 5: regresi i thjeshtë linear \LO{K2} \LO{S2}}
  \begin{itemize}
    \item<1-> Sot: $x$ kategorik $\Rightarrow$ mesatare grupesh. Java 5: $x$ sasior $\Rightarrow$ vijë e drejtë.
    \item<2-> Të njëjtat ide: SST = SSR + SSE, $F$, $R^2$, mbetjet, supozimet.
    \item<3-> Katrorët më të vegjël, inferenca për $\beta_0,\beta_1$, parashikimi.
    \item<4-> Material: repo-ja DS612 (\texttt{Linear\_Regression}) dhe ISLR, kap.~3.
  \end{itemize}
\end{frame}

\begin{frame}{Para Javës 5}
  \begin{itemize}
    \item Përsëritni korrelacionin (Java 3): $\hat\beta_1=r\,s_y/s_x$.
    \item Mbaroni ushtrimet për shtëpi 1--6.
    \item Lexoni ISLR kap.~3.1 (regresi i thjeshtë).
  \end{itemize}
\end{frame}

\begin{frame}{Burime}
  \footnotesize
  \begin{itemize}
    \item E.~Raço, E.~Llagami, K.~Haxhi, O.~Zaçaj, \emph{Teoria e Probabilitetit dhe Statistika Matematike me ilustrime në gjuhën R}, Kotti, 2021 (testi $t$, shpërndarja $F$, ANOVA).
    \item J.~Cohen, P.~Cohen, S.~G.~West, L.~S.~Aiken, \emph{Applied Multiple Regression/Correlation Analysis for the Behavioral Sciences}, LEA, 2003 (variablat kategorike, kodimi, ndërveprimet).
    \item G.~James, D.~Witten, T.~Hastie, R.~Tibshirani, \emph{An Introduction to Statistical Learning}, Springer; \url{https://www.statlearning.com} (të dhënat \texttt{Auto}, \texttt{Carseats}).
    \item N.~Lo, \emph{DS612 Data Mining with Business Applications (R)}, \url{https://github.com/NormanLo4319/DS612_Data_Mining_with_Business_Applications_R} (licencë MIT); \texttt{anova()} për modele të mbivendosura nga \texttt{DS612\_R-Code\_Lecture\_7.1.R}.
    \item J.~W.~Tukey (1949), Comparing individual means in the analysis of variance, \emph{Biometrics} 5(2); B.~L.~Welch (1951), \emph{Biometrika} 38(3/4); W.~H.~Kruskal, W.~A.~Wallis (1952), \emph{JASA} 47(260).
    \item E.~W.~Crampton (1947), \emph{The Journal of Nutrition} 33(5) (\texttt{ToothGrowth}).
    \item Paketat: \texttt{car}, \texttt{emmeans}, \texttt{effectsize}, \texttt{ggplot2}. Të dhënat e R bazë: \texttt{ToothGrowth}, \texttt{warpbreaks}, \texttt{InsectSprays}.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Mbyllja e ditës}
% ------------------------------------------------------------

\begin{frame}[label=cp47]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 7}
  \begin{enumerate}
    \item Cilat katër gjëra raporton për një ANOVA?
    \item Kur dizajni është i pabalancuar dhe variancat ndryshojnë, çfarë përdor?
    \item Si lidhet $\eta^2$ me $R^2$ e regresionit?
  \end{enumerate}
  \shkoTe{zgjCp47}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje e Javës 4}
  \begin{itemize}
    \item ANOVA: një test $F$ = midis / brenda grupeve; SST = SSB + SSW.
    \item Supozimet: pavarësia, varianca e njëjtë, normaliteti i mbetjeve; Welch dhe Kruskal--Wallis.
    \item Krahasimet: Tukey HSD, Holm, \texttt{emmeans}; \Zgjerim kontrastet.
    \item Dy faktorë: ndërveprimi i pari; efektet e thjeshta; \Zgjerim tipet e SS.
    \item ANOVA = regresion me dummy: ura drejt Javës 5.
  \end{itemize}
\end{frame}
