\begin{frame}[label=zgjCp42]{Përgjigjet: Checkpoint Ora 2}
  \begin{enumerate}
    \item Sepse brenda çdo grupi $\sum_j(y_{ij}-\bar y_{i\cdot})=0$.
    \item Nën $H_0$: $\sigma^2$. Nën $H_1$: $\sigma^2+\sum n_i\alpha_i^2/(k-1)>\sigma^2$.
    \item $\eta^2$ përfshin edhe pjesën e SSB që vjen nga zhurma; $\omega^2$ e heq atë me $(k-1)\text{MSW}$.
  \end{enumerate}
  \vfill\kthehu{cp42}
\end{frame}
