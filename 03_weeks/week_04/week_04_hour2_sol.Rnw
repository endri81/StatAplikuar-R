\begin{frame}[fragile,label=zgjAlpha]{Zgjidhja: Radha jote! ($\hat\alpha_i$)}
  \begin{enumerate}
    \item $\hat\alpha=(20.07-23.52,\ 27.89-23.52,\ 30.45-23.52)=(-3.45,\ 4.37,\ 6.93)$.
    \item $248(-3.45)+70(4.37)+79(6.93)\approx-855.6+305.9+547.5=-2.2\approx0$ (rrumbullakim).
  \end{enumerate}
<<sol-alpha>>=
auto <- read.csv(file.path(W04DATA, "Auto.csv"), na.strings = "?")
alpha <- tapply(auto$mpg, auto$origin, mean) - mean(auto$mpg)
round(alpha, 3); sum(table(auto$origin) * alpha)
@
  \vfill\kthehu{pyetjeAlpha}
\end{frame}

\begin{frame}[label=zgjF1]{Zgjidhja: Pyetje me zgjedhje ($F<1$)}
  \begin{itemize}
    \item \textbf{B}. $F=\text{MSB}/\text{MSW}$ mund të jetë çdo numër $\ge0$. Nën $H_0$ pritet rreth 1; vlerat nën 1 janë të zakonshme.
    \item C është e gabuar: $F$ nuk ka drejtim, sepse SSB përdor katrorë.
    \item Një $F$ shumë afër 0 me shumë të dhëna mund të sinjalizojë të dhëna ``tepër të rregullta'': ia vlen të kontrollohen.
  \end{itemize}
  \vfill\kthehu{pyetjeF1}
\end{frame}

\begin{frame}[fragile,label=zgjToy2]{Zgjidhja: Radha jote! (A, B, C)}
  \begin{enumerate}
    \item $\bar y=(2,3,7)$, $\bar y_{\cdot\cdot}=36/9=4$. SSB $=3(4+1+9)=42$; SSW $=2+2+2=6$; SST $=48$.
    \item MSB $=21$, MSW $=1$, $F=21>5.14$: hedhim poshtë $H_0$.
    \item Zhurma brenda grupeve është shumë më e vogël (MSW $=1$ kundrejt 4.67).
  \end{enumerate}
<<sol-toy2>>=
y <- c(1, 2, 3, 2, 3, 4, 6, 7, 8); g <- gl(3, 3, labels = c("A", "B", "C"))
summary(aov(y ~ g))
@
  \vfill\kthehu{ushToy2}
\end{frame}

