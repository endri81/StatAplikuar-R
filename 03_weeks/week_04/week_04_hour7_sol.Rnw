% ============================================================
%  Java 4 · Ora 7 — Zgjidhjet e kuizit dhe të ushtrimeve
% ============================================================

\begin{frame}[label=s4T1]{Zgjidhja: Teori 1}
  \begin{enumerate}
    \item $y_{ij}=\mu+\alpha_i+\varepsilon_{ij}$, $\varepsilon_{ij}\sim N(0,\sigma^2)$ iid, $\sum n_i\alpha_i=0$; \ $H_0:\alpha_1=\dots=\alpha_k=0$, $H_1$: të paktën një $\alpha_i\ne0$. (4 pikë)
    \item SSB $=\sum n_i(\bar y_{i\cdot}-\bar y_{\cdot\cdot})^2$, SSW $=\sum\sum(y_{ij}-\bar y_{i\cdot})^2$. $N$ devijime me $k$ kufizime (një për grup: $\sum_j e_{ij}=0$) $\Rightarrow N-k$. (4 pikë)
  \end{enumerate}
  \vfill\kthehu{q4T1}
\end{frame}

\begin{frame}[label=s4T2]{Zgjidhja: Teori 2}
  \begin{enumerate}
    \item Pavarësia (nga dizajni); varianca e njëjtë (mbetjet sipas grupit, raporti i $s_i$, Levene); normaliteti i mbetjeve (QQ, Shapiro me kujdes). (4 pikë)
    \item Welch: variancat ndryshojnë, sidomos me $n_i$ të ndryshme. Kruskal--Wallis: të dhëna rendore, vlera ekstreme, shpërndarje shumë jo-normale me $n_i$ të vogla. (4 pikë)
  \end{enumerate}
  \vfill\kthehu{q4T2}
\end{frame}

\begin{frame}[label=s4T3]{Zgjidhja: Teori 3}
  \begin{enumerate}
    \item Efekti i një faktori varet nga niveli i tjetrit; vija jo paralele të mesatareve. (3 pikë)
    \item $\binom k2$ teste me $\alpha=0.05$ e rritin gabimin familjar; Tukey e mban atë $=\alpha$ duke përdorur shpërndarjen e diferencës më të madhe. (3 pikë)
    \item Faktorët janë të korreluar: pjesa e përbashkët e SS i jepet termit që hyn i pari. (3 pikë)
  \end{enumerate}
  \vfill\kthehu{q4T3}
\end{frame}

\begin{frame}[fragile,label=s4E1]{Zgjidhja: Ushtrimi 1}
  \begin{enumerate}
    \item $\bar y=(4,6,8)$, $\bar y_{\cdot\cdot}=6$. SSB $=3(4+0+4)=24$; SSW $=8+2+8=18$; SST $=16+4+0+1+0+1+0+4+16=42$. \checkmark\ (4 pikë)
    \item MSB $=12$, MSW $=3$, $F=4.0$, $df=(2,6)$. (4 pikë)
    \item $4.0<5.14$: nuk e hedhim poshtë $H_0$. (2 pikë)
  \end{enumerate}
<<sol-q4e1>>=
y <- c(2, 4, 6, 5, 6, 7, 6, 8, 10); g <- gl(3, 3)
summary(aov(y ~ g))[[1]][, 1:5]
@
  \vfill\kthehu{q4E1}
\end{frame}

\begin{frame}[label=s4E2]{Zgjidhja: Ushtrimi 2}
  \begin{enumerate}
    \item $\bar y_{\cdot\cdot}=(500+648+376)/30=50.8$. (2 pikë)
    \item SSB $=10(0.8)^2+12(3.2)^2+8(3.8)^2=6.4+122.88+115.52=244.8$. (3 pikë)
    \item SSW $=9\cdot16+11\cdot25+7\cdot36=671$; MSW $=671/27=24.85$. (2 pikë)
    \item $F=122.4/24.85=4.93>3.35$: hedhim poshtë $H_0$ ($p\approx0.015$). $\eta^2=244.8/915.8=0.27$. (3 pikë)
  \end{enumerate}
  \vfill\kthehu{q4E2}
\end{frame}

\begin{frame}[label=s4E3]{Zgjidhja: Ushtrimi 3}
  \small
  \centering
  \begin{tabular}{@{}lcccc@{}}
    \toprule
    Çifti & $|\bar y_i-\bar y_j|$ & $\sqrt{\frac{24.85}{2}(\frac1{n_i}+\frac1{n_j})}$ & Kufiri ($\times3.51$) & Ndryshon? \\ \midrule
    B--A & 4 & $\sqrt{12.43\times0.183}=1.51$ & 5.30 & jo \\
    A--C & 3 & $\sqrt{12.43\times0.225}=1.67$ & 5.87 & jo \\
    B--C & 7 & $\sqrt{12.43\times0.208}=1.61$ & 5.65 & \textbf{po} \\ \bottomrule
  \end{tabular}
  \normalsize
  \begin{itemize}
    \item Vetëm linjat B dhe C ndryshojnë. (Pikët: 4 + 4 + 2.)
  \end{itemize}
  \vfill\kthehu{q4E3}
\end{frame}

\begin{frame}[fragile,label=s4E4]{Zgjidhja: Ushtrimi 4}
  \begin{enumerate}
    \item Vlerat janë vetë rangjet 1--9: $R_A=9$, $R_B=19$, $R_C=17$. (3 pikë)
    \item $H=\frac{12}{90}\cdot\frac{81+361+289}{3}-30=\frac{12}{90}\cdot243.67-30\approx2.49$. (5 pikë)
    \item $2.49<5.99$: nuk e hedhim poshtë $H_0$. (2 pikë)
  \end{enumerate}
<<sol-q4e4>>=
kruskal.test(c(1, 3, 5, 2, 8, 9, 4, 6, 7) ~ gl(3, 3))$statistic
@
  \vfill\kthehu{q4E4}
\end{frame}

\begin{frame}[label=s4E5]{Zgjidhja: Ushtrimi 5}
  \centering
  \begin{tabular}{@{}lccccc@{}}
