% ------------------------------------------------------------
\subsection{Në praktikë}
% ------------------------------------------------------------

\begin{frame}{Ku ka rëndësi diagnostikimi?}
  \begin{itemize}
    \item<1-> \textbf{Statistika zyrtare:} një bashki shumë e madhe (Tirana) mund të ketë leverage të lartë në një model sipas bashkive.
    \item<2-> \textbf{Inxhinieri:} kalibrimi i sensorëve; një matje e gabuar mund të ndryshojë kurbën e kalibrimit.
    \item<3-> \textbf{Mjedis:} përqendrimet e ndotësve janë shpesh të anuara: varianca rritet me nivelin.
    \item<4-> \textbf{Financë:} variablat e kredisë (\texttt{Rating}, \texttt{Limit}) janë thuajse kopje të njëra-tjetrës.
  \end{itemize}
\end{frame}

\begin{frame}[label=ushAdvDiag]{Radha jote!}
  \begin{Ushtrim}[(5 minuta)]
    Përshtat \texttt{lm(sales \textasciitilde{} TV, data = adv)} dhe ekzekuto \texttt{par(mfrow = c(2, 2)); plot(fit)}.
    \begin{enumerate}
      \item Cili nga katër grafikët tregon problemin kryesor?
      \item Cili nga gjashtë problemet është?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjAdvDiag}{Shiko zgjidhjen}
\end{frame}

\begin{frame}{Gabime të zakonshme për fillim}
  \begin{Gabim}``Të gjithë $p<0.001$, pra modeli është në rregull.'' Vlerat $p$ supozojnë që modeli është i saktë; ato nuk e testojnë atë.\end{Gabim}
  \pause
  \begin{Gabim}Fshirja automatike e çdo pike me mbetje të madhe. Një vlerë ekstreme mund të jetë gabim, por edhe informacioni më i rëndësishëm. Së pari: kontrollo burimin.\end{Gabim}
\end{frame}

% ------------------------------------------------------------
\subsection{Mbyllja e orës}
% ------------------------------------------------------------

\begin{frame}[label=cp71]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 1}
  \begin{enumerate}
    \item Çfarë tregon kuarteti i Anscombe-s për \texttt{summary(lm)}?
    \item Cili grafik i \texttt{plot(fit)} tregon heteroskedasticitetin?
    \item Cila është pasoja kryesore e gabimeve të korreluara?
  \end{enumerate}
  \shkoTe{zgjCp71}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje: Ora 1}
  \begin{itemize}
    \item Numrat e \texttt{summary()} nuk mjaftojnë: Anscombe.
    \item \texttt{plot(fit)}: Residuals vs Fitted, Q-Q, Scale-Location, Residuals vs Leverage.
    \item Gjashtë probleme: jolinearitet, gabime të korreluara, heteroskedasticitet, vlera ekstreme, leverage, multikolinearitet.
  \end{itemize}
  \begin{Keshille}Ora 2: matematika e mbetjeve: $h_{ii}$, mbetjet e studentizuara, distanca e Cook-ut, me shembull pa ndihmën e PC.\end{Keshille}
\end{frame}
