\section[Teoria II]{Teoria II: Bayes, LDA, QDA, KNN, ROC}

\begin{frame}{Ora 4: Teoria II --- Bayes, LDA, QDA, KNN, ROC}
  \tableofcontents[currentsection,hideothersubsections,sectionstyle=show/hide]
