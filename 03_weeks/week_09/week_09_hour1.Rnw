\section[Motivimi]{Motivimi: kur $y$ është kategori}

\begin{frame}{Ora 1: Motivimi --- kur $y$ është kategori}
  \tableofcontents[currentsection,hideothersubsections,sectionstyle=show/hide]
\end{frame}

% ------------------------------------------------------------
\subsection{Problemi}
% ------------------------------------------------------------

\begin{frame}{Nga ``sa?'' te ``cila?''}
  \begin{itemize}
    \item<1-> Javët 5--8: $y$ sasior (paga, çmimi, \texttt{mpg}) $\Rightarrow$ \termi{regres}{regression}.
    \item<2-> Sot: $y$ kategorik (po/jo, lart/poshtë, defekt/në rregull) $\Rightarrow$ \termi{klasifikim}{classification}.
    \item<3-> Synimi: vlerësojmë $P(Y=1\mid X=x)$, pastaj vendosim një klasë.
    \item<4-> Shembuj: a do ta shlyejë klienti kredinë? A do të ngrihet tregu nesër? A është pjesa me defekt?
  \end{itemize}
\end{frame}

\begin{frame}{Ku përdoret në praktikë?}
  \begin{itemize}
    \item<1-> \textbf{Banka}: vlerësimi i rrezikut të kredisë (\emph{credit scoring}).
    \item<2-> \textbf{Inxhinieri}: kontrolli i cilësisë, pjesë me defekt sipas parametrave të prodhimit.
    \item<3-> \textbf{Statistikë zyrtare}: klasifikimi i përgjigjeve, imputimi i statusit (p.sh.\ i punësuar / jo, në anketat e forcave të punës).
    \item<4-> \textbf{Mjekësi, mjedis}: diagnoza, tejkalimi i pragut të ndotjes.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Të dhënat \texttt{Default}}
% ------------------------------------------------------------

\begin{frame}{Të dhënat: \texttt{Default}}
  \begin{itemize}
    \item<1-> 10\,000 klientë të kartave të kreditit; \texttt{default} (po/jo), \texttt{student}, \texttt{balance}, \texttt{income}.
    \item<2-> \textbf{Sintetike}: të simuluara nga autorët e ISLR (dokumentacioni i paketës); parametrat e vërtetë nuk publikohen.
    \item<3-> Skedari: repo DS612, \texttt{Data/Textbook\_Data/Default.csv}.
    \item<4-> Pse i përdorim: struktura realiste e problemit të kredisë dhe një klasë e rrallë.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Leximi dhe frekuencat}
<<h1-read>>=
default_df <- read.csv(file.path(W09DATA, "Default.csv"), stringsAsFactors = TRUE)
dim(default_df)
table(default_df$default)
round(prop.table(table(default_df$default)), 4)
round(tapply(default_df$balance, default_df$default, mean), 1)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Vetëm 333 nga 10\,000 (3.33\%) nuk e shlyejnë: klasë e \textbf{rrallë}.
    \item<2-> Balanca mesatare: 804 \$ për ``jo'', 1748 \$ për ``po''.
    \item<3-> Balanca është kandidati kryesor për parashikim.
  \end{itemize}
  \pause[4]
  \begin{Gabim}Një ``model'' që thotë gjithmonë ``jo'' ka saktësi 96.7\%. Saktësia e vetme mashtron kur klasat janë të pabalancuara.\end{Gabim}
\end{frame}

\begin{frame}[fragile]{Default sipas intervalit të balancës}
<<h1-tab>>=
bal_grp <- cut(default_df$balance, c(-1, 500, 1000, 1500, 2000, 3000))
tab <- table(bal_grp, default_df$default)
cbind(tab, rate = round(tab[, "Yes"] / rowSums(tab), 3))
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Deri në 500 \$: asnjë default. 1000--1500: 2.5\%.
    \item<2-> 1500--2000: 22\%. Mbi 2000: 76\%.
    \item<3-> Probabiliteti rritet në formë \textbf{S}: i ulët, pastaj rritje e shpejtë, pastaj afër 1.
  \end{itemize}
\end{frame}

\begin{frame}[label=pyetjeBal]{Parashiko para se ta ekzekutosh}
  \begin{Parashiko}
    Kodojmë $y=1$ për default, 0 ndryshe, dhe përshtatim \texttt{lm(y \textasciitilde{} balance)}.
    \begin{enumerate}
      \item Çfarë ``probabiliteti'' pret për një klient me balancë 0?
      \item Po për balancë 2500 \$? (Nga tabela: rreth 76\% mbi 2000.)
    \end{enumerate}
  \end{Parashiko}
  \shkoTe{zgjBal}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Pse jo regresi linear?}
% ------------------------------------------------------------

\begin{frame}[fragile]{Regresi linear mbi 0/1}
<<h1-lm>>=
default_df$y <- as.numeric(default_df$default == "Yes")
fit_lm <- lm(y ~ balance, data = default_df)
round(coef(fit_lm), 7)
round(range(fitted(fit_lm)), 3)
sum(fitted(fit_lm) < 0)
round(predict(fit_lm, data.frame(balance = c(0, 2000, 2500))), 3)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> 3123 klientë marrin ``probabilitet'' \textbf{negativ}.
    \item<2-> Për 2500 \$, \texttt{lm} jep 0.25; tabela tregon rreth 0.76.
    \item<3-> Vija e drejtë nuk mund ta ndjekë formën S.
    \item<4-> Gjithashtu: $\operatorname{Var}(Y\mid x)=p(1-p)$ ndryshon me $x$; gabimet nuk janë normale.
  \end{itemize}
\end{frame}

\begin{frame}[fragile,shrink=10]{Vija e drejtë kundrejt kurbës logjistike}
<<h1-plot, fig.height=3, fig.width=6.5, out.width="0.5\\textwidth">>=
fit_glm <- glm(y ~ balance, data = default_df, family = binomial)
gb <- data.frame(balance = seq(0, 2700, length.out = 300))
plot(default_df$balance, default_df$y, pch = "|", col = rgb(0.4, 0.4, 0.4, 0.3),
     xlab = "balance", ylab = "P(default)", ylim = c(-0.1, 1.05))
abline(fit_lm, col = "#D97706", lwd = 2); abline(h = c(0, 1), lty = 3)
lines(gb$balance, predict(fit_glm, gb, type = "response"), col = "#2C5AA0", lwd = 2)
legend("topleft", c("lm", "logistic"), col = c("#D97706", "#2C5AA0"),
       lwd = 2, bty = "n")
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Kurba logjistike (blu) qëndron gjithmonë në $[0,1]$.
    \item<2-> Afër 0 deri rreth 1200 \$, rritet shpejt midis 1500 dhe 2300 \$, afrohet te 1.
    \item<3-> Kjo është forma S që pamë në tabelë.
    \item<4-> Ora 2: si ndërtohet kjo kurbë dhe si vlerësohen parametrat.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Probabilitetet e parashikuara}
<<h1-pred>>=
round(predict(fit_glm, data.frame(balance = c(1000, 1500, 2000, 2500)),
              type = "response"), 3)
round(coef(fit_glm), 6)
@
  \begin{itemize}
    \item<2-> 1000 \$: 0.6\%; 1500 \$: 8.3\%; 2000 \$: 58.6\%; 2500 \$: 95.7\%.
  \end{itemize}
\end{frame}

\begin{frame}{Po kur ka më shumë se dy klasa?}
  \begin{itemize}
    \item<1-> Kodimi $1,2,3$ për ``i lehtë, i mesëm, i rëndë'' supozon distanca të barabarta.
    \item<2-> Për kategori pa renditje (p.sh.\ lloji i aksidentit), kodimi numerik nuk ka kuptim.
    \item<3-> Zgjidhje: logjistiku multinomial ose LDA (Ora 4).
  \end{itemize}
  \pause[4]
  \begin{Gabim}Regres linear mbi kode $1,2,3$ për klasa pa renditje: rezultati varet nga kodimi i zgjedhur.\end{Gabim}
\end{frame}

% ------------------------------------------------------------
\subsection{Objektivat dhe plani}
% ------------------------------------------------------------

\begin{frame}{Objektivat e javës}
  Në fund të ditës do të dini:
  \begin{itemize}
    \item \LO{K2} të formuloni regresin logjistik dhe ta interpretoni me raporte shansesh;
    \item \LO{S2} ta vlerësoni me maksimumin e përgjasisë (IRLS) dhe ta përshtatni me \texttt{glm()};
    \item \LO{S3} të vlerësoni klasifikuesit me matricën e konfuzionit, ROC, AUC dhe CV;
    \item \LO{K2} të kuptoni LDA, QDA dhe KNN dhe kur fiton secili;
    \item \LO{C1} të zgjidhni modelin dhe pragun sipas kostos së gabimeve.
  \end{itemize}
\end{frame}

