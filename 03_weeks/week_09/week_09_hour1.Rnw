% ------------------------------------------------------------
\subsection{Kujtesë e njohurive paraprake}
% ------------------------------------------------------------

\begin{frame}{Bernoulli dhe përgjasia}
  \begin{itemize}
    \item<1-> $Y\sim\text{Bernoulli}(p)$: $P(Y=y)=p^y(1-p)^{1-y}$, $y\in\{0,1\}$.
    \item<2-> $E[Y]=p$, \; $\operatorname{Var}(Y)=p(1-p)$.
    \item<3-> Për $n$ vëzhgime të pavarura: $L(p)=\prod_i p^{y_i}(1-p)^{1-y_i}$.
    \item<4-> $\log L=\sum_i\big[y_i\log p+(1-y_i)\log(1-p)\big]$; maksimumi: $\hat p=\bar y$.
  \end{itemize}
\end{frame}

\begin{frame}{Pa ndihmën e PC: përgjasia e një proporcioni}
  10 klientë, 2 default: $y=(0,0,1,0,0,0,1,0,0,0)$.
  \begin{itemize}
    \item<2-> $\log L(p)=2\log p+8\log(1-p)$.
    \item<3-> $\dfrac{d\log L}{dp}=\dfrac2p-\dfrac{8}{1-p}=0$ $\Rightarrow$ $2(1-p)=8p$ $\Rightarrow$ $\hat p=0.2$.
    \item<4-> $\log L(0.2)=2\log0.2+8\log0.8=2(-1.609)+8(-0.223)=-5.00$.
    \item<5-> $\log L(0.5)=10\log0.5=-6.93$: më e ulët. \checkmark
  \end{itemize}
\end{frame}

\begin{frame}{Shansi (\emph{odds})}
  \begin{itemize}
    \item<1-> $\text{odds}=\dfrac{p}{1-p}$: sa herë më e mundshme ``po'' se ``jo''.
    \item<2-> $p=0.2$ $\Rightarrow$ odds $=0.25$ (``1 me 4''); $p=0.5$ $\Rightarrow$ 1; $p=0.8$ $\Rightarrow$ 4.
    \item<3-> Odds $\in[0,\infty)$; $\log(\text{odds})\in(-\infty,\infty)$: kjo është ideja e logjistikut!
  \end{itemize}
\end{frame}

\begin{frame}[label=ushOdds]{Radha jote! (pa ndihmën e PC)}
  \begin{Ushtrim}[(5 minuta)]
    \begin{enumerate}
      \item Llogarit odds dhe log-odds për $p=0.1,\ 0.5,\ 0.9$. ($\log9=2.197$.)
      \item Nga tabela e balancës: grupi 1500--2000 ka 177 default nga 805. Cili është shansi?
      \item Grupi 2000--3000 ka 81 nga 106. Sa herë më i madh është shansi këtu?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjOdds}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=ushTPS91]{Mendo -- diskuto në çift -- ndaj}
  \begin{Ushtrim}[(5 minuta)]
    Një bankë (hipotetike) refuzon kredinë kur $\hat P(\text{default})>p^*$.
    \begin{enumerate}
      \item Çfarë ndodh me $p^*=0.5$? Po me $p^*=0.1$?
      \item Cili gabim kushton më shumë për bankën: t'i japësh kredi dikujt që nuk paguan, apo ta refuzosh dikë që do të paguante?
      \item Si duhet të ndikojë kjo te $p^*$?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjTPS91}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=pyetjeMC91]{Pyetje me zgjedhje}
  \begin{Parashiko}
    Cila është arsyeja \textbf{kryesore} pse nuk përdorim \texttt{lm()} për $y\in\{0,1\}$?
    \begin{enumerate}[A)]
      \item \texttt{lm()} nuk pranon variabla 0/1.
      \item Parashikimet mund të dalin jashtë $[0,1]$ dhe forma S nuk kapet.
      \item \texttt{lm()} jep gjithmonë $R^2$ të ulët.
      \item Koeficientët e \texttt{lm()} janë të zhvendosur nga multikolineariteti.
    \end{enumerate}
  \end{Parashiko}
  \shkoTe{zgjMC91}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Mbyllja e orës}
% ------------------------------------------------------------

\begin{frame}[label=cp91]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 1}
  \begin{enumerate}
    \item Pse saktësia 96.7\% e ``gjithmonë jo'' nuk është arritje te \texttt{Default}?
    \item Jepni dy probleme të \texttt{lm()} me $y$ binar.
    \item Sa është odds për $p=0.75$? Po log-odds?
  \end{enumerate}
  \shkoTe{zgjCp91}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje: Ora 1}
  \begin{itemize}
    \item Klasifikim: vlerëso $P(Y=1\mid x)$, pastaj vendos.
    \item \texttt{Default} (sintetike, ISLR): 3.33\% default; probabiliteti rritet në formë S me balancën.
    \item \texttt{lm} mbi 0/1: 3123 ``probabilitete'' negative; 0.25 kundrejt 0.76.
    \item Logjistiku: kurbë S brenda $[0,1]$; 2000 \$ $\Rightarrow$ 58.6\%.
    \item Odds $=p/(1-p)$; log-odds në $(-\infty,\infty)$.
  \end{itemize}
  \begin{Keshille}Ora 2: modeli logjistik, raporti i shanseve, maksimumi i përgjasisë, IRLS, testet Wald dhe LR.\end{Keshille}
\end{frame}
