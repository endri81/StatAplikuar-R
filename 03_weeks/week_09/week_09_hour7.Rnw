% ------------------------------------------------------------
\subsection{Ushtrime për shtëpi}
% ------------------------------------------------------------

\begin{frame}[label=h9H1]{Ushtrime për shtëpi 1--2}
  \begin{Ushtrim}[(Shtëpi 1: \texttt{Smarket})]
    Përsëritni QDA me \texttt{Lag1 + Lag2}, por trajnoni në 2001--2003 dhe testoni në 2004--2005. A mbetet fitorja e QDA-së?
  \end{Ushtrim}
  \begin{Ushtrim}[(Shtëpi 2: \texttt{Default})]
    Logjistik me \texttt{ns(balance, 3) + student} (Java 8). Krahasoni AUC me CV me modelin linear, me të njëjtat palosje.
  \end{Ushtrim}
  \shkoTe{s9H1}{Udhëzime}
\end{frame}

\begin{frame}[label=h9H3]{Ushtrime për shtëpi 3--4}
  \begin{Ushtrim}[(Shtëpi 3: \texttt{Caravan}, reale)]
    KNN me $K=1,3,5$ (variablat të standardizuara; test = 1000 rreshtat e parë). Llogaritni precizionin te klientët e parashikuar ``Yes''. Krahasoni me përqindjen bazë 6\%.
  \end{Ushtrim}
  \begin{Ushtrim}[(Shtëpi 4: simulim)]
    Përsëritni skenarin A të Orës 5, por me $X\mid Y$ eksponencial (jo normal). Si ndryshon renditja logjistik kundrejt LDA?
  \end{Ushtrim}
  \shkoTe{s9H3}{Udhëzime}
\end{frame}

\begin{frame}[label=h9H5]{Ushtrime për shtëpi 5--6}
  \begin{Ushtrim}[(Shtëpi 5: teori)]
    (a) Nxirrni kufirin e LDA për dy klasa. (b) Tregoni që $\partial\ell/\partial\beta=X^\top(y-p)$. (c) Tregoni që AUC = statistika Mann--Whitney / $(n_+n_-)$.
  \end{Ushtrim}
  \begin{Ushtrim}[(Shtëpi 6: \texttt{Carseats}, Zgjerim)]
    \texttt{High = Sales > 8}. Pemë me \texttt{tree()}, \texttt{cv.tree(FUN = prune.misclass)}, prerje. Krahasoni me logjistikun.
  \end{Ushtrim}
  \shkoTe{s9H5}{Udhëzime}
\end{frame}

% ------------------------------------------------------------
\subsection{Gabimet e javës}
% ------------------------------------------------------------

\begin{frame}{Gabimet e zakonshme: modeli logjistik}
  \begin{Gabim}$\beta$ interpretohet si ndryshim i probabilitetit; është ndryshim i log-odds.\end{Gabim}
  \pause
  \begin{Gabim}\texttt{predict()} pa \texttt{type = "response"}: log-odds në vend të probabiliteteve.\end{Gabim}
  \pause
  \begin{Gabim}Koeficient ``i vogël'' (0.0057) quhet efekt i vogël: varet nga njësitë.\end{Gabim}
\end{frame}

\begin{frame}{Gabimet e zakonshme: vlerësimi i klasifikuesve}
  \begin{Gabim}Saktësia si metrikë e vetme me klasë të rrallë (96.7\% e ``gjithmonë jo'').\end{Gabim}
  \pause
  \begin{Gabim}Gabimi i trajnimit si gabim testi (KNN $K=1$: 100\%).\end{Gabim}
  \pause
  \begin{Gabim}Pragu 0.5 pa menduar për kostot; pragu i zgjedhur mbi të dhënat e trajnimit.\end{Gabim}
\end{frame}

\begin{frame}{Lista e kontrollit të klasifikimit}
  \small
  \begin{enumerate}
    \item Shpërndarja e klasave: a ka klasë të rrallë? Cila është baza (``gjithmonë shumica'')?
    \item Modele kandidate: logjistik (me \texttt{ns} nëse duhet), LDA, QDA, KNN (me \texttt{scale}).
    \item CV ose test i veçantë, me \textbf{të njëjtat} palosje.
    \item AUC për renditjen; kalibrimi sipas decileve për probabilitetet.
    \item Pragu sipas kostove: $t^*=C_{FP}/(C_{FP}+C_{FN})$.
    \item Matrica e konfuzionit me $t^*$: sensitivitet, specifitet, precizion.
    \item Diagnostikim: \texttt{cooks.distance}, mbetjet (Java 7).
    \item Raporto: kostot si supozime, kufizimet.
  \end{enumerate}
\end{frame}

% ------------------------------------------------------------
\subsection{Fletë-kujtesa}
% ------------------------------------------------------------

\begin{frame}{Fletë-kujtesa 1: formulat}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    Madhësia & Formula \\ \midrule
    Logjistik & $\text{logit}(p)=x^\top\beta$; \ $p=1/(1+e^{-x^\top\beta})$; \ OR $=e^{\beta_j}$ \\
    Score, Hessian & $X^\top(y-p)$; \ $-X^\top WX$, $W=\operatorname{diag}(p(1-p))$ \\
    IRLS & $z=X\beta+W^{-1}(y-p)$; \ $\beta\leftarrow(X^\top WX)^{-1}X^\top Wz$ \\
    Inferenca & Wald $z=\hat\beta/\text{SE}$; \ LR $=\Delta D\sim\chi^2_q$ \\
    LDA & $\delta_k=x\mu_k/\sigma^2-\mu_k^2/(2\sigma^2)+\log\pi_k$ \\
    Kufiri LDA & $\frac{\mu_1+\mu_2}{2}+\frac{\sigma^2\log(\pi_1/\pi_2)}{\mu_2-\mu_1}$ \\
    Metrikat & sens $=\frac{TP}{TP+FN}$, spec $=\frac{TN}{TN+FP}$, prec $=\frac{TP}{TP+FP}$ \\
    AUC & $P(\hat p_+>\hat p_-)$ \\
    Pragu & $t^*=C_{FP}/(C_{FP}+C_{FN})$ \\ \bottomrule
  \end{tabular}
\end{frame}

\begin{frame}{Fletë-kujtesa 2: funksionet R}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    Detyra & Funksioni \\ \midrule
    Logjistik & \Rkey{glm(y \textasciitilde{} x, family = binomial)} \\
    Probabilitete & \Rkey{predict(fit, newdata, type = "response")} \\
    IB për $p$ & \Rkey{predict(\dots, se.fit = TRUE)} + \Rkey{plogis()} \\
    Testi LR & \Rkey{anova(m0, m1, test = "Chisq")} \\
    LDA, QDA & \Rkey{MASS::lda()}, \Rkey{MASS::qda()}; \Rkey{\$class}, \Rkey{\$posterior} \\
    KNN & \Rkey{class::knn(train, test, cl, k, prob = TRUE)}, \Rkey{knn.cv()} \\
    ROC, AUC & \Rkey{pROC::roc(y, p, levels =, direction = "<")}, \Rkey{auc()} \\
    CV & \Rkey{boot::cv.glm(d, fit, cost, K = 10)} \\
    Pemë, RF & \Rkey{tree::tree()}, \Rkey{cv.tree()}, \Rkey{randomForest::randomForest()} \\ \bottomrule
  \end{tabular}
\end{frame}

\begin{frame}{Fletë-kujtesa 3: cilën metodë kur}
  \small
  \begin{tabular}{@{}lll@{}}
    \toprule
    Situata & Metoda & Pse \\ \midrule
    Interpretim, OR & logjistik & koeficientë të qartë \\
    $x$ afër normal, klasa të ndara mirë & LDA & e qëndrueshme \\
    Kovarianca të ndryshme, $n$ i mjaftueshëm & QDA & kufi kuadratik \\
    Kufi i panjohur, $n$ i madh & KNN ($K$ me CV) & pa supozime \\
    Forma jolineare e një $x$ & logjistik + \texttt{ns()} & Java 8 \\
    Rregulla të lexueshme & pemë & interpretim vizual \\
    Shumë $x$, ndërveprime & random forest & variancë e ulët \\ \bottomrule
  \end{tabular}
\end{frame}

% ------------------------------------------------------------
\subsection{Pamje e Javës 10}
% ------------------------------------------------------------

\begin{frame}{Java 10: të dhënat hapësinore \LO{K3}}
  \begin{itemize}
    \item<1-> Nga ``çfarë'' dhe ``sa'' te ``\textbf{ku}'': çdo vëzhgim ka koordinata.
    \item<2-> Sistemet koordinative, projeksionet, datumet (WGS84, UTM, KRGJSH-2010 për Shqipërinë).
    \item<3-> Paketa \texttt{sf}: lexim, paraqitje, transformim i koordinatave.
    \item<4-> Të dhënat: \texttt{meuse} (metalet e rënda pranë lumit Meuse), kufijtë administrativë.
    \item<5-> Materiali është \textbf{plotësues} (nuk është në repo DS612): literatura e kursit (Chang) dhe dokumentacioni i \texttt{sf}.
  \end{itemize}
\end{frame}

\begin{frame}{Para Javës 10}
  \begin{itemize}
    \item Ushtrimet për shtëpi 1--6 (sidomos 1 dhe 3).
    \item Rishikoni: gjeometria analitike në plan, distanca euklidiane, matricat e rrotullimit.
    \item Instaloni \texttt{sf}, \texttt{terra}, \texttt{sp}, \texttt{gstat} në RStudio.
    \item Lexoni K.~Chang, \emph{Introduction to GIS}: kapitujt për sistemet koordinative dhe projeksionet.
  \end{itemize}
\end{frame}

\begin{frame}{Burime}
  \footnotesize
  \begin{itemize}
    \item E.~Raço, E.~Llagami, K.~Haxhi, O.~Zaçaj, \emph{Teoria e Probabilitetit dhe Statistika Matematike me ilustrime në gjuhën R}, Kotti, 2021 (Bernoulli, maksimumi i përgjasisë).
    \item J.~Cohen, P.~Cohen, S.~G.~West, L.~S.~Aiken, \emph{Applied Multiple Regression/Correlation Analysis for the Behavioral Sciences}, LEA, 2003 (regresi logjistik).
    \item G.~James, D.~Witten, T.~Hastie, R.~Tibshirani, \emph{An Introduction to Statistical Learning}, Springer, kap.~4, 8; \url{https://www.statlearning.com}.
    \item N.~Lo, \emph{DS612 Data Mining with Business Applications (R)}, \url{https://github.com/NormanLo4319/DS612_Data_Mining_with_Business_Applications_R} (licencë MIT): \texttt{Lecture\_4.R}, \texttt{Lecture\_5.R}, \texttt{Euclidean\_Distance.R}, \texttt{Lecture\_6.x.R}, \texttt{TreeModel\_Review.R}, \texttt{Data/Textbook\_Data/}.
    \item Paketat: \texttt{MASS}, \texttt{class}, \texttt{pROC}, \texttt{boot}, \texttt{tree}, \texttt{randomForest}.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Mbyllja e ditës}
% ------------------------------------------------------------

\begin{frame}[label=cp97]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 7}
  \begin{enumerate}
    \item Cilat janë tre gjërat e para që kontrolloni kur keni një problem klasifikimi me klasë të rrallë?
    \item Pse logjistiku dhe LDA japin shpesh rezultate të ngjashme?
    \item Kur pragu 0.5 është zgjedhja e duhur?
  \end{enumerate}
  \shkoTe{zgjCp97}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje e Javës 9}
  \begin{itemize}
    \item Logjistiku: logit, OR, MLE me IRLS, Wald dhe LR; paradoksi i studentëve.
    \item LDA, QDA, KNN: supozime të ndryshme; simulimi tregon kur fiton secila.
    \item Vlerësimi: matrica e konfuzionit, ROC/AUC, kalibrimi, CV jashtë palosjes.
    \item Vendimi: pragu $t^*=C_{FP}/(C_{FP}+C_{FN})$; te \texttt{Default} kosto $-39\%$.
    \item Zgjerim: pemët dhe RF: kompleksiteti nuk garanton fitim.
  \end{itemize}
\end{frame}
