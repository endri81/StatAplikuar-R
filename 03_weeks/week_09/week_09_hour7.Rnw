% ------------------------------------------------------------
\subsection{Kuizi në stilin e provimit}
% ------------------------------------------------------------

\begin{frame}{Kuizi: si funksionon}
  \begin{itemize}
    \item<1-> Si në provim: \textbf{25\% teori, 75\% ushtrime}; 3 pyetje teorike (25 pikë) + 7 ushtrime (75 pikë).
    \item<2-> Koha: 45 minuta. Ushtrimet 1--5 bëhen pa ndihmën e PC.
    \item<3-> Vlera të dobishme: $\log3=1.099$, $\log4=1.386$, $\log0.25=-1.386$, $e^2=7.389$, $e^{0.8}=2.226$.
  \end{itemize}
  \onslide<4->{\begin{Keshille}Te çdo koeficient logjistik: shkruani njësinë dhe interpretimin si OR.\end{Keshille}}
\end{frame}

\begin{frame}[label=q9T1]{Teori 1 (8 pikë)}
  \begin{Ushtrim}[(Teori 1)]
    \begin{enumerate}
      \item Shkruani modelin logjistik. Pse nuk përdorim \texttt{lm()} për $y\in\{0,1\}$?
      \item Interpretoni $e^{\beta_j}$. Pse efekti mbi $p$ nuk është konstant?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s9T1}{Zgjidhja}
\end{frame}

\begin{frame}[label=q9T2]{Teori 2 (8 pikë)}
  \begin{Ushtrim}[(Teori 2)]
    \begin{enumerate}
      \item Shkruani score-in dhe Hessianin; përshkruani IRLS.
      \item Dalloni testin Wald nga testi LR. Çfarë është deviance?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s9T2}{Zgjidhja}
\end{frame}

\begin{frame}[label=q9T3]{Teori 3 (9 pikë)}
  \begin{Ushtrim}[(Teori 3)]
    \begin{enumerate}
      \item Krahasoni supozimet e LDA, QDA dhe KNN.
      \item Çfarë mat AUC? Pse saktësia mashtron me klasa të pabalancuara?
      \item Nxirrni pragun optimal $t^*$ për kosto $C_{FN}$ dhe $C_{FP}$.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s9T3}{Zgjidhja}
\end{frame}

\begin{frame}[label=q9E1]{Ushtrimi 1 (10 pikë): tabela $2\times2$}
  \begin{Ushtrim}[(Ushtrimi 1, pa ndihmën e PC)]
    \begin{center}\small
    \begin{tabular}{lcc}
      \toprule & $y=1$ & $y=0$\\ \midrule
      $x=0$ & 6 & 24\\
      $x=1$ & 9 & 9\\ \bottomrule
    \end{tabular}
    \end{center}
    \begin{enumerate}
      \item Llogaritni $\hat\beta_0$, $\hat\beta_1$ dhe OR.
      \item SE e $\hat\beta_1$ dhe statistika Wald $z$. A refuzohet $H_0$ në 5\%?
      \item $\hat p$ për $x=0$ dhe $x=1$ nga modeli.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s9E1}{Zgjidhja}
\end{frame}

\begin{frame}[label=q9E2]{Ushtrimi 2 (10 pikë): interpretimi}
  \begin{Ushtrim}[(Ushtrimi 2, pa ndihmën e PC)]
    $\text{logit}(p)=-4+0.8x$.
    \begin{enumerate}
      \item $\hat p$ për $x=5$ dhe $x=2.5$.
      \item OR për $+1$ njësi dhe për $+2$ njësi të $x$.
      \item Sa është ndryshimi maksimal i $p$ për $+1$ njësi (rregulli i pjesëtimit me 4)? Për cilin $x$ arrihet?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s9E2}{Zgjidhja}
\end{frame}

\begin{frame}[label=q9E3]{Ushtrimi 3 (10 pikë): matrica e konfuzionit}
  \begin{Ushtrim}[(Ushtrimi 3, pa ndihmën e PC)]
    1000 pjesë të prodhuara (hipotetike), 50 me defekt. Modeli: TP $=40$, FN $=10$, FP $=30$, TN $=920$.
    \begin{enumerate}
      \item Saktësia, sensitiviteti, specifiteti, precizioni ($TP/(TP+FP)$).
      \item Saktësia e rregullit ``asnjë defekt''. A është modeli i dobishëm?
      \item Nëse pragu ulet, çfarë pritet për secilën metrikë?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s9E3}{Zgjidhja}
\end{frame}

\begin{frame}[label=q9E4]{Ushtrimi 4 (10 pikë): LDA}
  \begin{Ushtrim}[(Ushtrimi 4, pa ndihmën e PC)]
    $\mu_1=10$, $\mu_2=16$, $\sigma^2=9$, $\pi_1=0.75$, $\pi_2=0.25$.
    \begin{enumerate}
      \item Kufiri me priorë të barabartë.
      \item Kufiri me priorët e dhënë.
      \item Si klasifikohet $x=14$ në secilin rast?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s9E4}{Zgjidhja}
\end{frame}

\begin{frame}[label=q9E5]{Ushtrimi 5 (10 pikë): AUC dhe pragu}
  \begin{Ushtrim}[(Ushtrimi 5, pa ndihmën e PC)]
    Pozitivë: $\hat p=(0.9,\,0.4)$; negativë: $\hat p=(0.6,\,0.3,\,0.2)$.
    \begin{enumerate}
      \item AUC me metodën e çifteve.
      \item TPR dhe FPR me pragun 0.5.
      \item Kostot: $C_{FN}=4$, $C_{FP}=1$. Cili është $t^*$? Si klasifikohen 5 pikat?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s9E5}{Zgjidhja}
\end{frame}

\begin{frame}[fragile,shrink=12,label=q9E6]{Ushtrimi 6 (10 pikë): lexo output-in}
<<quiz9-glm, echo=FALSE>>=
dq <- read.csv(file.path(W09DATA, "Default.csv"), stringsAsFactors = TRUE)
gq <- glm(default ~ balance + student, data = dq, family = binomial)
round(coef(summary(gq)), 5)
c(null_deviance = round(gq$null.deviance, 1), deviance = round(gq$deviance, 1),
  df_diff = 2)
@
  \small
  \begin{enumerate}
    \item Interpretoni \texttt{balance} si OR për +100 \$ ($e^{0.574}=1.78$) dhe \texttt{studentYes} ($e^{-0.715}=0.49$).
    \item Testi LR global: statistika dhe vendimi ($\chi^2_{2;0.95}=5.99$).
    \item Pse \texttt{studentYes} është negativ, ndërsa studentët kanë default më shpesh?
  \end{enumerate}
  \shkoTe{s9E6}{Zgjidhja}
\end{frame}

\begin{frame}[label=q9E7]{Ushtrimi 7 (15 pikë): zgjedhja e modelit dhe e pragut}
  \small
  Rezultatet nga Ora 6 (10-fold CV jashtë palosjes, \texttt{Default}; kostot FN:FP $=10{:}1$):
  \begin{center}
    \begin{tabular}{lccc}
      \toprule Modeli & AUC & kosto ($t=0.5$) & kosto ($t=1/11$)\\ \midrule
      logjistik & 0.949 & 0.232 & 0.142\\
      LDA & 0.949 & 0.253 & 0.145\\
      QDA & 0.949 & 0.246 & 0.144\\
      KNN-50 & 0.929 & 0.254 & 0.148\\ \bottomrule
    \end{tabular}
  \end{center}
  \begin{enumerate}
    \item Cilin model dhe cilin prag rekomandoni? Pse?
    \item Pse diferenca midis pragjeve është më e madhe se midis modeleve?
    \item Random forest dha AUC 0.862 në test. Jepni dy arsye të mundshme.
  \end{enumerate}
  \shkoTe{s9E7}{Zgjidhja}
\end{frame}

