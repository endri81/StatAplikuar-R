\section[R Lab II]{R Lab II: LDA, QDA, KNN, ROC}

\begin{frame}{Ora 5: R Lab II --- LDA, QDA, KNN, ROC}
  \tableofcontents[currentsection,hideothersubsections,sectionstyle=show/hide]
