\subsection{Mbyllja e ditës}
% ------------------------------------------------------------

\begin{frame}[label=cp107]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 7}
  \begin{enumerate}
    \item Cilat janë tre kontrollet e para që bëni kur merrni një shtresë hapësinore të re?
    \item Pse nuk ekziston projeksion ``më i mirë'' për gjithçka?
    \item Si lidhet autokorrelacioni i mbetjeve në \texttt{meuse} me Javën 12?
  \end{enumerate}
  \shkoTe{zgjCp107}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje e Javës 10}
  \begin{itemize}
    \item Toka: gjeoid, elipsoid (WGS 84, GRS 80), datum; Albanian 1987 $\to$ WGS 84: 141 m.
    \item Distanca: haversine; sferë kundrejt elipsoidit $<0.3\%$; kurrë Euklidi mbi gradë.
    \item \texttt{sf}: \texttt{sfg} $\to$ \texttt{sfc} $\to$ \texttt{sf}; vlefshmëria, kallëzuesit, buffer.
    \item Projeksionet: konform kundrejt ekuivalent; TM/UTM; Albania TM 2010 (EPSG:6870) gabon $<52$ ppm.
    \item CRS-ja ndryshon përfundimet: renditja e dendësive në Web Mercator; mbetjet e \texttt{meuse} të korreluara.
  \end{itemize}
  \LO{K3, S1, S3, S4, C1}
\end{frame}
