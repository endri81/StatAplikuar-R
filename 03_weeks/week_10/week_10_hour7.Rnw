% ------------------------------------------------------------
\subsection{Kuizi në stilin e provimit}
% ------------------------------------------------------------

\begin{frame}{Kuizi: si funksionon}
  \begin{itemize}
    \item<1-> Si në provim: \textbf{25\% teori, 75\% ushtrime}; 3 pyetje teorike (25 pikë) + 7 ushtrime (75 pikë).
    \item<2-> Koha: 45 minuta. Ushtrimet 1--5 bëhen pa ndihmën e PC.
    \item<3-> Vlera të dobishme: $R=6371$ km; $\pi/180=0.017453$; $\cos40^\circ=0.7660$; $\cos42^\circ=0.7431$; $\sin0.5^\circ=0.008727$.
  \end{itemize}
  \onslide<4->{\begin{Keshille}Te çdo rezultat numerik: shkruani njësinë (gradë, m, km, km$^2$, ppm).\end{Keshille}}
\end{frame}

\begin{frame}[label=q10T1]{Teori 1 (8 pikë)}
  \begin{Ushtrim}[(Teori 1)]
    \begin{enumerate}
      \item Dalloni gjeoidin, elipsoidin dhe datumin. Pse të njëjtat $(\lambda,\varphi)$ në dy datume janë pika të ndryshme?
      \item Shkruani kushtet për projeksion konform dhe ekuivalent me faktorët e shkallës $h$ dhe $k$.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s10T1}{Zgjidhja}
\end{frame}

\begin{frame}[label=q10T2]{Teori 2 (8 pikë)}
  \begin{Ushtrim}[(Teori 2)]
    \begin{enumerate}
      \item Përshkruani objektet \texttt{sfg}, \texttt{sfc}, \texttt{sf}. Ku ruhet CRS-ja?
      \item Dalloni \texttt{st\_set\_crs()} nga \texttt{st\_transform()}. Jepni një shembull ku përdorimi i gabuar çon në gabim prej qindra kilometrash.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s10T2}{Zgjidhja}
\end{frame}

\begin{frame}[label=q10T3]{Teori 3 (9 pikë)}
  \begin{Ushtrim}[(Teori 3)]
    \begin{enumerate}
      \item Nxirrni $y(\varphi)$ për Mercatorin nga kushti $h=k$.
      \item Pse UTM përdor $k_0=0.9996$? Ku është $k=1$?
      \item Pse Web Mercator nuk duhet përdorur për dendësi popullsie?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s10T3}{Zgjidhja}
\end{frame}

\begin{frame}[label=q10E1]{Ushtrimi 1 (10 pikë): DMS}
  \begin{Ushtrim}[(Ushtrimi 1, pa ndihmën e PC)]
    \begin{enumerate}
      \item Ktheni Korçën $(20.781^\circ, 40.619^\circ)$: gjerësinë në DMS.
      \item Ktheni $19^\circ28'58.8''$ në gradë dhjetore.
      \item Sa metra në terren është $1''$ gjerësi? Po $1''$ gjatësi në $42^\circ$V?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s10E1}{Zgjidhja}
\end{frame}

\begin{frame}[label=q10E2]{Ushtrimi 2 (10 pikë): gradë dhe kilometra}
  \begin{Ushtrim}[(Ushtrimi 2, pa ndihmën e PC)]
    Pikat $P=(19.5^\circ, 42.0^\circ)$ dhe $Q=(20.0^\circ, 42.3^\circ)$.
    \begin{enumerate}
      \item Llogaritni ``distancën'' $\sqrt{\Delta\lambda^2+\Delta\varphi^2}\cdot111.2$ km.
      \item Korrigjoni: $\Delta x=\Delta\lambda\cdot111.2\cos42^\circ$, $\Delta y=\Delta\varphi\cdot111.2$. Distanca?
      \item Sa përqind gabon (1) kundrejt (2)?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s10E2}{Zgjidhja}
\end{frame}

\begin{frame}[label=q10E3]{Ushtrimi 3 (10 pikë): haversine}
  \begin{Ushtrim}[(Ushtrimi 3, pa ndihmën e PC)]
    Pikat $(20^\circ, 40^\circ)$ dhe $(21^\circ, 40^\circ)$, $R=6371$ km.
    \begin{enumerate}
      \item Llogaritni distancën me haversine.
      \item Llogaritni gjatësinë e harkut përgjatë paralelit $40^\circ$.
      \item Cila është më e shkurtër dhe pse?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s10E3}{Zgjidhja}
\end{frame}

\begin{frame}[label=q10E4]{Ushtrimi 4 (10 pikë): formula e lidhëzës}
  \begin{Ushtrim}[(Ushtrimi 4, pa ndihmën e PC)]
    Një parcelë në Albania TM ka kulmet (në metra, relativisht nga një pikë referimi):
    $(0,0)$, $(300,0)$, $(300,200)$, $(100,300)$.
    \begin{enumerate}
      \item Llogaritni sipërfaqen në m$^2$ dhe në hektarë.
      \item Shkruani kodin \texttt{sf} që e verifikon.
      \item Pse kjo sipërfaqe është praktikisht e saktë në terren?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s10E4}{Zgjidhja}
\end{frame}

\begin{frame}[label=q10E5]{Ushtrimi 5 (10 pikë): projeksionet}
  \begin{Ushtrim}[(Ushtrimi 5, pa ndihmën e PC)]
    \begin{enumerate}
      \item Gjeni zonën UTM dhe $\lambda_0$ për Vlorën ($19.48^\circ$), Shkupin ($21.43^\circ$), Athinën ($23.73^\circ$).
      \item Në Albania TM ($k_0=1$), sa është $k$ 100 km larg $\lambda_0$? Sa gabon një distancë 10 km atje?
      \item Një rajon në $45^\circ$V del 1000 km$^2$ në Web Mercator. Sa është sipërfaqja reale?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s10E5}{Zgjidhja}
\end{frame}

\begin{frame}[label=q10E6]{Ushtrimi 6 (10 pikë): lexo output-in}
  \begin{Ushtrim}[(Ushtrimi 6)]
    Sipërfaqja e Shqipërisë (1:50m) në pesë CRS, si raport me Albania TM:
    \begin{center}\small
    \begin{tabular}{lccccc}
      \toprule
      CRS & A & B & C & D & E \\ \midrule
      raporti & 1.765 & 0.999 & 1.329 & 0.958 & 1.000 \\ \bottomrule
    \end{tabular}
    \end{center}
    Çiftoni me: UTM 34N, LAEA Europe, plate carrée (4087), Web Mercator (3857), LCC Europe (3034). Arsyetoni çdo çift me faktorët e shkallës.
  \end{Ushtrim}
  \shkoTe{s10E6}{Zgjidhja}
\end{frame}

\begin{frame}[label=q10E7]{Ushtrimi 7 (15 pikë): projekt i vogël}
  \begin{Ushtrim}[(Ushtrimi 7)]
    \small
    Keni: (a) shapefile i bashkive në Albanian 1987 / Gauss--Krüger (EPSG:2462); (b) CSV me koordinata GPS (WGS 84) të shkollave; (c) CSV me popullsinë sipas bashkive.
    \begin{enumerate}
      \item Shkruani hapat \texttt{sf} për: numrin e shkollave për bashki dhe shkolla për 10\,000 banorë.
      \item Në cilin CRS llogaritni sipërfaqet dhe distancat? Pse?
      \item Përmendni tre gabime që mund të ndodhin dhe si i parandaloni.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s10E7}{Zgjidhja}
\end{frame}

