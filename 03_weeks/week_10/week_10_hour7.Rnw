% ------------------------------------------------------------
\subsection{Ushtrime për shtëpi}
% ------------------------------------------------------------

\begin{frame}[label=h10H1]{Ushtrime për shtëpi 1--2}
  \begin{Ushtrim}[(Shtëpi 1: distancat)]
    Llogaritni me \texttt{haversine()} (Ora 2) të 15 distancat midis 6 qyteteve. Krahasoni me \texttt{st\_distance()} me \texttt{s2} dhe pa \texttt{s2}. Raportoni gabimin relativ maksimal.
  \end{Ushtrim}
  \begin{Ushtrim}[(Shtëpi 2: sipërfaqet)]
    Shkruani një funksion që llogarit sipërfaqen e një \texttt{MULTIPOLYGON} me formulën e lidhëzës (kujdes me vrimat dhe pjesët). Testojeni te Shqipëria në 6870 kundrejt \texttt{st\_area()}.
  \end{Ushtrim}
  \shkoTe{s10H1}{Udhëzime}
\end{frame}

\begin{frame}[label=h10H3]{Ushtrime për shtëpi 3--4}
  \begin{Ushtrim}[(Shtëpi 3: TM për Kosovën)]
    Përsëritni simulimin e Orës 5 për Kosovën (500 çifte). Gjeni $\lambda_0$ që minimizon gabimin maksimal. Krahasoni me UTM 34N.
  \end{Ushtrim}
  \begin{Ushtrim}[(Shtëpi 4: \texttt{meuse})]
    Përsëritni Rastin C të Orës 6 për \texttt{copper} dhe \texttt{lead}. Cili metal ka autokorrelacionin më të fortë në mbetje?
  \end{Ushtrim}
  \shkoTe{s10H3}{Udhëzime}
\end{frame}

\begin{frame}[label=h10H5]{Ushtrime për shtëpi 5--6}
  \begin{Ushtrim}[(Shtëpi 5: teori)]
    (a) Tregoni që $y=R\sin\varphi$ jep $hk=1$. (b) Llogaritni sipërfaqen e brezit $0\le\varphi\le\varphi_1$ në sferë dhe në hartë; tregoni që përputhen.
  \end{Ushtrim}
  \begin{Ushtrim}[(Shtëpi 6: Zgjerim)]
    Vlerësoni numerikisht $h$ dhe $k$ të Mollweide në $(0^\circ,60^\circ)$ me diferenca të fundme: projektoni pika $10^{-4}$ gradë larg në L dhe në V. Kontrolloni $hk\approx1$.
  \end{Ushtrim}
  \shkoTe{s10H5}{Udhëzime}
\end{frame}

% ------------------------------------------------------------
\subsection{Gabimet e javës}
% ------------------------------------------------------------

\begin{frame}{Gabimet e zakonshme: koordinatat}
  \begin{Gabim}Rendi (lat, lon) në vend të (lon, lat): Tirana përfundon në Arabinë Saudite (lon 41.3, lat 19.8).\end{Gabim}
  \pause
  \begin{Gabim}Gradë në \texttt{sin()}/\texttt{cos()} pa \texttt{pi/180}.\end{Gabim}
  \pause
  \begin{Gabim}Distanca Euklidiane mbi (lon, lat): në Shqipëri gabim deri $\approx35\%$ në drejtimin L--P.\end{Gabim}
\end{frame}

\begin{frame}{Gabimet e zakonshme: CRS dhe projeksionet}
  \begin{Gabim}\texttt{st\_set\_crs()} për të ``transformuar'': numrat mbeten, pika zhvendoset qindra km.\end{Gabim}
  \pause
  \begin{Gabim}Sipërfaqe dhe dendësi në Web Mercator: $\times1.7$--$1.85$ në Shqipëri, renditja ndryshon.\end{Gabim}
  \pause
  \begin{Gabim}Mungesa e CRS-së në CSV: koordinata ``jetime'' që askush nuk i interpreton dot pas një viti.\end{Gabim}
\end{frame}

\begin{frame}{Lista e kontrollit të të dhënave hapësinore}
  \begin{enumerate}
    \item<1-> \texttt{st\_crs(x)}: a është i njohur dhe i saktë? (krahaso me metadata)
    \item<2-> \texttt{st\_is\_valid(x)}: a ka gjeometri të pavlefshme?
    \item<3-> Vizatoni shpejt: a bie gjithçka aty ku duhet?
    \item<4-> Para çdo operacioni binar: \texttt{st\_crs(a) == st\_crs(b)}.
    \item<5-> Matje: në CRS të projektuar lokal (6870) ose ekuivalent (3035) për sipërfaqe.
    \item<6-> Hartë: burimi, viti, CRS, shkalla.
  \end{enumerate}
\end{frame}

% ------------------------------------------------------------
\subsection{Fletë-kujtesa}
% ------------------------------------------------------------

\begin{frame}{Fletë-kujtesa 1: formulat}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    Koncepti & Formula \\ \midrule
    Elipsoidi & $b=a(1-f)$, \; $e^2=2f-f^2$ \\
    $1^\circ$ në sferë & gjerësi $R\pi/180\approx111.2$ km; gjatësi $111.2\cos\varphi$ \\
    Haversine & $d=2R\arcsin\sqrt{\operatorname{hav}\Delta\varphi+\cos\varphi_1\cos\varphi_2\operatorname{hav}\Delta\lambda}$ \\
    Lidhëza & $A=\tfrac12|\sum(x_iy_{i+1}-x_{i+1}y_i)|$ \\
    Konform / ekuivalent & $h=k$ \; / \; $hk=1$ \\
    Mercator & $y=R\ln\tan(\pi/4+\varphi/2)$, sipërfaqe $\times\sec^2\varphi$ \\
    TM & $k\approx k_0(1+x^2/2R^2)$ \\
    UTM & $z=\lfloor(\lambda+180)/6\rfloor+1$, \; $\lambda_0=6z-183$ \\ \bottomrule
  \end{tabular}
\end{frame}

\begin{frame}{Fletë-kujtesa 2: funksionet R}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    Detyra & Funksioni \\ \midrule
    Krijo & \texttt{st\_point}, \texttt{st\_polygon}, \texttt{st\_sfc(crs=)}, \texttt{st\_as\_sf(coords=, crs=)} \\
    Lexo / shkruaj & \texttt{st\_read}, \texttt{st\_write} (\texttt{.gpkg}) \\
    CRS & \texttt{st\_crs}, \texttt{st\_set\_crs}, \texttt{st\_transform} \\
    Mat & \texttt{st\_area}, \texttt{st\_length}, \texttt{st\_distance} \\
    Gjeometri & \texttt{st\_buffer}, \texttt{st\_centroid}, \texttt{st\_make\_grid}, \texttt{st\_sample} \\
    Kallëzues & \texttt{st\_intersects}, \texttt{st\_within}, \texttt{st\_touches} \\
    Kontroll & \texttt{st\_is\_valid}, \texttt{st\_make\_valid}, \texttt{sf\_use\_s2} \\
    Hartë & \texttt{geom\_sf}, \texttt{coord\_sf(crs=)}, \texttt{annotation\_scale} \\ \bottomrule
  \end{tabular}
\end{frame}

\begin{frame}{Fletë-kujtesa 3: cilin CRS kur}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    Situata & CRS \\ \midrule
    Ruajtje, shkëmbim, GPS & 4326 (WGS 84) \\
    Distanca, buffer, Kriging në Shqipëri & 6870 (Albania TM 2010) \\
    Shqipëri + fqinjët e lindjes & 32634 (UTM 34N) \\
    Sipërfaqe, dendësi, grid statistikor Europe & 3035 (LAEA Europe) \\
    Të dhëna të vjetra kadastrale & 2462 (Albanian 1987 / GK zona 4) \\
    Vetëm shfaqje web & 3857 (Web Mercator) \\ \bottomrule
  \end{tabular}
\end{frame}

% ------------------------------------------------------------
\subsection{Pamje e Javës 11}
% ------------------------------------------------------------

\begin{frame}{Java 11: raster dhe vektor \LO{K3, S4}}
  \begin{itemize}
    \item<1-> Modeli vektor (\texttt{sf}) kundrejt modelit raster (\texttt{terra}): pika/vija/poligone kundrejt qelizave.
    \item<2-> Shapefile, GeoPackage, GeoTIFF: struktura, atributet, editimi.
    \item<3-> Operacione: prerje, maskë, \emph{zonal statistics}, rasterizim, vektorizim.
    \item<4-> Modeli dixhital i terrenit (DTM): pjerrësia, ekspozicioni, hija.
  \end{itemize}
\end{frame}

\begin{frame}{Para Javës 11}
  \begin{itemize}
    \item Kontrolloni që \texttt{terra} ngarkohet: \texttt{library(terra); terra::gdal()}.
    \item Përsëritni: \texttt{st\_transform}, \texttt{st\_crs}, \texttt{st\_intersects}.
    \item Ushtrimi i shtëpisë 4 (\texttt{meuse}) do të përdoret në Javën 12.
  \end{itemize}
\end{frame}

\begin{frame}{Burime}
  \footnotesize
  \begin{itemize}
    \item K.-T.~Chang, \emph{Introduction to Geographic Information Systems}, McGraw-Hill, 2012 (sistemet koordinative, projeksionet).
    \item E.~Pebesma, R.~Bivand, \emph{Spatial Data Science: With Applications in R}, CRC, 2023; \url{https://r-spatial.org/book}.
    \item R.~Lovelace, J.~Nowosad, J.~Muenchow, \emph{Geocomputation with R}, 2nd ed., CRC; \url{https://r.geocompx.org}.
    \item J.~P.~Snyder, \emph{Map Projections --- A Working Manual}, USGS Professional Paper 1395, 1987.
    \item Të dhënat: Natural Earth (\url{https://www.naturalearthdata.com}); GeoNames (CC BY 4.0); \texttt{sp::meuse}, \texttt{sp::meuse.riv}.
    \item Paketat: \texttt{sf}, \texttt{s2}, \texttt{lwgeom}, \texttt{ggplot2}, \texttt{ggspatial}, \texttt{patchwork}, \texttt{rnaturalearthdata}; PROJ, GDAL, GEOS; regjistri EPSG.
    \item Repo DS612 nuk mbulon të dhënat hapësinore: e gjithë java është \textbf{material plotësues}.
  \end{itemize}
\end{frame}

