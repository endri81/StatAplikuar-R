\subsection{Mbyllja e orës}
% ------------------------------------------------------------

\begin{frame}[label=cp23]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 3}
  \begin{enumerate}
    \item Pse \texttt{1:length(v)} është i rrezikshëm? Çfarë përdorim në vend të tij?
    \item Pse formula $\big(\sum x_i^2 - n\bar x^2\big)/(n-1)$ mund të japë rezultat të gabuar?
    \item Si e testojmë që \texttt{my\_median()} është i saktë?
  \end{enumerate}
  \shkoTe{zgjCp23}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje: Ora 3}
  \begin{itemize}
    \item Funksionet: emri, argumentet, trupi; objektet brenda janë lokale; \Rkey{stopifnot()}.
    \item Ciklet \texttt{for} me \Rkey{seq\_along()} dhe vektor të para-alokuar; zgjidhja e vektorizuar shpesh është më e mirë.
    \item Ndërtuam nga zero: mesataren, variancën, medianën, kuantilin e tipit 7, MAD-in, IQR-në.
    \item Testim me 1\,000 vektorë të rastit dhe \Rkey{all.equal()}.
  \end{itemize}
  \begin{Keshille}Ora 4: forma e shpërndarjes, anshmëria, kurtoza dhe vlerat e skajshme.\end{Keshille}
\end{frame}
