\begin{frame}{Shkallët e matjes}
  \footnotesize
  \begin{tabular}{@{}llll@{}}
    \toprule
    Shkalla & Çfarë ka kuptim & Shembull & Statistika e lejuar \\ \midrule
    Nominale & $=$, $\neq$ & gjendja civile & moda, frekuencat \\
    Rendore & $<$, $>$ & arsimi (5 nivele) & + mediana, kuantilet \\
    Intervalore & diferencat & temperatura në °C, viti & + mesatarja, $s$ \\
    Raporti & raportet, zero e vërtetë & paga, mosha & + koeficienti i variacionit \\ \bottomrule
  \end{tabular}
  \vspace{6pt}
  \normalsize
  \begin{itemize}
    \item Çdo shkallë lejon edhe statistikat e shkallëve sipër saj.
    \item Pse 20 °C nuk është ``dy herë më ngrohtë'' se 10 °C? Sepse 0 °C nuk është mungesë temperature.
  \end{itemize}
\end{frame}

\begin{frame}{Variablat e \texttt{Wage} sipas shkallës}
  \begin{columns}[T]
    \column{0.5\textwidth}
      \begin{block}{Cilësore}
        \texttt{maritl}: nominale\\
        \texttt{jobclass}: nominale\\
        \texttt{education}: rendore
      \end{block}
    \column{0.5\textwidth}
      \begin{block}{Sasiore}
        \texttt{year}: intervalore\\
        \texttt{age}: raporti\\
        \texttt{wage}: raporti
      \end{block}
  \end{columns}
  \vspace{6pt}
  \begin{itemize}
    \item Në skedar, \texttt{education} ruhet si tekst me numër para: ``1.~<~HS Grad'', \dots, ``5.~Advanced Degree''.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Gabim i zakonshëm: mesatarja e kodeve}
<<edu-code>>=
edu_code <- as.integer(substr(wage$education, 1, 1))  # first character: 1..5
mean(edu_code)        # computable, but is it meaningful?
@
  \begin{Gabim}
    ``Niveli mesatar i arsimit është \Sexpr{fmt(mean(edu_code), 2)}'' supozon që distanca 1$\to$2 është e barabartë me 4$\to$5. Për variabla rendore raporto medianën ose frekuencat.
  \end{Gabim}
\end{frame}

\begin{frame}[label=ushShk]{Radha jote!}
  \begin{Ushtrim}[(3 minuta)]
    Përcaktoni shkallën e matjes për secilën variabël:
    \begin{enumerate}
      \item kodi postar i bashkisë;
      \item vlerësimi i shërbimit: ``i dobët'', ``mesatar'', ``i mirë'';
      \item sipërfaqja e banesës në m²;
      \item temperatura mesatare ditore në Korçë (°C);
      \item numri i anëtarëve të familjes.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjShk}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[fragile]{Faktor i renditur në R}
<<edu-ordered>>=
wage$education <- factor(wage$education, ordered = TRUE)
levels(wage$education)
table(wage$education)
@
\end{frame}

\begin{frame}[fragile]{Çfarë na tregon?}
<<edu-median>>=
levels(wage$education)[median(as.integer(wage$education))]
@
  \begin{itemize}
    \item Mediana e arsimit bie te niveli i tretë, ``Some College'': të paktën gjysma e punëtorëve kanë këtë nivel ose më pak.
    \item \texttt{ordered = TRUE} lejon krahasime: \texttt{wage\$education > "2. HS Grad"}.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Funksioni i shpërndarjes dhe kuantilet}
% ------------------------------------------------------------

\begin{frame}{Funksioni i shpërndarjes}
  \begin{Definicion}[(Funksioni i shpërndarjes)]
    \[ F(x) = P(X\le x),\qquad x\in\mathbb R \]
  \end{Definicion}
  \pause
  \begin{itemize}
    \item Jo-zbritës, nga 0 në 1.
    \pause
    \item Përgjigjet pyetjes: ``çfarë pjese e popullatës ka vlerë deri në $x$?''
  \end{itemize}
\end{frame}

\begin{frame}{Funksioni empirik i shpërndarjes}
  \begin{columns}[c]
    \column{0.52\textwidth}
      \begin{Definicion}[(ECDF)]
        \[ F_n(x)=\frac{\#\{i:\ x_i\le x\}}{n} \]
      \end{Definicion}
      \begin{itemize}
        \item Shkallë: kërcen me $1/n$ në çdo vrojtim.
      \end{itemize}
    \column{0.46\textwidth}
      \begin{tikzpicture}
        \begin{axis}[width=\textwidth,height=4.2cm,xmin=0,xmax=12,ymin=0,ymax=1.1,
          xlabel={$x$},ylabel={$F_n(x)$},axis lines=left,ticklabel style={font=\scriptsize},
          ytick={0,0.2,0.6,0.8,1}]
          \addplot[uptmid,very thick,const plot] coordinates {(0,0) (2,0.2) (4,0.6) (5,0.8) (10,1) (12,1)};
          \addplot[only marks,mark=*,uptmid] coordinates {(2,0.2) (4,0.6) (5,0.8) (10,1)};
        \end{axis}
      \end{tikzpicture}
  \end{columns}
  \centering\footnotesize Për $x = (2,4,4,5,10)$.
\end{frame}

\begin{frame}{Shembull pa ndihmën e PC}
  $x = (2,\ 4,\ 4,\ 5,\ 10)$, \ $n=5$.
  \pause
  \begin{itemize}
    \item $F_n(1) = 0/5 = 0$.
    \pause
    \item $F_n(4) = 3/5 = 0.6$: tri vlera janë $\le 4$ (vlera 4 numërohet dy herë).
    \pause
    \item $F_n(7) = 4/5 = 0.8$.
    \pause
    \item $F_n(10) = 5/5 = 1$.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Kontrolli me R}
<<ecdf>>=
x <- c(2, 4, 4, 5, 10)
Fn <- ecdf(x)          # returns a function
Fn(c(1, 4, 7, 10))
@
  \begin{itemize}
    \item \texttt{ecdf()} kthen një \textbf{funksion}: e thërrasim si çdo funksion tjetër.
  \end{itemize}
\end{frame}

\begin{frame}{Kuantili}
  \begin{Definicion}[(Kuantili i rendit $p$)]
    \[ q_p = \min\{x:\ F(x)\ge p\},\qquad 0<p<1 \]
  \end{Definicion}
  \pause
  \begin{itemize}
    \item Mediana $= q_{0.5}$; kuartilet $Q_1 = q_{0.25}$, $Q_3 = q_{0.75}$.
    \pause
    \item Përqindëshat: $q_{0.10}$ = P10, $q_{0.90}$ = P90.
    \pause
    \item Interpretim: $q_{0.9}$ e pagave = paga nën të cilën janë 90\% e punëtorëve.
  \end{itemize}
\end{frame}

\begin{frame}{Mediana kur $n$ është çift}
  \begin{itemize}
    \item $n$ tek: mediana është vlera në pozicionin $(n+1)/2$ pas renditjes.
    \pause
    \item $n$ çift: mesatarja e dy vlerave në mes, pozicionet $n/2$ dhe $n/2+1$.
  \end{itemize}
  \pause
  \begin{Shembull}
    $(3,\ 7,\ 8,\ 12)$: mediana $= (7+8)/2 = 7.5$.
  \end{Shembull}
  \begin{Keshille}Për kuartilet ka disa përkufizime. Në Orën 2 shohim pse R jep 9 tipa.\end{Keshille}
\end{frame}

\begin{frame}[fragile,label=pyetjeMed]{Parashiko para se ta ekzekutosh}
<<med-q, eval=FALSE>>=
median(c(20, 1, 8, 3))
@
  \begin{Parashiko}
    Çfarë kthen R?\\[3pt]
    \textbf{A)} 8 \quad \textbf{B)} 5.5 \quad \textbf{C)} 4.5 \quad \textbf{D)} 8 dhe 1
  \end{Parashiko}
  \shkoTe{zgjMed}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Pamja e parë e pagave}
% ------------------------------------------------------------

\begin{frame}[fragile]{Kuantilet e pagave}
<<wage-q>>=
summary(wage$wage)
quantile(wage$wage, probs = c(0.10, 0.50, 0.90))
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> 10\% e punëtorëve fitojnë nën \Sexpr{fmt(quantile(wage$wage, 0.1), 1)} mijë \$; 10\% fitojnë mbi \Sexpr{fmt(quantile(wage$wage, 0.9), 1)}.
    \item<2-> Raporti P90/P10 $=\Sexpr{fmt(quantile(wage$wage, 0.9) / quantile(wage$wage, 0.1), 2)}$: një masë e thjeshtë e pabarazisë.
    \item<3-> Raporti nuk varet nga vlerat ekstreme mbi P90.
  \end{itemize}
  \onslide<4->{\begin{Keshille}OECD dhe Eurostat përdorin raporte përqindëshash (P90/P10, P50/P10) për pabarazinë e pagave.\end{Keshille}}
\end{frame}

\begin{frame}[fragile]{Paga sipas nivelit të arsimit}
<<wage-edu, echo=FALSE, fig.height=3.1>>=
ggplot(wage, aes(x = as.integer(education), y = wage, group = education)) +
  geom_boxplot(fill = "#E8EEF7", colour = "#2C5AA0", outlier.alpha = 0.3) +
  scale_x_continuous(breaks = 1:5,
                     labels = c("< HS", "HS", "Some coll.", "College", "Advanced")) +
  labs(x = "Education", y = "Wage (thousand USD)") + theme_minimal(base_size = 13)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Mediana e pagës rritet me çdo nivel arsimi: nga \Sexpr{fmt(median(wage$wage[as.integer(wage$education) == 1]), 1)} në \Sexpr{fmt(median(wage$wage[as.integer(wage$education) == 5]), 1)} mijë \$.
    \item<2-> Edhe shpërndarja rritet: kutitë zgjerohen në nivelet e larta.
    \item<3-> Vlerat e larta mbi 250 shfaqen në çdo nivel.
  \end{itemize}
  \onslide<4->{\begin{Gabim}Kjo nuk provon që arsimi \emph{shkakton} pagë më të lartë: mosha, lloji i punës dhe aftësitë ndryshojnë bashkë me arsimin.\end{Gabim}}
\end{frame}

\begin{frame}[label=ushWage]{Radha jote!}
  \begin{Ushtrim}[(5 minuta)]
    \begin{enumerate}
      \item Llogaritni P90/P10 të pagave për punëtorët me ``4. College Grad''.
      \item Llogaritni medianën e pagës sipas \texttt{jobclass}.
      \item Sa \% e punëtorëve fitojnë më pak se 60\% e medianës?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjWage2}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Mbyllja e orës}
% ------------------------------------------------------------

\begin{frame}[label=cp21]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 1}
  \begin{enumerate}
    \item Pse për pagat mesatarja është zakonisht më e madhe se mediana?
    \item Cilat statistika lejohen për një variabël rendore?
    \item Çfarë do të thotë $F_n(4) = 0.6$?
  \end{enumerate}
  \shkoTe{zgjCp21}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje: Ora 1}
  \begin{itemize}
    \item ``Tipike'' ka disa kuptime: mesatarja, mediana, moda.
    \item Në shpërndarje të anuara djathtas, mesatarja $>$ mediana; statistika zyrtare përdor medianën.
    \item Shkalla e matjes vendos cila statistikë ka kuptim.
    \item $F_n(x)$ dhe kuantilet: \Rkey{ecdf()}, \Rkey{quantile()}, \Rkey{median()}.
  \end{itemize}
  \begin{Keshille}Ora 2: masat e qendrës dhe të shpërndarjes, me vetitë e tyre.\end{Keshille}
\end{frame}
