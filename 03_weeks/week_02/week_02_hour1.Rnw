% ============================================================
%  Java 2 · Ora 1 — Motivimi: çfarë është ``tipike''?
%  Rezultatet: K1, S4, S1
% ============================================================

\section{Motivimi}

\begin{frame}{Ora 1: Motivimi --- çfarë është ``tipike''?}
  \tableofcontents[currentsection,hideothersubsections,sectionstyle=show/hide]
\end{frame}

% ------------------------------------------------------------
\subsection{Problemi motivues}
% ------------------------------------------------------------

\begin{frame}{Pyetja e ditës \LO{K1}}
  \begin{itemize}
    \item<1-> \textbf{Sa fiton një punëtor tipik?}
    \item<2-> Duket pyetje e thjeshtë. Por çfarë do të thotë ``tipik''?
    \item<3-> Mesatarja? Vlera në mes? Vlera më e shpeshtë?
    \item<4-> Përgjigjja ndryshon shumë sipas zgjedhjes, dhe kjo ka pasoja reale: politika pagash, pragu i varfërisë, taksat.
  \end{itemize}
\end{frame}

\begin{frame}{Të dhënat \texttt{Wage}}
  \begin{itemize}
    \item<1-> 3\,000 punëtorë meshkuj në rajonin Mid-Atlantic të SHBA-së, vitet 2003--2009.
    \item<2-> Variabli kryesor: \texttt{wage}, paga vjetore në mijë \$.
    \item<3-> Variabla të tjera: mosha, arsimi, gjendja civile, lloji i punës, viti.
  \end{itemize}
  \onslide<4->{\footnotesize\textcolor{gray}{Të dhëna: reale (burimi: James et al., \emph{ISLR}; skedari \texttt{Wage.csv} nga repo-ja DS612).}}
\end{frame}

\begin{frame}[label=pyetjeWage]{Parashiko!}
  \begin{Parashiko}
    Për pagat e 3\,000 punëtorëve, cila është më e madhe?\\[3pt]
    \textbf{A)} Mesatarja \quad \textbf{B)} Mediana \quad \textbf{C)} Janë afërsisht të barabarta
  \end{Parashiko}
  \pause
  \begin{itemize}
    \item Mendo: si shpërndahen zakonisht pagat në një shoqëri?
  \end{itemize}
  \shkoTe{zgjWage}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[fragile]{Kodi R: mesatarja dhe mediana}
<<wage-read>>=
wage <- read.csv(file.path(W02DATA, "Wage.csv"))
dim(wage)
mean(wage$wage)       # arithmetic mean
median(wage$wage)     # middle value
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Mesatarja (\Sexpr{fmt(mean(wage$wage), 1)}) është më e madhe se mediana (\Sexpr{fmt(median(wage$wage), 1)}).
    \item<2-> Diferenca: rreth \Sexpr{fmt(mean(wage$wage) - median(wage$wage), 1)} mijë \$ në vit.
    \item<3-> Pse? Disa paga shumë të larta e ``tërheqin'' mesataren lart. Mediana nuk preket.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Histogrami i pagave}
<<wage-hist, echo=FALSE, fig.height=3.1>>=
library(ggplot2)
ggplot(wage, aes(x = wage)) +
  geom_histogram(binwidth = 10, fill = "#E8EEF7", colour = "#2C5AA0") +
  geom_vline(xintercept = mean(wage$wage), colour = "#D97706", linewidth = 1.1) +
  geom_vline(xintercept = median(wage$wage), colour = "#15803D",
             linewidth = 1.1, linetype = "dashed") +
  labs(x = "Wage (thousand USD per year)", y = "Count") +
  theme_minimal(base_size = 13)
@
  \centering\footnotesize Portokalli: mesatarja. Jeshile e ndërprerë: mediana.
\end{frame}

\begin{frame}{Çfarë na tregon histogrami?}
  \begin{itemize}
    \item<1-> Shumica e pagave janë midis 50 dhe 150 mijë \$.
    \item<2-> Bishti djathtas është i gjatë: \termi{anshmëri djathtas}{right skew}.
    \item<3-> Ka një grup të veçantë mbi 250 mijë \$: \Sexpr{sum(wage$wage > 250)} punëtorë.
  \end{itemize}
  \onslide<4->{\begin{Keshille}Në shpërndarje të anuara djathtas, zakonisht mesatarja $>$ mediana.\end{Keshille}}
\end{frame}

\begin{frame}{Mesatarja dhe mediana: dy ide të ndryshme}
  \centering
  \begin{tikzpicture}[>=Stealth]
    \draw[thick,uptblue] (0,0)--(10,0);
    \foreach \x in {1,1.6,2.2,2.8,3.4} \fill[uptmid] (\x,0.18) circle (4pt);
    \fill[warnred] (9.4,0.18) circle (4pt);
    \draw[accent,fill=accent] (3.4,-0.05)--(3.2,-0.45)--(3.6,-0.45)--cycle;
    \node[font=\scriptsize,text=accent,below] at (3.4,-0.45) {mesatarja: pika e ekuilibrit};
    \draw[okgreen,very thick,dashed] (2.5,0.5)--(2.5,-0.2);
    \node[font=\scriptsize,text=okgreen,above] at (2.5,0.5) {mediana: personi në mes};
  \end{tikzpicture}
  \vspace{6pt}
  \begin{itemize}
    \item Mesatarja: pika ku ``balancohet'' vija. Një pikë larg e zhvendos fort.
    \item Mediana: gjysma e vlerave janë majtas, gjysma djathtas. Pika larg nuk ka rëndësi.
  \end{itemize}
\end{frame}

\begin{frame}{Shembull pa ndihmën e PC}
  Pagat mujore në një firmë të vogël, në mijë lekë (sintetike):
  \[ 60,\quad 70,\quad 80,\quad 90,\quad 600 \]
  \pause
  \begin{enumerate}
    \item Mesatarja: $(60+70+80+90+600)/5 = 900/5 = 180$.
    \pause
    \item Mediana: vlera e tretë e renditur $= 80$.
    \pause
    \item Katër nga pesë punonjës marrin \textbf{më pak} se mesatarja.
  \end{enumerate}
  \pause
  \begin{Gabim}``Paga mesatare në firmë është 180 mijë lekë'' është e saktë, por e çorienton lexuesin.\end{Gabim}
\end{frame}

\begin{frame}{Statistika zyrtare zgjedh medianën}
  \begin{itemize}
    \item<1-> Eurostat dhe INSTAT (anketa SILC) e përcaktojnë pragun e rrezikut të varfërisë si \textbf{60\% e medianës} së të ardhurave të disponueshme të ekuivalentuara.
    \item<2-> Pse mediana dhe jo mesatarja? Sepse disa të ardhura shumë të larta nuk duhet ta ngrenë pragun e varfërisë.
    \item<3-> Për të dhënat \texttt{Wage}: 60\% e medianës $= \Sexpr{fmt(0.6 * median(wage$wage), 1)}$ mijë \$.
  \end{itemize}
\end{frame}

\begin{frame}{Mendo -- Diskuto -- Ndaj}
  \begin{Ushtrim}[(think--pair--share, 4 minuta)]
    Për secilin rast, cilën do të raportonit: mesataren apo medianën? Pse?
    \begin{enumerate}
      \item Çmimi i apartamenteve në Tiranë.
      \item Nota mesatare e një studenti në 10 provime.
      \item Koha e udhëtimit për në punë.
      \item Konsumi total i energjisë i një qyteti, i llogaritur nga familjet.
    \end{enumerate}
  \end{Ushtrim}
\end{frame}

% ------------------------------------------------------------
\subsection{Objektivat}
% ------------------------------------------------------------

\begin{frame}{Objektivat e ditës}
  Në fund të ditës do të jesh në gjendje:
  \begin{enumerate}
    \item \LO{K1} të zgjedhësh masën e duhur të qendrës dhe të shpërndarjes sipas të dhënave;
    \item \LO{S1} të shpjegosh vetitë e mesatares, medianës, variancës, IQR-së dhe MAD-it;
    \item \LO{S4} t'i llogaritësh në R, nga zero dhe me paketa;
    \item \LO{K1} të përshkruash formën e një shpërndarjeje dhe të gjesh vlerat e skajshme;
    \item \LO{S4} të bësh një analizë eksploruese (EDA) të plotë në R.
  \end{enumerate}
\end{frame}

\begin{frame}{Lidhja me Javën 1}
  \begin{itemize}
    \item<1-> Te \texttt{Auto}: mesatarja e \texttt{mpg} 23.45 $>$ mediana 22.75. Sot e kuptojmë pse.
    \item<2-> Boxplot-i: e përdorëm; sot e ndërtojmë nga zero, me rregullin $1.5\cdot IQR$.
    \item<3-> $\overline{g(x)}\neq g(\bar x)$: sot e përdorim për shndërrimet logaritmike.
    \item<4-> Varianca me $n-1$: sot shtojmë masa më të qëndrueshme.
  \end{itemize}
\end{frame}

