\begin{frame}{Klasifikimi i variablave \LO{S1}}
  \centering
  \begin{tikzpicture}[>=Stealth,level distance=1.3cm,
      level 1/.style={sibling distance=5.2cm},level 2/.style={sibling distance=2.6cm},
      nd/.style={rectangle,rounded corners=2pt,draw=uptblue,fill=uptlight,font=\scriptsize,align=center,minimum width=2.2cm}]
