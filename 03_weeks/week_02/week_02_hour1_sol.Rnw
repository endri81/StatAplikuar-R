% ============================================================
%  Java 2 · Ora 1 — Zgjidhjet (shtojca)
% ============================================================

\begin{frame}[label=zgjWage]{Zgjidhja: Parashiko (pagat)}
  \textbf{A)} Mesatarja.
  \begin{itemize}
    \item Pagat kanë bisht të gjatë djathtas: pak njerëz me paga shumë të larta.
    \item Këto vlera e ngrenë mesataren, por jo medianën.
  \end{itemize}
  \vfill\kthehu{pyetjeWage}
\end{frame}

\begin{frame}[label=zgjShk]{Zgjidhja: Radha jote! (shkallët)}
  \begin{enumerate}
    \item Kodi postar: \textbf{nominale}. Numri është vetëm etiketë.
    \item Vlerësimi i shërbimit: \textbf{rendore}.
    \item Sipërfaqja në m²: \textbf{raporti} (0 m² = mungesë sipërfaqeje).
    \item Temperatura në °C: \textbf{intervalore}.
    \item Numri i anëtarëve: \textbf{raporti}, sasiore diskrete.
  \end{enumerate}
  \vfill\kthehu{ushShk}
\end{frame}

\begin{frame}[fragile,label=zgjMed]{Zgjidhja: Parashiko (mediana)}
  \textbf{B)} 5.5. R i rendit vlerat: $1, 3, 8, 20$; mediana $=(3+8)/2$.
<<sol-med>>=
median(c(20, 1, 8, 3))
@
  \begin{itemize}
    \item C) 4.5 vjen nga mesatarja e 1 dhe 8 pa renditje: gabim i zakonshëm.
  \end{itemize}
  \vfill\kthehu{pyetjeMed}
\end{frame}

\begin{frame}[fragile,label=zgjWage2]{Zgjidhja: Radha jote! (pagat)}
<<sol-wage2>>=
w1 <- read.csv(file.path(W02DATA, "Wage.csv"))
cg <- w1$wage[w1$education == "4. College Grad"]
unname(quantile(cg, 0.9) / quantile(cg, 0.1))
tapply(w1$wage, w1$jobclass, median)
round(100 * mean(w1$wage < 0.6 * median(w1$wage)), 1)
@
  \vfill\kthehu{ushWage}
\end{frame}

\begin{frame}[label=zgjCp21]{Përgjigjet: Checkpoint i Orës 1}
  \begin{enumerate}
    \item Shpërndarja është e anuar djathtas: pagat shumë të larta e tërheqin mesataren, jo medianën.
    \item Moda, frekuencat, mediana dhe kuantilet.
    \item 60\% e vrojtimeve kanë vlerë më të vogël ose të barabartë me 4.
  \end{enumerate}
  \vfill\kthehu{cp21}
\end{frame}
