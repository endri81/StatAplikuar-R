\begin{frame}[label=cp22]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 2}
  \begin{enumerate}
    \item Cilin funksion humbjeje minimizon mesatarja? Po mediana?
    \item Nëse të gjitha vlerat shumëzohen me 3, çfarë ndodh me $s$ dhe me IQR?
    \item Pse \texttt{mad()} shumëzon me 1.4826?
  \end{enumerate}
  \shkoTe{zgjCp22}{Përgjigjet}
