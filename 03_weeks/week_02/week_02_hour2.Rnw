\begin{frame}{Përmbledhje: Ora 2}
  \begin{itemize}
    \item Qendra: mesatarja, mediana, moda, mesatarja e prerë.
    \item $\bar x$ minimizon katrorët; $\tilde x$ minimizon vlerat absolute.
    \item Shpërndarja: gjerësia, $s$, IQR, MAD, CV.
    \item Qëndrueshmëria matet me pikën e prishjes: mediana dhe MAD 50\%, mesatarja 0\%.
    \item Kuantilet kanë 9 përkufizime; R përdor tipin 7.
  \end{itemize}
  \begin{Keshille}Ora 3: i llogaritim të gjitha nga zero në R, me funksione dhe cikle.\end{Keshille}
