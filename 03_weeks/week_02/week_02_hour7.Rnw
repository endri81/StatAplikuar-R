\begin{frame}[label=cp27]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 7}
  \begin{enumerate}
    \item Cilat tri masa do të raportonit për një variabël të anuar djathtas?
    \item Si e dalloni një variabël të kufizuar nga lart?
    \item Pse duhen të paktën dy rregulla për vlerat e skajshme?
  \end{enumerate}
  \shkoTe{zgjCp27}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje e Javës 2}
  \begin{itemize}
    \item Ora 1: ``tipike'' ka disa kuptime; shkallët e matjes; ECDF dhe kuantilet.
    \item Ora 2: qendra, shpërndarja, pika e prishjes, 9 tipat e kuantileve.
    \item Ora 3: të gjitha nga zero në R, me testim të rastësishëm.
    \item Ora 4: anshmëria, kurtoza, shndërrimet, vlerat e skajshme, Box-Cox.
    \item Ora 5--6: EDA me paketa; rastet \texttt{Boston} dhe \texttt{Wage}.
  \end{itemize}
  \begin{Keshille}Shihemi në Javën 3: korrelacioni.\end{Keshille}
\end{frame}
