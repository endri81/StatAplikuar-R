% ------------------------------------------------------------
\subsection{Varianti të Kriging-ut}
% ------------------------------------------------------------

\begin{frame}{Kriging-u i thjeshtë (\emph{Simple Kriging})}
  \begin{itemize}
    \item<1-> Nëse $\mu$ është i \textbf{njohur}: $\hat Z_0=\mu+\sum_i\lambda_i(Z_i-\mu)$, pa kusht $\sum\lambda_i=1$.
    \item<2-> Sistemi me kovariancë: $\sum_j\lambda_jC_{ij}=C_{i0}$, d.m.th.\ $\boldsymbol\lambda=C^{-1}\mathbf c_0$.
    \item<3-> $\sigma^2_{SK}=C(0)-\mathbf c_0^\top C^{-1}\mathbf c_0\le\sigma^2_{OK}$: dimë më shumë, gabojmë më pak.
    \item<4-> Larg të dhënave: SK $\to\mu$; OK $\to$ mesatare e vlerësuar lokalisht.
  \end{itemize}
\end{frame}

\begin{frame}{Kriging-u universal (\emph{Universal Kriging})}
  \begin{itemize}
    \item<1-> Trendi nuk është konstant: $Z(s)=\mathbf x(s)^\top\boldsymbol\beta+e(s)$.
    \item<2-> $\mathbf x(s)$: koordinatat (polinomi i Orës 2) ose një kovariat (\texttt{dist}, lartësia).
    \item<3-> Kushtet e pazhvendosjes: $\sum_i\lambda_ix_k(s_i)=x_k(s_0)$ për çdo $k$ (një shumëzues $m_k$ për secilin).
    \item<4-> Me kovariat të jashtëm: \termi{Kriging me prirje të jashtme}{Kriging with external drift}; kovariati duhet të njihet në \textbf{çdo} qelizë.
  \end{itemize}
\end{frame}

\begin{frame}{UK $=$ GLS $+$ Kriging i mbetjeve}
  \begin{enumerate}
    \item<1-> Vlerësojmë $\boldsymbol\beta$ me GLS:
      $\hat{\boldsymbol\beta}=(X^\top C^{-1}X)^{-1}X^\top C^{-1}\mathbf z$.
    \item<2-> Parashikimi: $\hat Z_0=\mathbf x_0^\top\hat{\boldsymbol\beta}+\mathbf c_0^\top C^{-1}(\mathbf z-X\hat{\boldsymbol\beta})$.
    \item<3-> Pjesa e parë: regres (Java 5--6), por me pesha nga korrelacioni hapësinor.
    \item<4-> Pjesa e dytë: Kriging i thjeshtë i mbetjeve.
  \end{enumerate}
  \onslide<5->{\begin{Keshille}Variogrami për UK llogaritet mbi \textbf{mbetjet}, jo mbi $z$: \texttt{variogram(log(zinc) \textasciitilde\ sqrt(dist), ...)}.\end{Keshille}}
\end{frame}

\begin{frame}{\Zgjerim Kriging-u në blloqe (\emph{block kriging})}
  \begin{itemize}
    \item<1-> Synimi: mesatarja e $Z$ në një sipërfaqe $B$, jo vlera në një pikë.
    \item<2-> $\bar\gamma(s_i,B)$: mesatarja e $\gamma$ mes $s_i$ dhe pikave të $B$.
    \item<3-> Varianca e bllokut është më e vogël: nugget-i dhe variacioni i vogël mesatarizohen.
    \item<4-> \texttt{krige(..., block = c(100, 100))} ose \texttt{newdata} poligone (Ora 6: qarqet).
  \end{itemize}
\end{frame}

\begin{frame}{Krahasimi: IDW, OK, UK}
  \small
  \begin{tabular}{@{}lccc@{}}
    \toprule
    & IDW & OK & UK \\ \midrule
    Peshat nga & $d^{-p}$ & $\gamma$ & $\gamma$ $+$ trend \\
    Shpërgrumbullim & jo & po & po \\
    Pesha negative & jo & mundet & mundet \\
    Pasiguri & jo & $\sigma_{OK}$ & $\sigma_{UK}$ \\
    Kovariatë & jo & jo & po \\
    Çfarë duhet zgjedhur & $p$, lagjja & modeli i $\gamma$ & trendi $+$ modeli \\ \bottomrule
  \end{tabular}
\end{frame}

\begin{frame}{Pasiguria nga lognormali}
  \begin{Gabim}
    Kriging-u i $\log z$ jep $\hat y$ dhe $\sigma^2$ në $\log$. $\exp(\hat y)$ \textbf{nuk} është mesatarja e $z$: është afër \emph{mesores}.
  \end{Gabim}
  \begin{itemize}
    \item<2-> Për Kriging-un e thjeshtë: $\hat z=\exp\big(\hat y+\sigma^2_{SK}/2\big)$.
    \item<3-> Intervali 95\%: $\exp(\hat y\pm1.96\sigma)$ mbetet i saktë (kuantilet ruhen nga $\exp$).
    \item<4-> Ora 5: e shohim në hartat e Meuse.
  \end{itemize}
\end{frame}

\begin{frame}[label=ushTPS124]{Mendo -- diskuto në çift -- ndaj}
  \begin{Ushtrim}[(5 minuta)]
    Agjencia e mjedisit ka 20 stacione të cilësisë së ajrit dhe buxhet për 5 të reja.
    \begin{enumerate}
      \item Si mund të përdorni hartën e $\sigma_{OK}$ për të zgjedhur vendet?
      \item Pse nuk ju duhen matjet e reja për këtë vendim?
      \item Çfarë rreziku ka kjo qasje nëse variogrami është i gabuar?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjTPS124}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=cp124]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 4}
  \begin{enumerate}
    \item Shkruani lidhjen mes $\gamma(h)$ dhe $C(h)$ dhe shpjegoni pragun.
    \item Pse sistemi i OK ka një rresht dhe një kolonë me 1?
    \item Çfarë ndryshon te UK krahasuar me OK?
  \end{enumerate}
  \shkoTe{zgjCp124}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje: Ora 4}
  \begin{itemize}
    \item $\gamma(h)=\tfrac12\mathrm E[(Z(s+h)-Z(s))^2]=C(0)-C(h)$; nugget, sill, range.
    \item Modelet Sph, Exp (range praktik $3a$), Gau ($\sqrt3a$); përshtatja WLS.
    \item OK: $\sum_j\lambda_j\gamma_{ij}+m=\gamma_{i0}$, $\sum\lambda_j=1$; $\sigma^2_{OK}=\sum\lambda_i\gamma_{i0}+m$.
    \item Toy: $\tfrac23,\tfrac13$ ($\sigma^2=\tfrac43$); ekran: $\lambda=(1,0)$ ($\sigma^2=2$).
    \item SK ($\mu$ e njohur), UK (trend $=$ GLS $+$ Kriging i mbetjeve), Kriging në blloqe.
  \end{itemize}
  \begin{Keshille}Ora 5 (Lab II): variogrami i Meuse, \texttt{fit.variogram}, OK dhe UK, hartat e pasigurisë, CV.\end{Keshille}
\end{frame}
