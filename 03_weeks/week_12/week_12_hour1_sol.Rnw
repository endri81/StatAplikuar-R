% ============================================================
%  Java 12 · Ora 1 — Zgjidhjet (shtojca)
% ============================================================

\begin{frame}[label=zgjToy121]{Zgjidhja: Parashiko (pesë metoda)}
  \small
  \begin{enumerate}[A.]
    \item Fqinji: $x=0$ është më afër (1 kundrejt 3) $\Rightarrow$ 10.
    \item Linear: $10+\frac14(30-10)=15$.
    \item IDW $p=1$: $w=(1, \tfrac13)$; $\hat z=\dfrac{10+30/3}{1+1/3}=\dfrac{20}{4/3}=15$.
    \item IDW $p=2$: $w=(1, \tfrac19)$; $\hat z=\dfrac{10+30/9}{1+1/9}=\dfrac{120/9}{10/9}=12$.
    \item Mesatarja: $(10+30)/2=20$.
  \end{enumerate}
  \vfill\kthehu{pyetjeToy121}
\end{frame}

\begin{frame}[label=zgjGabim121]{Zgjidhja: Gjej gabimin}
  \begin{itemize}
    \item IDW: $\hat z=\sum\lambda_iz_i$ me $\lambda_i>0$, $\sum\lambda_i=1$: mesatare e ponderuar $\Rightarrow$ $\min z_i\le\hat z\le\max z_i$.
    \item 2500 ppm $>$ 1839 ppm është e pamundur me IDW.
    \item Shkaqe të mundshme: interpolim në $\log$ dhe kthim me gabim; hartë nga një metodë tjetër (polinom, spline); ngatërrim i kolonës; legjendë e gabuar.
  \end{itemize}
  \vfill\kthehu{gjejGabim121}
\end{frame}

\begin{frame}[label=zgjSt121]{Zgjidhja: Parashiko (pseudo-stacionet)}
  \begin{itemize}
    \item Mostra: min $13.5^\circ$C, max $25.7^\circ$C.
    \item Maksimumi afër të vërtetës: zonat e ngrohta (fusha, bregdet) janë të mëdha, mostra i kap.
    \item Minimumi larg: majat më të ftohta zënë pak qeliza; probabiliteti që një nga 80 të bjerë aty është i vogël.
  \end{itemize}
  \vfill\kthehu{pyetjeSt121}
\end{frame}

\begin{frame}[label=zgjMC121]{Zgjidhja: Pyetje me zgjedhje}
  \begin{itemize}
    \item Përgjigjja: \textbf{C}.
    \item A, B, D: mesatare të ponderuara të vlerave të matura, me pesha pozitive: brenda diapazonit.
    \item C: $\hat T=\hat\beta_0+\hat\beta_1\,\text{elev}$; në një qelizë 2500 m, $\hat T$ del shumë më e ulët se çdo stacion (ekstrapolim përgjatë kovariatit).
  \end{itemize}
  \vfill\kthehu{pyetjeMC121}
\end{frame}

\begin{frame}[label=zgjTPS121]{Zgjidhja: Think--pair--share}
  \begin{enumerate}
    \item Në zona me pak stacione dhe ndryshim të madh: malet, kufiri lindor, larg stacioneve ekzistuese (ku gabimi standard i Kriging-ut është më i madh).
    \item Rrjeta e rregullt mbulon territorin njëtrajtshëm dhe jep çifte në të gjitha distancat për variogramin.
    \item Pasigurinë: ku harta është e besueshme dhe ku jo (gabimi standard, intervalet), që të vendosë ku të matë më shumë ose ku të jetë i kujdesshëm.
  \end{enumerate}
  \vfill\kthehu{ushTPS121}
\end{frame}

\begin{frame}[label=zgjCp121]{Përgjigjet: Checkpoint Ora 1}
  \begin{enumerate}
    \item $\hat z(s_0)=\sum_{i=1}^n\lambda_iz(s_i)$.
    \item Fqinji më i afërt (Thiessen); Kriging (gabimi standard nga varianca e Kriging-ut).
    \item Peshat janë pozitive dhe mblidhen në 1: parashikimi është mesatare e ponderuar e vlerave të matura.
  \end{enumerate}
  \vfill\kthehu{cp121}
\end{frame}

\begin{frame}[label=zgjIdw121]{Zgjidhja: Radha jote! (IDW në 2D)}
  \begin{enumerate}
    \item $d_1=1$, $d_2=2$, $d_3=\sqrt{9+16}=5$.
    \item $w=1/d^2=(1, 0.25, 0.04)$; shuma $1.29$.
    \item $\hat z=(10+5+1.6)/1.29=16.6/1.29\approx12.87$. Pika e tretë ka peshë $0.04/1.29\approx3\%$: me $p=2$ pesha bie me katrorin e distancës.
  \end{enumerate}
  \vfill\kthehu{ushIdw121}
\end{frame}

\begin{frame}[label=zgjP121]{Zgjidhja: Ndrysho parametrin}
  \begin{itemize}
    \item $p=0.5$: harta pothuajse e sheshtë (5.74--6.07, sd 0.05): të gjitha mostrat peshojnë njësoj, $\hat z\approx$ mesatarja.
    \item $p=2$: 4.79--7.48, sd 0.41.
    \item $p=8$: 4.727--7.517, sd 0.69: praktikisht fqinji më i afërt (Thiessen).
    \item $p$ kontrollon kompromisin zbutje $\leftrightarrow$ lokalitet; zgjidhet me cross-validation (Ora 3).
  \end{itemize}
  \vfill\kthehu{ushP121}
\end{frame}
