% ------------------------------------------------------------
\subsection{Kuizi në stilin e provimit}
% ------------------------------------------------------------

\begin{frame}{Kuizi: si funksionon}
  \begin{itemize}
    \item<1-> Si në provim: \textbf{25\% teori, 75\% ushtrime}; 3 pyetje teorike (25 pikë) $+$ 7 ushtrime (75 pikë).
    \item<2-> Koha: 45 minuta. Ushtrimet 1--4 dhe 6 bëhen pa ndihmën e PC.
    \item<3-> Vlera të dobishme: $e^{-3}=0.0498$; $e^{1.96\cdot0.4}=e^{0.784}=2.190$; $e^{5.8}=330.3$.
  \end{itemize}
  \onslide<4->{\begin{Keshille}Shkruani gjithmonë njësinë: metra apo gradë, $\log$(ppm) apo ppm, $^\circ$C apo $(^\circ\text{C})^2$.\end{Keshille}}
\end{frame}

\begin{frame}[label=q12T1]{Teori 1 (8 pikë)}
  \begin{Ushtrim}[(Teori 1)]
    \begin{enumerate}
      \item Dalloni interpolimin e saktë nga ai zbutës. Jepni nga një shembull.
      \item Pse IDW nuk mund të japë vlerë mbi maksimumin e të dhënave, ndërsa polinomi global mundet?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s12T1}{Zgjidhja}
\end{frame}

\begin{frame}[label=q12T2]{Teori 2 (8 pikë)}
  \begin{Ushtrim}[(Teori 2)]
    \begin{enumerate}
      \item Përkufizoni semivariogramin dhe tregoni lidhjen e tij me kovariancën.
      \item Shpjegoni nugget, sill dhe range. Çfarë do të thotë ``range praktik'' te modeli eksponencial?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s12T2}{Zgjidhja}
\end{frame}

\begin{frame}[label=q12T3]{Teori 3 (9 pikë)}
  \begin{Ushtrim}[(Teori 3)]
    \begin{enumerate}
      \item Shkruani sistemin e Kriging-ut të zakonshëm dhe variancën e tij. Nga vjen shumëzuesi $m$?
      \item Si ndryshon Kriging-u universal nga ai i zakonshëm? Mbi çfarë llogaritet variogrami?
      \item Pse LOOCV preferohet ndaj RMSE-së në stacione për të vlerësuar një hartë?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s12T3}{Zgjidhja}
\end{frame}

\begin{frame}[label=q12E1]{Ushtrimi 1 (10 pikë): Thiessen dhe IDW}
  \begin{Ushtrim}[(Ushtrimi 1, pa ndihmën e PC)]
    Në 1D: $x=0,\ 2,\ 6$ me $z=10,\ 14,\ 30$. Parashikojmë në $x_0=1.5$.
    \begin{enumerate}
      \item Vlera me Thiessen.
      \item IDW me $p=1$: peshat dhe $\hat z$.
      \item IDW me $p=2$: $\hat z$. Pse është më afër vlerës së Thiessen?
      \item Ku shkon IDW kur $p\to0$?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s12E1}{Zgjidhja}
\end{frame}

\begin{frame}[label=q12E2]{Ushtrimi 2 (10 pikë): variogrami empirik}
  \begin{Ushtrim}[(Ushtrimi 2, pa ndihmën e PC)]
    Në 1D: $x=0,1,2,3,4,5$ me $z=3,\ 5,\ 4,\ 8,\ 6,\ 7$ (sintetike).
    \begin{enumerate}
      \item Llogaritni $\hat\gamma(1)$ dhe $\hat\gamma(2)$. Sa çifte ka secila?
      \item Pse $\hat\gamma(2)<\hat\gamma(1)$? Çfarë do të përshtatnit: nugget i madh apo i vogël?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s12E2}{Zgjidhja}
\end{frame}

\begin{frame}[label=q12E3]{Ushtrimi 3 (10 pikë): modelet}
  \begin{Ushtrim}[(Ushtrimi 3, pa ndihmën e PC)]
    \begin{enumerate}
      \item Sferik: $c_0=0.1$, $c=0.5$, $a=600$ m. Llogaritni $\gamma(300)$ dhe $\gamma(800)$.
      \item Eksponencial: $c_0=0.1$, $c=0.5$, $a=200$ m. Llogaritni $\gamma(600)$. Sa është range-i praktik?
      \item Te \texttt{gstat}: si shkruhet modeli i pikës 2 me \texttt{vgm()}?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s12E3}{Zgjidhja}
\end{frame}

\begin{frame}[label=q12E4]{Ushtrimi 4 (10 pikë): sistemi i OK}
  \begin{Ushtrim}[(Ushtrimi 4, pa ndihmën e PC)]
    $\gamma(h)=h$; $s_1=0$, $s_2=5$; $z_1=10$, $z_2=20$ (1D).
    \begin{enumerate}
      \item Parashikimi dhe $\sigma^2_{OK}$ në $s_0=2$.
      \item Parashikimi dhe $\sigma^2_{OK}$ në $s_0=-1$. Çfarë efekti shihni?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s12E4}{Zgjidhja}
\end{frame}

\begin{frame}[fragile,label=q12E5]{Ushtrimi 5 (10 pikë): lexo output-in}
\begin{verbatim}
  model      psill    range         RMSE    ME  MSDR
1   Nug 0.05066    0.0      OK  0.392 0.000  0.82
2   Sph 0.59061  896.9      UK  0.375 -0.003 1.08
\end{verbatim}
  \begin{Ushtrim}[(Ushtrimi 5)]
    \begin{enumerate}
      \item Sa është pragu dhe sa \% e tij është nugget? Çfarë do të thotë range 897 m?
      \item Cila metodë është më e mirë? Përdorni të tria kolonat.
      \item Çfarë do të thotë MSDR $=0.82$ për hartën e pasigurisë së OK?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s12E5}{Zgjidhja}
\end{frame}

\begin{frame}[label=q12E6]{Ushtrimi 6 (10 pikë): kthimi nga log}
  \begin{Ushtrim}[(Ushtrimi 6, pa ndihmën e PC)]
    Kriging-u i $\log(\text{zink})$ jep në një qelizë $\hat y=5.8$ dhe $\sigma^2=0.16$.
    \begin{enumerate}
      \item Llogaritni $\exp(\hat y)$ dhe $\exp(\hat y+\sigma^2/2)$. Cila është afër mesores, cila mesatares?
      \item Ndërtoni intervalin 95\% në ppm.
      \item Pse intervali nuk është simetrik rreth $\exp(\hat y)$?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s12E6}{Zgjidhja}
\end{frame}

\begin{frame}[label=q12E7]{Ushtrimi 7 (15 pikë): projekt i vogël}
  \begin{Ushtrim}[(Ushtrimi 7)]
    Keni \texttt{pts} (\texttt{sf}, EPSG:6870) me kolonat \texttt{rain} dhe \texttt{elev}, dhe \texttt{cells} (\texttt{sf}) me \texttt{elev}.
    \begin{enumerate}
      \item Shkruani kodin për UK me \texttt{elev}: variogrami, përshtatja, parashikimi.
      \item Shkruani kodin për LOOCV dhe RMSE.
      \item Përmendni dy kontrolle që do të bënit para se ta publikonit hartën.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s12E7}{Zgjidhja}
\end{frame}

\begin{frame}{Tabela e pikëve}
  \centering
  \begin{tabular}{@{}lcc@{}}
    \toprule
