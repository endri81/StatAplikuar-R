    \item Nën 50 pikë: përsëritni Orët 2 dhe 4 (teoria), pastaj Orën 5.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Ushtrime për shtëpi}
% ------------------------------------------------------------

\begin{frame}[label=h12H1]{Ushtrime për shtëpi 1--2}
  \begin{enumerate}
    \item Meuse: përsëritni Orën 5 për \texttt{log(copper)}. Krahasoni variogramin me atë të zinkut (nugget, range). Cili metal ka strukturë hapësinore më të fortë?
    \item Meuse: bëni CV 5-fish (\texttt{nfold = 5}) në vend të LOOCV për OK dhe UK, me 10 seed-e. Sa ndryshon RMSE nga seed-i?
  \end{enumerate}
  \shkoTe{h12S1}{Udhëzime}
\end{frame}

\begin{frame}[label=h12H3]{Ushtrime për shtëpi 3--4}
  \begin{enumerate}
    \setcounter{enumi}{2}
    \item Shqipëria: përsëritni Orën 6 për janarin. A ndryshon gradienti termik? Po pragu i mbetjeve?
    \item Shqipëria: zgjidhni 80 stacione vetëm nën 500 m. Krahasoni RMSE-në e vërtetë dhe LOOCV për OK dhe UK. Lidheni me think--pair--share të Orës 6.
  \end{enumerate}
  \shkoTe{h12S3}{Udhëzime}
\end{frame}

\begin{frame}[label=h12H5]{Ushtrime për shtëpi 5--6}
  \begin{enumerate}
    \setcounter{enumi}{4}
    \item Shkruani funksionin \texttt{ok\_predict(s, z, s0, model)} me matrica (Ora 5) dhe krahasojeni me \texttt{krige()} në 20 qeliza të rastit.
    \item \Zgjerim\ Variograme drejtimore për zinkun (\texttt{alpha = c(0, 45, 90, 135)}). A ka anizotropi përgjatë lumit?
  \end{enumerate}
  \shkoTe{h12S5}{Udhëzime}
\end{frame}

% ------------------------------------------------------------
\subsection{Gabimet e javës}
% ------------------------------------------------------------

\begin{frame}{Gabimet e zakonshme: interpolimi}
  \begin{itemize}
    \item Interpolim në gradë (lon/lat) me distanca euklidiane.
    \item Zgjedhja e metodës ose e $p$ ``me sy'', jo me CV.
    \item RMSE në stacione si masë e gabimit të hartës.
    \item Polinom me koordinata të papërpunuara (\texttt{raw = TRUE}) në metra.
    \item Peshat Thiessen pa e prerë Voronoi-n me zonën e studimit.
  \end{itemize}
\end{frame}

\begin{frame}{Gabimet e zakonshme: variogrami dhe Kriging-u}
  \begin{itemize}
    \item Klasa shumë të ngushta (pak çifte) ose \texttt{cutoff} shumë i madh.
    \item \texttt{range} i \texttt{"Exp"} lexuar si range i vërtetë (është $a$; praktik $3a$).
    \item UK me variogramin e $z$ në vend të atij të mbetjeve.
    \item $\exp(\hat y)$ raportuar si mesatare.
    \item Hartë parashikimi pa hartë pasigurie.
  \end{itemize}
\end{frame}

\begin{frame}{Lista e kontrollit para publikimit}
  \begin{enumerate}
    \item CRS i projektuar, njësitë në metra.
    \item Variogrami empirik: çifte të mjaftueshme në çdo klasë.
    \item Modeli: krahasuar me CV (RMSE, ME, MSDR).
    \item Kovariatët: të njohur në çdo qelizë, në të njëjtën rrjetë.
    \item Hartat: parashikimi $+$ gabimi standard; shkalla, veriu, burimi.
    \item Të dhënat: reale apo sintetike, shkruar qartë.
  \end{enumerate}
\end{frame}

% ------------------------------------------------------------
\subsection{Fletë-kujtesa}
% ------------------------------------------------------------

\begin{frame}{Fletë-kujtesa 1: formulat}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    IDW & $\lambda_i=d_i^{-p}/\sum_jd_j^{-p}$ \\
    Polinomi & $\hat{\boldsymbol\beta}=(X^\top X)^{-1}X^\top\mathbf z$ \\
    Variogrami empirik & $\hat\gamma(h)=\frac{1}{2N(h)}\sum(z_i-z_k)^2$ \\
    Lidhja & $\gamma(h)=C(0)-C(h)$ \\
    Sferik & $c_0+c\,[1.5\,h/a-0.5\,(h/a)^3]$, $h\le a$ \\
    Eksponencial & $c_0+c\,(1-e^{-h/a})$, range praktik $3a$ \\
    OK & $\sum_j\lambda_j\gamma_{ij}+m=\gamma_{i0}$, $\sum\lambda_j=1$ \\
    Varianca OK & $\sigma^2_{OK}=\sum_i\lambda_i\gamma_{i0}+m$ \\
    LOOCV & $\sqrt{\frac1n\sum(z_i-\hat z_{(-i)})^2}$ \\ \bottomrule
  \end{tabular}
\end{frame}

\begin{frame}{Fletë-kujtesa 2: funksionet R}
  \small
  \begin{tabular}{@{}ll@{}}
    \toprule
    \texttt{sf::st\_voronoi()} & poligonet Thiessen (me \texttt{envelope}) \\
    \texttt{gstat::idw()} & IDW (\texttt{idp}, \texttt{nmax}, \texttt{maxdist}) \\
    \texttt{gstat::variogram()} & variogrami empirik (\texttt{width}, \texttt{cutoff}, \texttt{cloud}) \\
    \texttt{gstat::vgm()} & modeli (\texttt{"Sph"}, \texttt{"Exp"}, \texttt{"Gau"}, \texttt{"Lin"}) \\
    \texttt{gstat::fit.variogram()} & përshtatja WLS (\texttt{SSErr}) \\
    \texttt{gstat::variogramLine()} & $\gamma(h)$ e modelit në distanca të dhëna \\
    \texttt{gstat::krige()} & OK (\texttt{\textasciitilde\ 1}), UK (\texttt{\textasciitilde\ x}), blloqe \\
    \texttt{gstat::krige.cv()} & LOOCV ose $k$-fish (\texttt{nfold}) \\
    \texttt{terra::project()} & rasteri në CRS të ri \\ \bottomrule
  \end{tabular}
\end{frame}

\begin{frame}{Fletë-kujtesa 3: cilën metodë kur}
  \small
  \begin{tabular}{@{}p{0.42\textwidth}p{0.5\textwidth}@{}}
    \toprule
    Situata & Zgjedhja \\ \midrule
    Variabël kategorike & Thiessen (fqinji më i afërt) \\
    Trend i madh, pa detaje & Polinom i rendit 1--2 \\
    Shpejt, pa model, pak pika & IDW me $p$ nga CV \\
    Duhet pasiguria & OK \\
    Kovariat i fortë në çdo qelizë & UK / KED \\
    Mesatare për njësi administrative & Kriging në blloqe \\ \bottomrule
  \end{tabular}
\end{frame}

% ------------------------------------------------------------
\subsection{Përmbledhja e kursit}
% ------------------------------------------------------------

\begin{frame}{12 javë në një tabelë}
  \scriptsize
  \begin{tabular}{@{}clc@{}}
    \toprule
    Java & Tema & LO \\ \midrule
    1--2 & R, vizualizimi, statistikat përmbledhëse, EDA & S4, K1 \\
    3 & Korrelacioni: Pearson, Spearman, Kendall & K1 \\
    4 & ANOVA dhe krahasimet e shumëfishta & K1, S3 \\
    5--6 & Regresi i thjeshtë dhe i shumëfishtë; CV & K2, S2, S3 \\
    7 & Diagnostikimi i modelit & S3, C1 \\
    8 & Regresi jolinear dhe i fortë & K2, S2 \\
    9 & Regresi logjistik dhe klasifikimi & K2, S3, C1 \\
    10--11 & Koordinatat, projeksionet, raster dhe vektor & K3, S4 \\
    12 & Interpolimi hapësinor dhe Kriging-u & K3, C1 \\ \bottomrule
  \end{tabular}
\end{frame}

\begin{frame}{Fijet që lidhin kursin}
  \begin{itemize}
    \item<1-> \textbf{Modeli $+$ gabimi}: nga $y=\beta_0+\beta_1x+\varepsilon$ (Java 5) te $Z(s)=\mathbf x(s)^\top\boldsymbol\beta+e(s)$ (Java 12).
    \item<2-> \textbf{Katrorët më të vegjël}: OLS, WLS (variogrami), GLS (UK).
    \item<3-> \textbf{Vlerësimi i ndershëm}: train/test, CV, LOOCV, PRESS --- e njëjta ide në çdo javë.
    \item<4-> \textbf{Supozimet}: pavarësia e mbetjeve (Java 7) $\to$ autokorrelacioni hapësinor (Java 11) $\to$ Kriging-u (Java 12).
  \end{itemize}
  \LO{C1}
\end{frame}

% ------------------------------------------------------------
\subsection{Projekti final}
% ------------------------------------------------------------

\begin{frame}{Projekti final: struktura}
  \begin{enumerate}
    \item<1-> \textbf{Pyetja}: një problem real (INSTAT, mjedisi, inxhinieria, biznesi).
    \item<2-> \textbf{Të dhënat}: reale, me burim; ose sintetike me parametra të njohur (dhe vlerësimi kundrejt së vërtetës).
    \item<3-> \textbf{EDA}: shpërndarjet, marrëdhëniet, të dhënat që mungojnë.
    \item<4-> \textbf{Modelet}: të paktën dy, nga javët 5--12; justifikimi i zgjedhjes.
    \item<5-> \textbf{Vlerësimi}: CV ose test i pavarur; diagnostikimi.
    \item<6-> \textbf{Interpretimi}: çfarë thonë rezultatet për pyetjen; kufizimet.
    \item<7-> \textbf{Riprodhueshmëria}: skript R ose \texttt{.Rnw}/\texttt{.Rmd} që ekzekutohet nga e para.
  \end{enumerate}
\end{frame}

\begin{frame}{Projekti final: rubrika e shkurtër (propozim)}
  \small
  \begin{tabular}{@{}lc@{}}
    \toprule
    Kriteri & Pikë \\ \midrule
    Pyetja dhe të dhënat (burimi, etiketimi real/sintetik) & 15 \\
    Saktësia e metodave dhe e kodit & 25 \\
    Vlerësimi i modeleve (CV, diagnostikimi) & 20 \\
    Interpretimi dhe kufizimet & 15 \\
    Riprodhueshmëria (ekzekutohet pa ndërhyrje) & 15 \\
    Prezantimi (10 min $+$ 5 min pyetje) & 10 \\ \midrule
    Gjithsej & 100 \\ \bottomrule
  \end{tabular}
  \begin{itemize}
    \item Sipas syllabusit, detyra e kursit vlen 15\% të notës; provimi 85\%.
  \end{itemize}
\end{frame}

\begin{frame}{Burime}
  \footnotesize
  \begin{itemize}
    \item K.-T.~Chang, \emph{Introduction to Geographic Information Systems}, McGraw-Hill, 2012 (interpolimi hapësinor, Kriging).
    \item N.~Cressie, \emph{Statistics for Spatial Data}, rev.\ ed., Wiley, 1993.
    \item E.~Pebesma, R.~Bivand, \emph{Spatial Data Science: With Applications in R}, CRC, 2023.
    \item E.~Pebesma (2004), Multivariable geostatistics in S: the gstat package, \emph{Computers \& Geosciences} 30.
    \item A.~H.~Thiessen (1911), \emph{Monthly Weather Review} 39; D.~Shepard (1968), Proc.\ ACM National Conference; G.~Wahba, \emph{Spline Models for Observational Data}, SIAM, 1990.
    \item Të dhënat: Meuse (Burrough \& McDonnell, paketa \texttt{sp}); WorldClim 2.1 (Fick \& Hijmans 2017); lartësia nga \texttt{geodata}; GADM 4.1.
    \item Repo DS612 nuk mbulon të dhënat hapësinore: e gjithë java është \textbf{material plotësues}.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Mbyllja}
% ------------------------------------------------------------

\begin{frame}[label=cp127]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 7}
  \begin{enumerate}
    \item Cilat janë tre hapat e Kriging-ut, nga të dhënat te harta?
    \item Kur do të zgjidhnit IDW në vend të Kriging-ut?
    \item Çfarë duhet të ketë çdo hartë e interpoluar që publikoni?
  \end{enumerate}
  \shkoTe{zgjCp127}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje e Javës 12}
  \begin{itemize}
    \item Metodat deterministe: Thiessen, TIN, polinomi global, IDW; zgjedhja me LOOCV.
    \item Variogrami: nugget, sill, range; modelet Sph, Exp, Gau; përshtatja WLS.
    \item OK: sistemi me Lagrange, varianca, ekrani; UK $=$ trend $+$ Kriging i mbetjeve.
    \item Meuse: IDW 0.442 $\to$ OK 0.392 $\to$ UK 0.375.
    \item Shqipëria: UK me lartësinë 0.33 $^\circ$C kundrejt OK 2.17 $^\circ$C.
  \end{itemize}
  \begin{Keshille}Faleminderit për 12 javët! Hapi tjetër: projekti final dhe prezantimet.\end{Keshille}
\end{frame}
