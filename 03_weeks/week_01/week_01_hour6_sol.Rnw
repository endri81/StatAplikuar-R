% ============================================================
%  Java 1 · Ora 6 — Zgjidhjet (shtojca)
% ============================================================

\begin{frame}[label=zgjL100]{Zgjidhja: Parashiko (L/100 km)}
  \textbf{B)} rreth 11.8.
  \[ 235.215 / 20 = 11.76 \ \text{L/100 km} \]
  \begin{itemize}
    \item Kontroll i shpejtë: $235/20 \approx 12$.
    \item Një makinë me 40 mpg harxhon gjysmën: rreth 5.9 L/100 km.
  \end{itemize}
  \vfill\kthehu{pyetjeL100}
\end{frame}

\begin{frame}[fragile,label=zgjTap]{Zgjidhja: Radha jote! (grupet e cilindrave)}
<<sol-tap>>=
a6 <- na.omit(read.csv(file.path(W01DATA, "Auto.csv"), na.strings = "?"))
a6$lp100 <- 235.215 / a6$mpg
a6$origin <- factor(a6$origin, 1:3, c("American", "European", "Japanese"))
round(tapply(a6$weight, a6$cylinders, mean))
sum(a6$cylinders %in% c(3, 5))
round(tapply(a6$lp100, a6$cylinders, mean), 2)
@
  \begin{itemize}
    \item Makinat me 8 cilindra kanë konsumin më të lartë.
  \end{itemize}
  \vfill\kthehu{ushTap}
\end{frame}

\begin{frame}[fragile,label=zgjGab6]{Zgjidhja: Gjej gabimin (\texttt{geom\_line})}
  \begin{itemize}
    \item Çdo vit ka shumë makina. \texttt{geom\_line()} i bashkon të gjitha pikat sipas $x$, prandaj vija kërcen lart e poshtë brenda të njëjtit vit.
    \item Rregullimi: vizato mesataren, jo pikat.
  \end{itemize}
<<sol-line, eval=FALSE>>=
ggplot(auto, aes(year_full, mpg)) +
  stat_summary(fun = mean, geom = "line")   # one value per year
@
  \vfill\kthehu{gjejGab6}
\end{frame}

\begin{frame}[fragile,label=zgjAdv]{Zgjidhja: Parashiko (Advertising)}
<<sol-adv>>=
adv6 <- read.csv(file.path(W01DATA, "Advertising.csv"))[, -1]
round(cor(adv6)[c("TV", "radio", "newspaper"), "sales"], 3)
@
  \begin{itemize}
    \item Renditja: \texttt{TV} $>$ \texttt{radio} $>$ \texttt{newspaper}.
    \item Te \texttt{newspaper}, pikat duken si re pa formë: korrelacion i dobët.
  \end{itemize}
  \vfill\kthehu{pyetjeAdv}
\end{frame}

\begin{frame}[fragile,label=zgjDplyr]{Zgjidhja: Radha jote! (\texttt{dplyr})}
<<sol-dplyr>>=
a6 |>
  mutate(period = ifelse(year <= 76, "1970-76", "1977-82")) |>
  group_by(origin, period) |>
  summarise(mean_lp100 = round(mean(lp100), 2), .groups = "drop")
@
  \begin{itemize}
    \item Makinat amerikane u përmirësuan më shumë: rreth 4.5 L/100 km më pak.
  \end{itemize}
  \vfill\kthehu{ushDplyr}
\end{frame}

\begin{frame}[label=zgjCp6]{Përgjigjet: Checkpoint i Orës 6}
  \begin{enumerate}
    \item $g(x)=235.215/x$ është jolineare; për të tilla funksione $\overline{g(x)}\neq g(\bar x)$.
    \item Origjina dhe pesha janë të lidhura: japonezet janë më të lehta. Pa e kontrolluar peshën, nuk e ndajmë efektin e origjinës.
    \item Kolona \texttt{X} është vetëm numri i rreshtit, jo variabël.
  \end{enumerate}
  \vfill\kthehu{cp6}
\end{frame}
