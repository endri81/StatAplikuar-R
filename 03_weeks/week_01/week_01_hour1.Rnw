\subsection{Mbyllja e orës}
% ------------------------------------------------------------

\begin{frame}[label=cp1]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 1}
  \begin{enumerate}
    \item Cilat janë 6 hapat e ciklit të një analize statistikore?
    \item Pse vendosëm \texttt{na.strings = "?"} kur lexuam \texttt{Auto.csv}?
    \item Pse \texttt{var(c(2, 4, 4, 5, 10))} jep 9 dhe jo 7.2?
  \end{enumerate}
  \shkoTe{zgjCp1}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje: Ora 1}
  \begin{itemize}
    \item Statistika e aplikuar: nga pyetja reale te vendimi, me të dhëna.
    \item R: falas, riprodhueshëm, me grafikë të fortë.
    \item Auto: më shumë fuqi, më pak mpg; lidhja është negative dhe e lakuar.
    \item Korrelacioni nuk është shkakësi.
    \item $\bar x$, $s^2$ (me $n-1$) dhe $s$; R i jep me \Rkey{mean()}, \Rkey{var()}, \Rkey{sd()}.
  \end{itemize}
  \begin{Keshille}Ora 2: mjedisi R dhe RStudio, objektet dhe tipat e të dhënave.\end{Keshille}
\end{frame}
