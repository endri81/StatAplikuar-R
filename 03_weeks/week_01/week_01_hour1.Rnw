% ------------------------------------------------------------
\subsection{Mirë se vini}
% ------------------------------------------------------------

\begin{frame}{Mirë se vini në Statistikën e Aplikuar! \LO{S4}}
  \begin{itemize}
    \item<1-> 12 javë, një workshop 7-orësh çdo javë.
    \item<2-> Çdo ditë: teori $\rightarrow$ kod R $\rightarrow$ të dhëna reale.
    \item<3-> Ju punoni gjatë gjithë kohës: ushtrime çdo 5--8 slide.
    \item<4-> Qëllimi: të ndërtoni, vlerësoni dhe interpretoni modele statistikore.
  \end{itemize}
  \onslide<5->{\begin{Keshille}Mbani RStudio të hapur gjatë gjithë ditës.\end{Keshille}}
\end{frame}

\begin{frame}{Çfarë është statistika e aplikuar?}
  \begin{Definicion}[(Statistika e aplikuar)]
    Përdorimi i metodave të statistikës matematike për t'iu përgjigjur
    pyetjeve reale me të dhëna reale.
  \end{Definicion}
  \pause
  \begin{itemize}
    \item Statistika matematike: \emph{pse} funksionon një metodë.
    \pause
    \item Statistika e aplikuar: \emph{kur} dhe \emph{si} ta përdorim.
    \pause
    \item Pse? Sepse e njëjta metodë mund të japë përfundime të gabuara nëse përdoret keq.
  \end{itemize}
\end{frame}

\begin{frame}{Cikli i një analize statistikore}
