% ------------------------------------------------------------
\subsection{Rezultatet e të nxënit}
% ------------------------------------------------------------

\begin{frame}{Rezultatet e të nxënit: njohuri}
  Në fund të kursit, studenti njeh:
  \begin{itemize}
    \item<1-> \LO{K1} korrelacionin midis variablave dhe metodat e analizës statistikore;
    \item<2-> \LO{K2} regresionin e thjeshtë dhe të shumëfishtë linear, regresionin logjistik;
    \item<3-> \LO{K3} metodat e analizës hapësinore, të interpolimit dhe të modelimit të të dhënave.
  \end{itemize}
\end{frame}

\begin{frame}{Rezultatet e të nxënit: aftësi dhe kompetenca}
  Studenti është në gjendje:
  \begin{itemize}
    \item<1-> \LO{S1} të formalizojë dukuri me modele matematike dhe probabilitare;
    \item<2-> \LO{S2} të ndërtojë modele parashikuese nga të dhënat;
    \item<3-> \LO{S3} të vlerësojë modelet e gjeneruara nga të dhënat;
    \item<4-> \LO{S4} të përdorë R për analiza statistikore;
    \item<5-> \LO{C1} të identifikojë dhe ndërtojë modelet e duhura statistikore dhe të vlerësojë efiçencën e tyre.
  \end{itemize}
\end{frame}

\begin{frame}[label=pyetjeLO1]{Pyetje me zgjedhje}
  \begin{Ushtrim}
    Në Javën 12 do të ndërtoni në R një hartë kriging të ndotjes me zink.
    Cilat rezultate i shërben kjo detyrë?\\[3pt]
    \textbf{A)} K1 dhe S1 \quad \textbf{B)} K3 dhe S4 \quad \textbf{C)} K2 dhe S2
  \end{Ushtrim}
  \shkoTe{zgjLO1}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Vlerësimi dhe literatura}
% ------------------------------------------------------------

\begin{frame}{Si vlerësoheni?}
  \begin{itemize}
    \item<1-> \textbf{Provimi përfundimtar}: me shkrim, 3 orë, \textbf{85\%} e notës.
    \begin{itemize}
      \item 25\% pyetje teorike (konceptet bazë);
      \item 75\% ushtrime (temat e seminareve dhe shembujt e detyrës).
    \end{itemize}
    \item<2-> \textbf{Detyra e kursit}: \textbf{15\%} e notës.
    \item<3-> \textbf{Kushti për provim}: frekuentim i seminareve $\ge 75\%$ dhe rezultate pozitive në kontrollet gjatë semestrit.
  \end{itemize}
  \onslide<4->{\begin{Keshille}75\% e provimit janë ushtrime: praktika në R çdo javë është mënyra më e sigurt për ta kaluar.\end{Keshille}}
\end{frame}

\begin{frame}{Shembull: llogaritja e notës}
  \[
    N = 0.85\,P + 0.15\,D
  \]
  \pause
  \begin{itemize}
    \item $P$ = pikët e provimit (0--100); $D$ = pikët e detyrës (0--100).
    \pause
    \item Shembull: $P = 80$, $D = 90$.
    \pause
  \end{itemize}
  \[
    N = 0.85\cdot 80 + 0.15\cdot 90 = 68 + 13.5 = 81.5
  \]
\end{frame}

\begin{frame}[label=ush1]{Radha jote!}
  \begin{Ushtrim}[(pa ndihmën e PC)]
    \begin{enumerate}
      \item Studentja ka $P = 70$ dhe $D = 100$. Sa është nota $N$?
      \item Studenti ka $D = 80$. Sa pikë i duhen në provim për $N = 60$?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjUsh1}{Shiko zgjidhjen}
\end{frame}

\begin{frame}{Ngarkesa e punës}
  \begin{tabular}{@{}lrrr@{}}
    \toprule
     & Leksion & Seminar & Gjithsej \\ \midrule
    Kreditet (ECTS) & 4.5 & 3 & 7.5 \\
    Orë në auditor & 48 & 30 & 78 \\
    Orë jashtë auditorit & 57 & 42.5 & 99.5 \\
    Orë gjithsej & 105 & 72.5 & 177.5 \\ \bottomrule
  \end{tabular}
  \vspace{6pt}
  \begin{itemize}
    \item Rreth $99.5 / 12 \approx 8.3$ orë punë individuale në javë.
  \end{itemize}
\end{frame}

\begin{frame}{Literatura e detyrueshme}
  \begin{itemize}
    \item<1-> E.~Raço, E.~Llagami, K.~Haxhi, O.~Zaçaj, \emph{Teoria e Probabilitetit dhe Statistika Matematike me ilustrime në gjuhën R}, Kotti, 2021 (+ vëllimi i Ushtrimeve).
    \item<2-> J.~Cohen, P.~Cohen, S.~G.~West, L.~S.~Aiken, \emph{Applied Multiple Regression/Correlation Analysis for the Behavioral Sciences}, LEA, 2003.
    \item<3-> K.~Chang, \emph{Introduction to Geographic Information Systems}, McGraw-Hill, 2012.
  \end{itemize}
\end{frame}

\begin{frame}{Literatura e rekomanduar dhe kodi}
  \begin{itemize}
    \item<1-> G.~James, D.~Witten, T.~Hastie, R.~Tibshirani, \emph{An Introduction to Statistical Learning} (ISLR), Springer. PDF falas: \url{https://www.statlearning.com}.
    \item<2-> Kodi bazë i laboratorëve: repo-ja \texttt{NormanLo4319/DS612\_Data\_Mining\_with\_Business\_Applications\_R} (licencë MIT), e bazuar në ISLR.
    \item<3-> Temat që nuk janë në repo (ANOVA, robust, hapësinore) shënohen \Plotesues.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Rifreskim i parakushteve}
% ------------------------------------------------------------

\begin{frame}{Parakushtet: çfarë duhet të dini}
  \begin{itemize}
    \item Analizë matematike: derivati, minimumi i një funksioni.
    \item Algjebër lineare: vektorët, matricat, prodhimi i matricave.
    \item Teori probabiliteti: ndryshorja e rastit, pritja, varianca.
    \item Bazat e programimit: ndryshoret, ciklet, funksionet.
  \end{itemize}
  \begin{Keshille}Në 10 minutat në vijim rifreskojmë vetëm atë që na duhet sot.\end{Keshille}
\end{frame}

