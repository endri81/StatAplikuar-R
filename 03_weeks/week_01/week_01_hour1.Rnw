  \end{tikzpicture}
\end{frame}

\begin{frame}{Korrelacioni nuk është shkakësi}
  \begin{Gabim}
    ``Fuqia e lartë \emph{shkakton} konsum të lartë'' nuk del nga ky grafik.
  \end{Gabim}
  \pause
  \begin{itemize}
    \item Makinat e fuqishme janë zakonisht edhe \textbf{më të rënda}.
    \pause
    \item Pesha mund të jetë shkaku i vërtetë, ose të dyja bashkë.
    \pause
    \item Pse ka rëndësi? Një vendim (p.sh.\ një taksë mbi fuqinë) mund të mos japë efektin e pritur.
  \end{itemize}
\end{frame}

\begin{frame}{Mendo -- Diskuto -- Ndaj}
  \begin{Ushtrim}[(think--pair--share, 4 minuta)]
    \begin{enumerate}
      \item \textbf{Mendo} (1 min): ku keni parë të dhëna në punë ose në studime?
      \item \textbf{Diskuto} (2 min): me shokun pranë, zgjidhni \emph{një} pyetje që do t'u përgjigjeshit me ato të dhëna.
      \item \textbf{Ndaj} (1 min): dy çifte e prezantojnë pyetjen para klasës.
    \end{enumerate}
  \end{Ushtrim}
  \begin{itemize}
    \item Pyetjet tuaja mund të bëhen tema e detyrës së kursit.
  \end{itemize}
\end{frame}

