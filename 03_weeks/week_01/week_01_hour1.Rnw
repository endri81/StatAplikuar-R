    \item Ky kurs mbulon çdo hap. R është mjeti për hapat 2--5.
  \end{itemize}
\end{frame}

\begin{frame}{Pse R?}
  \begin{columns}[T]
    \column{0.5\textwidth}
      \begin{itemize}
        \item<1-> Falas dhe me burim të hapur.
        \item<2-> Mijëra paketa në \termi{CRAN}{Comprehensive R Archive Network}.
        \item<3-> Grafika me cilësi botimi.
      \end{itemize}
    \column{0.5\textwidth}
      \begin{itemize}
        \item<4-> \termi{Riprodhueshmëri}{reproducibility}: kodi = receta e analizës.
        \item<5-> Përdoret nga zyrat statistikore, universitetet dhe industria.
      \end{itemize}
  \end{columns}
  \onslide<6->{\begin{Shembull}Këto slide janë prodhuar me R + knitr: çdo numër në to është llogaritur nga kodi.\end{Shembull}}
\end{frame}

\begin{frame}{Ku përdoret statistika e aplikuar?}
  \begin{columns}[T]
    \column{0.5\textwidth}
      \begin{block}{Statistika zyrtare}
        INSTAT: anketat e familjeve, censi, tregu i punës.
      \end{block}
      \begin{block}{Inxhinieri}
        Kontrolli i cilësisë, besueshmëria e materialeve.
      \end{block}
    \column{0.5\textwidth}
      \begin{block}{Mjedisi}
        Ndotja e tokës dhe e ujit, hartat e rrezikut (Java 12).
      \end{block}
      \begin{block}{Biznesi}
        Shitjet, reklama, rreziku i kredisë (Javët 5--9).
      \end{block}
  \end{columns}
\end{frame}

% ------------------------------------------------------------
\subsection{Problemi motivues}
% ------------------------------------------------------------

\begin{frame}{Problemi motivues: konsumi i karburantit \LO{K1}}
  \begin{itemize}
    \item<1-> Pyetja: \textbf{cila makinë harxhon më pak karburant?}
    \item<2-> Të dhënat \texttt{Auto}: 392 makina, modelet 1970--1982.
    \item<3-> Variabli kryesor: \texttt{mpg} = milje për gallon (sa më i madh, aq më ekonomike).
    \item<4-> Shpjeguesit: \texttt{horsepower}, \texttt{weight}, \texttt{cylinders}, \texttt{origin}, \dots
  \end{itemize}
  \onslide<5->{\footnotesize\textcolor{gray}{Të dhëna: reale (burimi: James et al., \emph{ISLR}; skedari \texttt{Auto.csv} nga repo-ja DS612).}}
\end{frame}

\begin{frame}[label=pyetjeMot1]{Parashiko!}
  \begin{Parashiko}
    Si ndryshon \texttt{mpg} kur rritet fuqia e motorit (\texttt{horsepower})?\\[3pt]
    \textbf{A)} Rritet \quad \textbf{B)} Zvogëlohet \quad \textbf{C)} Nuk ndryshon
  \end{Parashiko}
  \pause
  \begin{itemize}
    \item Votoni me dorë. Pastaj e shohim me të dhënat.
  \end{itemize}
  \shkoTe{zgjMot1}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[fragile]{Kodi R: leximi i të dhënave}
<<auto-read>>=
auto <- read.csv(file.path(W01DATA, "Auto.csv"),
                 na.strings = "?")    # "?" marks missing values
dim(auto)                             # rows, columns
auto <- na.omit(auto)                 # drop rows with NA
dim(auto)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Skedari ka \Sexpr{nrow(read.csv(file.path(W01DATA, "Auto.csv"), na.strings = "?"))} rreshta dhe \Sexpr{ncol(auto)} kolona.
    \item<2-> Pas heqjes së vlerave që mungojnë mbeten \Sexpr{nrow(auto)} makina.
    \item<3-> Pse? Në skedar, 5 vlera të \texttt{horsepower} janë shënuar me ``?''.
  \end{itemize}
  \onslide<4->{\begin{Gabim}Pa \texttt{na.strings = "?"}, R e lexon \texttt{horsepower} si tekst, jo si numër.\end{Gabim}}
\end{frame}

\begin{frame}[fragile]{Kodi R: grafiku i parë}
<<auto-plot-code, eval=FALSE>>=
library(ggplot2)
ggplot(auto, aes(x = horsepower, y = mpg)) +
  geom_point(colour = "#2C5AA0", alpha = 0.6) +
  labs(x = "Horsepower", y = "Miles per gallon (mpg)") +
  theme_minimal()
@
  \begin{itemize}
    \item Një rresht = një shtresë e grafikut. Gramatikën e ggplot2 e mësojmë në Orën 5.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Rezultati: mpg kundrejt horsepower}
<<auto-plot, echo=FALSE, fig.height=3.3>>=
library(ggplot2)
ggplot(auto, aes(x = horsepower, y = mpg)) +
  geom_point(colour = "#2C5AA0", alpha = 0.6) +
  labs(x = "Horsepower", y = "Miles per gallon (mpg)") +
  theme_minimal(base_size = 13)
@
\end{frame}

\begin{frame}{Çfarë na tregon grafiku?}
  \begin{itemize}
    \item<1-> Lidhja është \textbf{negative}: më shumë fuqi $\Rightarrow$ më pak mpg.
    \item<2-> Lidhja nuk është vijë e drejtë: duket \textbf{e lakuar}.
    \item<3-> Shpërndarja e pikave është më e gjerë për fuqi të vogël.
    \item<4-> Koeficienti i korrelacionit: $r = \Sexpr{fmt(cor(auto$horsepower, auto$mpg), 3)}$ (Java 3).
  \end{itemize}
  \onslide<5->{\begin{Keshille}Shiko gjithmonë grafikun para se të llogaritësh ndonjë numër.\end{Keshille}}
\end{frame}

\begin{frame}{Një dataset, shumë pyetje}
  \centering
  \begin{tikzpicture}[>=Stealth,
      ds/.style={circle,draw=uptblue,fill=uptlight,thick,minimum size=1.7cm,font=\footnotesize\bfseries,text=uptblue},
      qq/.style={rectangle,rounded corners=2pt,draw=uptmid,fill=white,minimum width=3.6cm,minimum height=7mm,font=\scriptsize,align=center}]
    \node[ds] (a) {Auto};
    \node[qq] (q1) at (-4.2, 1.3) {Sa e fortë është lidhja?\\\textcolor{accent}{Java 3: korrelacioni}};
    \node[qq] (q2) at ( 4.2, 1.3) {A ndryshon sipas origjinës?\\\textcolor{accent}{Java 4: ANOVA}};
    \node[qq] (q3) at (-4.2,-1.3) {Si e parashikojmë mpg?\\\textcolor{accent}{Javët 5--7: regresioni}};
    \node[qq] (q4) at ( 4.2,-1.3) {Po nëse lidhja është e lakuar?\\\textcolor{accent}{Java 8: jolinear}};
