\begin{frame}[label=cp7]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 7}
  \begin{enumerate}
    \item Cilat janë tri komandat e para pas importimit të çdo tabele?
    \item Kur përdoret boxplot dhe kur grafiku i shpërndarjes?
    \item Pse të dhënat sintetike janë të dobishme për të mësuar statistikë?
  \end{enumerate}
  \shkoTe{zgjCp7}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje e Javës 1}
  \begin{itemize}
    \item Ora 1--2: statistika e aplikuar, R dhe RStudio, objektet dhe tipat.
    \item Ora 3: vektorët, indeksimi, matricat.
    \item Ora 4: rastësia, $U(a,b)$, $N(\mu,\sigma^2)$, vlerësimi kundrejt së vërtetës.
    \item Ora 5--6: importimi, përmbledhja, grafikët; rasti \texttt{Auto} dhe \texttt{Advertising}.
    \item Ora 7: kuizi, gabimet e zakonshme, fletë-kujtesa.
  \end{itemize}
  \begin{Keshille}Shihemi në Javën 2. Sillni laptopin me paketat e instaluara.\end{Keshille}
\end{frame}
