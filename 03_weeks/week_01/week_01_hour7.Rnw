% ------------------------------------------------------------
\subsection{Kuizi në stilin e provimit}
% ------------------------------------------------------------

\begin{frame}{Kuizi: si funksionon}
  \begin{itemize}
    \item<1-> Struktura është si e provimit përfundimtar: \textbf{25\% teori, 75\% ushtrime}.
    \item<2-> 3 pyetje teorike (25 pikë) + 7 ushtrime (75 pikë) = 100 pikë.
    \item<3-> Koha: 40 minuta. Pa internet; R lejohet vetëm aty ku shkruhet.
    \item<4-> Çdo pyetje ka butonin e zgjidhjes. Përdoreni \emph{pasi} të keni shkruar përgjigjen.
  \end{itemize}
  \onslide<5->{\begin{Keshille}Shkruani gjithmonë arsyetimin, jo vetëm numrin: në provim pikët jepen edhe për hapat.\end{Keshille}}
\end{frame}

\begin{frame}[label=qT1]{Teori 1 (8 pikë)}
  \begin{Ushtrim}[(Teori 1)]
    Shpjegoni dallimin midis:
    \begin{enumerate}
      \item R dhe RStudio;
      \item \texttt{install.packages()} dhe \texttt{library()}.
    \end{enumerate}
    Për secilin, një fjali.
  \end{Ushtrim}
  \shkoTe{sT1}{Zgjidhja}
\end{frame}

\begin{frame}[label=qT2]{Teori 2 (8 pikë)}
  \begin{Ushtrim}[(Teori 2)]
    \begin{enumerate}
      \item Shkruani formulën e variancës së mostrës $s^2$.
      \item Pse pjesëtojmë me $n-1$ dhe jo me $n$?
      \item Cilin nga të dy emëruesit përdor funksioni \texttt{var()} i R-së?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{sT2}{Zgjidhja}
\end{frame}

\begin{frame}[label=qT3]{Teori 3 (9 pikë)}
  \begin{Ushtrim}[(Teori 3)]
    \begin{enumerate}
      \item Çfarë është një \emph{faktor} në R? Jepni një shembull nga të dhënat \texttt{Auto}.
      \item Pse \texttt{origin} me kodet 1, 2, 3 nuk duhet trajtuar si numër?
      \item Çfarë kthen \texttt{as.numeric(factor(c("10", "20", "5")))}? Pse?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{sT3}{Zgjidhja}
\end{frame}

\begin{frame}[label=qE1]{Ushtrimi 1 (10 pikë) --- pa ndihmën e PC}
  \begin{Ushtrim}[(Ushtrimi 1)]
    Jepen të dhënat $x = (3,\ 5,\ 7,\ 9,\ 11)$.
    \begin{enumerate}
      \item Llogaritni $\bar x$.
      \item Llogaritni devijimet $x_i-\bar x$ dhe kontrolloni që shuma e tyre është 0.
      \item Llogaritni $s^2$ dhe $s$ (3 shifra pas presjes).
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{sE1}{Zgjidhja}
\end{frame}

\begin{frame}[fragile,label=qE2]{Ushtrimi 2 (10 pikë) --- lexo kodin}
<<q-e2, eval=FALSE>>=
x <- c(4, 8, 15, 16, 23, 42)
x[x > 10 & x < 30]
which(x > 20)
length(x[-(1:2)])
x[7]
@
  \begin{Ushtrim}[(Ushtrimi 2)]
    Pa ekzekutuar kodin, shkruani rezultatin e secilit nga katër rreshtat e fundit.
  \end{Ushtrim}
  \shkoTe{sE2}{Zgjidhja}
\end{frame}

\begin{frame}[fragile,label=qE3]{Ushtrimi 3 (10 pikë) --- matricat}
<<q-e3, eval=FALSE>>=
m <- matrix(1:6, nrow = 2)
@
  \begin{Ushtrim}[(Ushtrimi 3)]
    \begin{enumerate}
      \item Shkruani matricën \texttt{m} element pas elementi.
      \item Sa është \texttt{m[2, 3]}? Sa është \texttt{dim(t(m))}?
      \item Llogaritni pa ndihmën e PC \texttt{m \%*\% t(m)}.
      \item Pse \texttt{m \%*\% m} jep gabim?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{sE3}{Zgjidhja}
\end{frame}

\begin{frame}[label=qE4]{Ushtrimi 4 (10 pikë) --- shpërndarja normale}
  \begin{Ushtrim}[(Ushtrimi 4)]
    Pikët e një testi ndjekin $X\sim N(70,\ 8^2)$.
    \begin{enumerate}
      \item Sa është vlera $z$ e një studenti me 86 pikë?
      \item Me rregullin 68--95--99.7, vlerësoni $P(X > 86)$.
      \item Shkruani komandën R që jep vlerën e saktë.
      \item Shkruani komandën R që jep pikët mbi të cilat bie 2.5\% më e mirë e studentëve.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{sE4}{Zgjidhja}
\end{frame}

\begin{frame}[label=qE5]{Ushtrimi 5 (10 pikë) --- simulimi}
  \begin{Ushtrim}[(Ushtrimi 5)]
    Koha e shërbimit në një sportel është $X\sim U(10, 30)$ minuta.
    \begin{enumerate}
      \item Llogaritni $E(X)$, $\operatorname{Var}(X)$ dhe $\sigma$.
      \item Shkruani kodin R që simulon 500 kohë shërbimi në mënyrë të riprodhueshme.
      \item Si do të krahasonit vlerësimin me të vërtetën?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{sE5}{Zgjidhja}
\end{frame}

\begin{frame}[label=qE6]{Ushtrimi 6 (10 pikë) --- importimi dhe grupet}
  \begin{Ushtrim}[(Ushtrimi 6)]
    Shkruani kodin R që:
    \begin{enumerate}
      \item lexon \texttt{Auto.csv} saktë (vlerat ``?'' janë \texttt{NA});
      \item numëron vlerat që mungojnë në çdo kolonë dhe i heq ato rreshta;
      \item llogarit \texttt{mpg} mesatar sipas numrit të cilindrave;
      \item vizaton me ggplot2 boxplot-in e \texttt{mpg} sipas cilindrave.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{sE6}{Zgjidhja}
\end{frame}

\begin{frame}[fragile,label=qE7]{Ushtrimi 7 (15 pikë) --- gjej gabimet}
<<q-e7, eval=FALSE>>=
auto <- read.csv("data\Auto.csv")
attach(auto)
origin = as.factor(origin)
mean(horsepower)
ggplot(auto, aes(weight, mpg, colour = "red")) + geom_point
@
  \begin{Ushtrim}[(Ushtrimi 7)]
    Skripti ka të paktën \textbf{5 gabime} ose praktika të këqija. Gjeni dhe korrigjoni secilin.
  \end{Ushtrim}
  \shkoTe{sE7}{Zgjidhja}
\end{frame}

\begin{frame}{Tabela e pikëve}
  \centering
  \begin{tabular}{@{}lcc@{}}
    \toprule
    Pjesa & Pyetjet & Pikët \\ \midrule
    Teori (25\%) & T1, T2, T3 & 8 + 8 + 9 = 25 \\
    Ushtrime (75\%) & U1--U6 & $6 \times 10 = 60$ \\
     & U7 & 15 \\ \midrule
    Gjithsej & 10 & 100 \\ \bottomrule
  \end{tabular}
