% ------------------------------------------------------------
\subsection{Pamje e Javës 2}
% ------------------------------------------------------------

\begin{frame}{Java 2: statistikat përmbledhëse dhe EDA \LO{K1} \LO{S4}}
  \begin{itemize}
    \item<1-> Masat e tendencës qendrore: mesatarja, mediana, moda, mesatarja e prerë.
    \item<2-> Masat e shpërndarjes: varianca, IQR, MAD, koeficienti i variacionit.
    \item<3-> Forma: anshmëria (\emph{skewness}) dhe kurtoza.
    \item<4-> Analiza eksploruese (EDA) e plotë, me vlerat e skajshme dhe të dhënat që mungojnë.
  \end{itemize}
\end{frame}

\begin{frame}{Java 2: si lidhet me sot}
  \begin{itemize}
    \item<1-> Pamë që mesatarja e \texttt{mpg} është më e madhe se mediana: Java 2 e mat këtë me anshmërinë.
    \item<2-> Pamë boxplot-in: Java 2 e ndërton nga zero, me $IQR$ dhe rregullin $1.5\cdot IQR$.
    \item<3-> Pamë $\overline{g(x)}\neq g(\bar x)$: Java 2 shpjegon shndërrimet logaritmike.
  \end{itemize}
\end{frame}

\begin{frame}{Para Javës 2}
  \begin{enumerate}
    \item Zgjidhni 6 ushtrimet për shtëpi.
    \item Krijoni projektin RStudio \texttt{StatAplikuar} me dosjet \texttt{data/} dhe \texttt{scripts/}.
    \item Instaloni paketat: \texttt{ggplot2}, \texttt{dplyr}, \texttt{ISLR2}, \texttt{MASS}.
    \item Lexoni ISLR, kapitulli 2 (\emph{Statistical Learning}), seksioni i laboratorit R.
  \end{enumerate}
\end{frame}

\begin{frame}{Burime}
  \footnotesize
  \begin{itemize}
    \item E.~Raço, E.~Llagami, K.~Haxhi, O.~Zaçaj, \emph{Teoria e Probabilitetit dhe Statistika Matematike me ilustrime në gjuhën R}, Kotti, 2021.
    \item G.~James, D.~Witten, T.~Hastie, R.~Tibshirani, \emph{An Introduction to Statistical Learning}, Springer; \url{https://www.statlearning.com}.
    \item N.~Lo, \emph{DS612 Data Mining with Business Applications (R)}, \url{https://github.com/NormanLo4319/DS612_Data_Mining_with_Business_Applications_R} (licencë MIT). Kodi i Orëve 3--5 bazohet te \texttt{DS612\_R-Code\_Lecture\_1.R}, i rishkruar.
    \item Të dhënat: \texttt{Auto.csv}, \texttt{Advertising.csv} (ISLR, nëpërmjet repo-s DS612). Të dhënat sintetike janë shënuar në çdo slide.
    \item H.~Wickham, \emph{ggplot2: Elegant Graphics for Data Analysis}, Springer.
  \end{itemize}
\end{frame}

