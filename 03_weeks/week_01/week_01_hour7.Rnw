  \begin{itemize}
    \item Mbi 80: e keni zotëruar javën. Nën 50: përsëritni Orët 3 dhe 5 para Javës 2.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Ushtrime për shtëpi}
% ------------------------------------------------------------

\begin{frame}[label=hH1]{Ushtrime për shtëpi 1--2}
  \begin{Ushtrim}[(Shtëpi 1: simulim)]
    Me \texttt{set.seed(1)}, gjeneroni 30 temperatura nga $N(15, 4^2)$ (sintetike).
    Llogaritni $\bar x$, $s$ dhe përqindjen e vlerave mbi 20 °C.
    Krahasojeni përqindjen me të vërtetën $P(X>20)$.
  \end{Ushtrim}
  \shkoTe{sH1}{Zgjidhja}
  \begin{Ushtrim}[(Shtëpi 2: Advertising)]
    Llogaritni shitjet mesatare për tregjet me buxhet TV mbi medianën dhe nën medianën.
  \end{Ushtrim}
  \shkoTe{sH2}{Zgjidhja}
\end{frame}

\begin{frame}[label=hH3]{Ushtrime për shtëpi 3--4}
  \begin{Ushtrim}[(Shtëpi 3: funksion)]
    Shkruani funksionin \texttt{cv(x)} që kthen koeficientin e variacionit $100\cdot s/\bar x$.
    Llogaritni atë për \texttt{mpg} dhe \texttt{weight}. Cila variabël ndryshon më shumë në terma relativë?
  \end{Ushtrim}
  \shkoTe{sH3}{Zgjidhja}
  \begin{Ushtrim}[(Shtëpi 4: grafik)]
    Vizatoni histogramin e \texttt{weight} me një panel për çdo origjinë (\texttt{facet\_wrap}). Përshkruani dallimet me dy fjali.
  \end{Ushtrim}
  \shkoTe{sH4}{Zgjidhja}
\end{frame}

\begin{frame}[label=hH5]{Ushtrime për shtëpi 5--6}
  \begin{Ushtrim}[(Shtëpi 5: pa ndihmën e PC)]
    Jepen $A=\begin{pmatrix}2&0\\1&3\end{pmatrix}$ dhe $\mathbf b=\begin{pmatrix}1\\2\end{pmatrix}$.
    Llogaritni $A\mathbf b$ dhe $A\circ A$ (element pas elementi). Kontrolloni në R.
  \end{Ushtrim}
  \shkoTe{sH5}{Zgjidhja}
  \begin{Ushtrim}[(Shtëpi 6: njësitë)]
    Shndërroni \texttt{weight} nga paund në kilogramë ($1$ lb $=0.4536$ kg).
    Llogaritni peshën mesatare në kg sipas origjinës.
  \end{Ushtrim}
  \shkoTe{sH6}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Gabimet e ditës}
% ------------------------------------------------------------

\begin{frame}{Gabimet e zakonshme: importimi dhe skedarët}
  \begin{Gabim}[--- importimi]
    \begin{itemize}
      \item Harrohet \texttt{na.strings = "?"} $\Rightarrow$ kolona numerike lexohet si tekst.
      \item Shtegu me \texttt{\textbackslash} në Windows $\Rightarrow$ gabim; përdor \texttt{/} ose \texttt{file.path()}.
      \item \texttt{setwd()} me shteg absolut $\Rightarrow$ skripti s'punon në kompjuter tjetër.
      \item \texttt{na.omit()} pa kontrolluar sa rreshta hiqen.
    \end{itemize}
  \end{Gabim}
\end{frame}

\begin{frame}{Gabimet e zakonshme: objektet dhe tipat}
  \begin{Gabim}[--- objektet]
    \begin{itemize}
      \item \texttt{=} në vend të \texttt{==} në një krahasim.
      \item \texttt{Total\_mpg} $\neq$ \texttt{total\_mpg}: R dallon shkronjat.
      \item \texttt{as.numeric()} mbi faktor jep kodet, jo vlerat.
      \item Emra funksionesh si emra objektesh: \texttt{mean <- 5}.
    \end{itemize}
  \end{Gabim}
\end{frame}

\begin{frame}{Gabimet e zakonshme: indeksimi dhe llogaritjet}
  \begin{Gabim}[--- indeksimi]
    \begin{itemize}
      \item \texttt{x[-1:2]} në vend të \texttt{x[-(1:2)]}.
      \item \texttt{x == NA} në vend të \texttt{is.na(x)}.
      \item Paralajmërimi i riciklimit injorohet.
      \item \texttt{*} në vend të \texttt{\%*\%} për prodhimin matricor.
      \item $\overline{g(x)}$ ngatërrohet me $g(\bar x)$ për funksione jolineare.
    \end{itemize}
  \end{Gabim}
\end{frame}

\begin{frame}{Gabimet e zakonshme: grafikët dhe interpretimi}
  \begin{Gabim}[--- grafikët]
    \begin{itemize}
      \item \texttt{attach()} $\Rightarrow$ kopje të fshehura dhe përplasje emrash.
      \item Ngjyrë fikse brenda \texttt{aes()}.
      \item \texttt{geom\_line()} mbi shumë vlera për çdo $x$.
      \item Përfundime nga grupe me 3--4 vrojtime.
      \item Korrelacioni lexohet si shkakësi.
    \end{itemize}
  \end{Gabim}
\end{frame}

\begin{frame}{Lista e kontrollit para dorëzimit}
  \begin{enumerate}
    \item<1-> Skripti nis me \texttt{library()} dhe \texttt{set.seed()}.
    \item<2-> Shtigjet janë relative; projekti ka skedar \texttt{.Rproj}.
    \item<3-> Pas importimit: \texttt{str()} dhe \texttt{colSums(is.na())}.
    \item<4-> Variablat cilësore janë faktorë me etiketa.
    \item<5-> Skripti ekzekutohet nga e para pas \emph{Restart R}.
    \item<6-> Çdo grafik ka etiketa të qarta; çdo përfundim ka edhe kufizimet.
  \end{enumerate}
\end{frame}

