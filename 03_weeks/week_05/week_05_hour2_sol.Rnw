% ============================================================
%  Java 5 · Ora 2 — Zgjidhjet (shtojca)
% ============================================================

\begin{frame}[label=zgjUnits]{Zgjidhja: Pyetje me zgjedhje (njësitë)}
  \begin{itemize}
    \item \textbf{C}. $x_{\text{m}}=x_{\text{cm}}/100$. Një rritje prej 1 m = 100 cm $\Rightarrow$ $\hat\beta_1=0.9\times100=90$ kg për metër.
    \item Në përgjithësi: nëse $x\to cx$, atëherë $\hat\beta_1\to\hat\beta_1/c$; $\hat\beta_0$, $R^2$ dhe RSE nuk ndryshojnë.
  \end{itemize}
  \vfill\kthehu{pyetjeUnits}
\end{frame}

\begin{frame}[fragile,label=zgjToy4]{Zgjidhja: Radha jote! (katër pika)}
  \begin{enumerate}
    \item $\bar x=1.5$, $\bar y=3$; $d_x=(-1.5,-0.5,0.5,1.5)$, $d_y=(-2,0,-1,3)$; $S_{xy}=3+0-0.5+4.5=7$, $S_{xx}=5$.
    \item $\hat\beta_1=1.4$, $\hat\beta_0=3-1.4\times1.5=0.9$.
    \item $\hat y=(0.9,2.3,3.7,5.1)$, $e=(0.1,0.7,-1.7,0.9)$, $\sum e_i=0$. \checkmark
  \end{enumerate}
<<sol-toy4>>=
x4 <- 0:3; y4 <- c(1, 3, 2, 6)
fit4 <- lm(y4 ~ x4); coef(fit4); round(residuals(fit4), 2)
@
  \vfill\kthehu{ushToy4}
\end{frame}

\begin{frame}[label=zgjScale]{Zgjidhja: Parashiko (shkalla e $y$)}
  \begin{enumerate}
    \item Të dy shumëzohen me 10: $S_{xy}\to10S_{xy}$, $\bar y\to10\bar y$.
    \item $R^2$ nuk ndryshon: SSR dhe SST shumëzohen të dyja me 100.
    \item RSE shumëzohet me 10: është në njësitë e $y$.
  \end{enumerate}
  \vfill\kthehu{pyetjeScale}
\end{frame}

\begin{frame}[label=zgjCp52]{Përgjigjet: Checkpoint Ora 2}
  \begin{enumerate}
    \item $\sum e_i=0$ (nga $\partial/\partial b_0$) dhe $\sum x_ie_i=0$ (nga $\partial/\partial b_1$).
    \item SSR $=\hat\beta_1^2S_{xx}=S_{xy}^2/S_{xx}$, pra $R^2=S_{xy}^2/(S_{xx}S_{yy})=r^2$.
    \item Mbetjet kanë 2 kufizime lineare; $E[\text{SSE}]=(n-2)\sigma^2$, pra SSE$/(n-2)$ është i pazhvendosur.
  \end{enumerate}
  \vfill\kthehu{cp52}
\end{frame}
