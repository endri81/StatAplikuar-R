for (i in 1:4) {
  f <- lm(anscombe[[paste0("y", i)]] ~ anscombe[[paste0("x", i)]])
  plot(fitted(f), residuals(f), main = paste("set", i), pch = 19); abline(h = 0, lty = 2)
}
