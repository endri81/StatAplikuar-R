\section{Motivimi}

\begin{frame}{Ora 1: Motivimi --- nga një re pikash te një vijë}
  \tableofcontents[currentsection,hideothersubsections,sectionstyle=show/hide]
\end{frame}

% ------------------------------------------------------------
\subsection{Problemi motivues}
% ------------------------------------------------------------

\begin{frame}{Pyetja e ditës \LO{K2}}
  \begin{itemize}
    \item<1-> Një firmë shpenzon për reklama televizive në 200 tregje.
    \item<2-> Java 3: $r=0.78$ midis TV dhe shitjeve. Lidhje e fortë.
    \item<3-> Por menaxheri pyet: \textbf{sa shitje shtesë sjell çdo 1000 \$ më shumë në TV?}
    \item<4-> Dhe: sa shitje presim në një treg ku shpenzojmë 150 mijë \$?
  \end{itemize}
  \onslide<5->{\footnotesize\textcolor{gray}{Të dhëna: reale, \texttt{Advertising.csv} (James et al., \emph{ISLR}, kap.~3, nëpërmjet repo-s DS612). Shitjet në mijë njësi; buxhetet në mijë \$.}}
\end{frame}

\begin{frame}[fragile]{Kodi R: të dhënat}
<<adv-read>>=
adv <- read.csv(file.path(W05DATA, "Advertising.csv"))[, -1]   # drop row index
dim(adv)
summary(adv[, c("TV", "sales")])
@
\end{frame}

\begin{frame}[fragile]{Pamja}
<<adv-scatter, fig.height=2.5, fig.width=5.5, out.width="0.51\\textwidth">>=
library(ggplot2)
ggplot(adv, aes(TV, sales)) +
  geom_point(alpha = 0.6, size = 1.2, colour = "#2C5AA0") +
  labs(x = "TV budget (1000 USD)", y = "sales (1000 units)") +
  theme_minimal(base_size = 10)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Prirje rritëse e qartë: më shumë TV, më shumë shitje.
    \item<2-> Pikat ``hapen'' djathtas: luhatja rritet me buxhetin (do ta kontrollojmë në Javën 7).
    \item<3-> Një \textbf{vijë} do ta përmblidhte prirjen me dy numra: ku nis dhe sa ngjitet.
  \end{itemize}
\end{frame}

\begin{frame}[label=pyetjeEye]{Parashiko!}
  \begin{Parashiko}
    Shiko grafikun. Vijat që ``kalojnë mes pikave'' nisin rreth 7 te TV $=0$ dhe arrijnë rreth 21 te TV $=300$. Sa është afërsisht pjerrësia?\\[3pt]
    \textbf{A)} 0.005 \qquad \textbf{B)} 0.05 \qquad \textbf{C)} 0.5 \qquad \textbf{D)} 5
  \end{Parashiko}
  \shkoTe{zgjEye}{Shiko zgjidhjen}
\end{frame}

\begin{frame}{Dy qëllime: parashikim dhe shpjegim}
  \begin{itemize}
    \item<1-> \textbf{Parashikim}: dua $\hat y$ për një $x$ të ri. Më intereson saktësia e $\hat y$.
    \item<2-> \textbf{Inferencë}: dua të kuptoj lidhjen. A ka lidhje? Sa e fortë? Me çfarë pasigurie?
    \item<3-> Regresi linear u shërben të dyjave (ISLR, kap.~2--3).
  \end{itemize}
  \onslide<4->{\begin{Keshille}Shumë modele të mëvonshme (KNN, pemët, Java 9) janë të mira për parashikim, por më pak për shpjegim. Regresi linear është ura midis tyre.\end{Keshille}}
\end{frame}

% ------------------------------------------------------------
\subsection{Objektivat}
% ------------------------------------------------------------

\begin{frame}{Objektivat e ditës}
  Në fund të ditës do të jesh në gjendje:
  \begin{enumerate}
    \item \LO{S1} të shkruash modelin $y=\beta_0+\beta_1x+\varepsilon$ dhe supozimet e tij;
    \item \LO{K2} të nxjerrësh vlerësuesit e katrorëve më të vegjël dhe vetitë e tyre;
    \item \LO{S3} të testosh $\beta_1$, të ndërtosh intervale besimi dhe parashikimi;
    \item \LO{S4} të përshtatësh, interpretosh dhe vizualizosh një model me \texttt{lm()};
    \item \LO{S2} të përdorësh modelin për parashikim dhe të njohësh kufijtë e tij.
  \end{enumerate}
\end{frame}

\begin{frame}{Lidhja me javët e tjera}
  \begin{itemize}
    \item<1-> Java 3: korrelacioni $r$ $\to$ sot: pjerrësia $\hat\beta_1=r\,s_y/s_x$ dhe $R^2=r^2$.
    \item<2-> Java 4: ANOVA, SST = SSB + SSW $\to$ sot: SST = SSR + SSE.
    \item<3-> Java 6: shumë shpjegues; Java 7: diagnostikimi; Java 8: vija jo të drejta.
  \end{itemize}
\end{frame}

