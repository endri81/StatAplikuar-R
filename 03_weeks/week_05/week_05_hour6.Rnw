\subsection{Mbyllja e orës}
% ------------------------------------------------------------

\begin{frame}[label=cp56]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 6}
  \begin{enumerate}
    \item Pse \texttt{na.strings = "?"} është i domosdoshëm te \texttt{Auto}?
    \item Çfarë tregojnë mbetjet e \texttt{mpg \textasciitilde{} horsepower}?
    \item Si interpretohet pjerrësia në një model log--log?
  \end{enumerate}
  \shkoTe{zgjCp56}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje: Ora 6}
  \begin{itemize}
    \item \texttt{Auto}: $-0.158$ mpg për hp, $R^2=0.61$; IB dhe IP për 98 hp (ISLR 3.8).
    \item Diagnostikimi: U + hinkë $\Rightarrow$ lidhje jolineare, variancë jokonstante.
    \item \texttt{weight} shpjegon më shumë, por është e lidhur me \texttt{horsepower}: Java 6.
    \item \Zgjerim Log--log: elasticiteti $\approx-0.84$; mos krahaso $R^2$ midis shkallëve të ndryshme të $y$.
  \end{itemize}
  \begin{Keshille}Ora 7: kuiz, ushtrime, fletë-kujtesa dhe pamje e regresit të shumëfishtë.\end{Keshille}
\end{frame}
