% ------------------------------------------------------------
\subsection{Kuizi në stilin e provimit}
% ------------------------------------------------------------

\begin{frame}{Kuizi: si funksionon}
  \begin{itemize}
    \item<1-> Si në provim: \textbf{25\% teori, 75\% ushtrime}; 3 pyetje teorike (25 pikë) + 7 ushtrime (75 pikë).
    \item<2-> Koha: 45 minuta. Ushtrimet 1--5 dhe 7 bëhen pa ndihmën e PC.
    \item<3-> Ushtrimet 1--3 përdorin: $x=(2,4,6,8,10)$, \ $y=(5,9,10,13,18)$.
  \end{itemize}
  \onslide<4->{\begin{Keshille}Shkruaj gjithmonë njësitë dhe interpretimin me fjalë: pikët jepen edhe për to.\end{Keshille}}
\end{frame}

\begin{frame}[label=q5T1]{Teori 1 (8 pikë)}
  \begin{Ushtrim}[(Teori 1)]
    \begin{enumerate}
      \item Shkruani modelin e regresit të thjeshtë dhe supozimet LINE.
      \item Cilat supozime duhen që $\hat\beta_1$ të jetë i pazhvendosur? Cilat për testin $t$ me $n$ të vogël?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s5T1}{Zgjidhja}
\end{frame}

\begin{frame}[label=q5T2]{Teori 2 (8 pikë)}
  \begin{Ushtrim}[(Teori 2)]
    \begin{enumerate}
      \item Dalloni $R^2$ dhe RSE. Pse $R^2=r^2$ në regresin e thjeshtë?
      \item Dalloni intervalin e besimit për mesataren dhe intervalin e parashikimit. Cili është më i gjerë dhe pse?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s5T2}{Zgjidhja}
\end{frame}

\begin{frame}[label=q5T3]{Teori 3 (9 pikë)}
  \begin{Ushtrim}[(Teori 3)]
    \begin{enumerate}
      \item Çfarë është regresi drejt mesatares?
      \item Pse ekstrapolimi është i rrezikshëm, edhe kur IP e merr parasysh largësinë nga $\bar x$?
      \item Çfarë tregon kuarteti i Anscombe-s për $R^2$ dhe vlerat $p$?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s5T3}{Zgjidhja}
\end{frame}

\begin{frame}[label=q5E1]{Ushtrimi 1 (10 pikë): vlerësuesit OLS}
  \begin{Ushtrim}[(Ushtrimi 1, pa ndihmën e PC)]
    $x=(2,4,6,8,10)$, \ $y=(5,9,10,13,18)$.
    \begin{enumerate}
      \item Llogaritni $\bar x$, $\bar y$, $S_{xx}$, $S_{xy}$.
      \item Gjeni $\hat\beta_0$, $\hat\beta_1$ dhe interpretoni pjerrësinë.
      \item Llogaritni mbetjet dhe kontrolloni $\sum e_i=0$.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s5E1}{Zgjidhja}
\end{frame}

\begin{frame}[label=q5E2]{Ushtrimi 2 (10 pikë): zbërthimi}
  \begin{Ushtrim}[(Ushtrimi 2, pa ndihmën e PC)]
    Me të dhënat e Ushtrimit 1:
    \begin{enumerate}
      \item Llogaritni SST, SSE dhe SSR.
      \item Llogaritni $R^2$, $\hat\sigma^2$ dhe RSE.
      \item Plotësoni tabelën ANOVA të regresionit.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s5E2}{Zgjidhja}
\end{frame}

\begin{frame}[label=q5E3]{Ushtrimi 3 (10 pikë): inferenca}
  \begin{Ushtrim}[(Ushtrimi 3, pa ndihmën e PC)]
    Me të dhënat e Ushtrimit 1 ($t_{0.975;\,3}=3.182$):
    \begin{enumerate}
      \item Llogaritni $SE(\hat\beta_1)$ dhe testoni $H_0:\beta_1=0$.
      \item Ndërtoni IB 95\% për $\beta_1$.
      \item A është $\beta_1=1$ e pajtueshme me të dhënat?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s5E3}{Zgjidhja}
\end{frame}

\begin{frame}[label=q5E4]{Ushtrimi 4 (10 pikë): nga statistikat përmbledhëse}
  \begin{Ushtrim}[(Ushtrimi 4, pa ndihmën e PC)]
    $n=25$, $\bar x=10$, $s_x=2$, $\bar y=50$, $s_y=8$, $r=0.6$.
    \begin{enumerate}
      \item Gjeni $\hat\beta_1$, $\hat\beta_0$ dhe $R^2$.
      \item Parashikoni $y$ për $x=12$.
      \item Llogaritni statistikën $t$ për $H_0:\beta_1=0$ ($t_{0.975;\,23}=2.069$).
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s5E4}{Zgjidhja}
\end{frame}

\begin{frame}[label=q5E5]{Ushtrimi 5 (10 pikë): IB dhe IP}
  \begin{Ushtrim}[(Ushtrimi 5, pa ndihmën e PC)]
    $n=20$, $\bar x=5$, $S_{xx}=80$, $\hat\sigma=2$; në $x_0=9$ kemi $\hat y_0=30$; $t_{0.975;\,18}=2.101$.
    \begin{enumerate}
      \item Ndërtoni IB 95\% për mesataren në $x_0=9$.
      \item Ndërtoni IP 95\% për një vëzhgim të ri në $x_0=9$.
      \item Në cilën $x_0$ do të ishte IB më i ngushtë? Sa i gjerë?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s5E5}{Zgjidhja}
\end{frame}

\begin{frame}[fragile,shrink=12,label=q5E6]{Ushtrimi 6 (10 pikë): lexo output-in}
<<quiz-cars, echo=FALSE>>=
summary(lm(dist ~ speed, data = cars))
@
  \texttt{cars}: shpejtësia (mph) dhe distanca e frenimit (ft), 50 makina të viteve 1920 (reale, R bazë).
  Interpretoni pjerrësinë, $R^2$ dhe testin; parashikoni distancën për 20 mph. \hfill\shkoTe{s5E6}{Zgjidhja}
\end{frame}

\begin{frame}[label=q5E7]{Ushtrimi 7 (15 pikë): interpretimi}
  \begin{Ushtrim}[(Ushtrimi 7, pa ndihmën e PC; shembull hipotetik)]
    \small
    Një studim hipotetik me 102 familje: shpenzimi $y$ (mijë lekë/muaj) kundrejt të ardhurave $x$ (mijë lekë/muaj), me $x\in[40,300]$:
    $\hat y=12+0.65x$, \ $SE(\hat\beta_1)=0.05$, \ $R^2=0.42$, \ RSE $=15$; \ $t_{0.975;\,100}=1.984$.
    \begin{enumerate}
      \item Interpretoni $\hat\beta_1$ me fjalë. Gjeni $r$.
      \item Ndërtoni IB 95\% për $\beta_1$.
      \item Nëse të dyja variablat shprehen në lekë (jo mijë lekë), si ndryshojnë $\hat\beta_0$, $\hat\beta_1$, $R^2$, RSE?
      \item A ka kuptim të parashikohet shpenzimi për të ardhura 500 mijë lekë? Pse?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{s5E7}{Zgjidhja}
\end{frame}

