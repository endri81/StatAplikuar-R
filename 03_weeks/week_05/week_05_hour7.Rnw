\subsection{Mbyllja e ditës}
% ------------------------------------------------------------

\begin{frame}[label=cp57]{\textcolor{accent}{$\checkmark$} Checkpoint: Ora 7}
  \begin{enumerate}
    \item Cilat pesë numra raporton për një regresion të thjeshtë?
    \item Cilët dy grafikë kontrollon pas \texttt{lm()}?
    \item Pse IP nuk ngushtohet në zero me $n\to\infty$?
  \end{enumerate}
  \shkoTe{zgjCp57}{Përgjigjet}
\end{frame}

\begin{frame}{Përmbledhje e Javës 5}
  \begin{itemize}
    \item OLS: $\hat\beta_1=S_{xy}/S_{xx}=r\,s_y/s_x$; SST = SSR + SSE; $R^2=r^2$.
    \item Inferenca: $SE=\hat\sigma/\sqrt{S_{xx}}$, testi $t_{n-2}$, IB, IB për mesataren, IP.
    \item Simulimi konfirmon teorinë; plani i $x$ ndikon në saktësi.
    \item Diagnostikimi: U $\Rightarrow$ lakim; hinkë $\Rightarrow$ heteroskedasticitet; ekstrapolimi.
    \item Rastet: \texttt{Advertising}, \texttt{Boston}, \texttt{Auto}, \texttt{Credit}.
  \end{itemize}
\end{frame}
